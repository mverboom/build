set -u

# Source configuration
# shellcheck source=~/.toreporc
# shellcheck disable=SC1090  # ~/.toreporc is host-specific
[[ -f ~/.toreporc ]] && source ~/.toreporc

usage() {
   printf '%s\n' "Usage: torepo <filename>"
   return 1
}

main() {
   local flags=""
   local ret=0
   local pkg
   local filename

   (( $# < 1 )) && { printf '%s\n' "Invalid arguments."; usage; return 1; }
   [[ "${1:-}" == "-q" ]] && { flags="-q"; shift; }
   (( $# < 1 )) && { printf '%s\n' "Invalid arguments."; usage; return 1; }

   # Target repository: prefer the B_DISTRO codename exported by build (so a
   # single host can build for multiple distros); fall back to REPONAME from
   # ~/.toreporc for backward compatibility.
   local repo="${B_DISTRO:-${REPONAME:-}}"
   [[ -z "$repo" ]] && { printf '%s\n' "Neither B_DISTRO nor REPONAME configured."; usage; return 1; }
   [[ -n "${SERVER:-}" ]] || { printf '%s\n' "SERVER not configured in ~/.toreporc."; usage; return 1; }

   for pkg in "$@"; do
      [[ -f "$pkg" ]] || { printf '%s\n' "No such file $pkg."; return 1; }
      filename=$(basename "$pkg")
      scp -q "$pkg" "${SERVER}:/tmp"
      # Use repo-add on the destination system to wrap whatever you are using.
      # Only remove the local package once repo-add succeeded, so a failed
      # publish does not lose the built file.
      # shellcheck disable=SC2029  # $flags/$repo/$filename expand client-side on purpose
      if ssh "$SERVER" "repo-add $flags $repo /tmp/$filename"; then
         rm "$pkg"
      else
         printf '%s\n' "repo-add failed for $pkg; keeping local file." >&2
         ret=1
      fi
   done

   (( ret != 0 )) && return 1
   # shellcheck disable=SC2029  # $POST is a remote command from the config
   [[ -n "${POST:-}" ]] && ssh "$SERVER" "$POST"
   return 0
}

main "$@"