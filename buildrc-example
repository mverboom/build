# Destination directory where compiled software should be stored
DESTDIR=~/build
# Create package/version directories in stead of package-version
DESTSPLIT=y
# Download cache directory
CACHEDIR=~/cache
# Number of versioned download versions to keep per package (0 disables)
MAXCACHEKEEP=3
# Number of built versions to keep per package in the build output (0 disables)
MAXBUILDKEEP=1
# Keep build output only for builds taking at least this many seconds (so it can
# be re-packaged without a rebuild); faster builds are pruned after packaging
# (0 = keep all)
#BUILDKEEPTIME=60
# Temporary build directory
TMPDIR=~/temp
# Log directory
LOGDIR=~/temp
# Directory with recipes
RECIPEDIR=~/recipes
# File with package administration
PKGLIST=$RECIPEDIR/pkglist
# Directory to output packages to
PKGDIR=~/packages
# Script to use to publish Debian package to repository
TODEBREPO="torepo"
# Set to yes to try and automatically install build dependencies
INSTDEP=yes
# Set to yes to try and automatically uninstall build dependencies
DEINSTDEP=yes
# Set package name postfix or empty if not set
PKGPOSTFIX=myorganisation
# Script to run after a build
POSTBUILD="clean -c"
# Point to a proxy hostname and port to use when connecting to network
# resources. Optional; passed to containers as http_proxy/https_proxy. A
# per-distro override is possible via ~/.build-repos.d/<distro>.
#PROXY="http://proxy:8080"
# Directory holding per-distro apt/repository configuration files (defaults to
# ~/.build-repos.d). See BUILD.md "APT / REPOSITORIES".
#BUILD_REPOS_DIR=$HOME/.build-repos.d
# Build mode. On the host, builds ALWAYS run inside Docker containers;
# native (host) builds are no longer supported. The native build path is
# retained only for in-container use by the -S dev shell, so BUILDMODE=native
# set here is ignored on the host (it only takes effect inside a container).
BUILDMODE=docker
# Target distribution for Docker builds (REQUIRED on the host, e.g., trixie, bookworm)
BUILDDISTRO=bookworm
# Host directory bind-mounted over the container's /tmp during builds, so
# large source checkouts are extracted onto a volume with free space instead
# of the container's (potentially small) writable layer. Set this to a path on
# a roomy volume when the Docker storage root is tight. Empty = use the
# container's own /tmp (default behaviour). The directory MUST have 777
# permissions (the container's builduser writes into it); the build aborts
# with a clear error if it does not. Each build runs in its own subdirectory
# underneath this path, so concurrent builds do not clash and the whole tree is
# cleaned away afterwards.
#BUILDDOCKERTMP=/home/builduser.orig/buildtmp
# Automatic Docker cleanup before each build session. "yes" prunes dangling
# images and build cache (leftovers from interrupted/failed builds; keeps base
# images). "full" also removes unused images (aggressive: base images get
# rebuilt on the next build). Empty = off (no automatic pruning).
#DOCKERAUTOPRUNE=yes
# Docker image names per distro (optional, overrides default mapping)
#DOCKER_IMAGE_TRIXIE=debian:trixie
# Docker image prefix for custom images (optional)
#DOCKER_IMAGE_PREFIX=
# Directory containing Dockerfiles (defaults to script directory /docker)
#DOCKER_DIR=$HOME/bin/build.git/docker
# Source-integrity strict mode (SECURITY.md group A). When set to 1, git-based
# recipes must declare a gpgkey and plain-http fetches are refused even if a
# recipe sets allow_insecure=1.
#STRICT=1
# Vulnerability scanning default (SECURITY.md group F4). Global default for
# the [INFO] vulnscan= recipe key: advisory (warn but continue) or enforce
# (fail on any HIGH/CRITICAL vulnerability). Empty = no scan unless a recipe
# sets its own vulnscan= key. A recipe's [INFO] vulnscan= overrides this.
#VULNSCAN=enforce
# Static build-script guard default (SECURITY.md group F6). Global default for
# the [INFO] srcguard= recipe key: advisory (warn but continue) or enforce
# (fail on any suspicious build-script pattern). Empty = no guard unless a
# recipe sets its own srcguard= key. A recipe's [INFO] srcguard= overrides
# this. Heuristic; may produce false positives, so advisory is recommended.
#SRCGUARD=advisory
