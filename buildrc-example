# Destination directory where compiled software should be stored
DESTDIR=~/build
# Create package/version directories in stead of package-version
DESTSPLIT=y
# Download cache directory
CACHEDIR=~/cache
# Temporary build directory
TMPDIR=~/temp
# Log directory
LOGDIR=~/temp
# Directory with recipes
RECIPEDIR=~/recipes
# File with package administration
PKGLIST=$RECIPEDIR/pkglist
# Directory to output packages to
PKGDIR=~/packages
# Script to use to publish Debian package to repository
TODEBREPO="torepo"
# Set to yes to try and automatically install build dependencies
INSTDEP=yes
# Set to yes to try and automatically uninstall build dependencies
DEINSTDEP=yes
# Set package name postfix or empty if not set
PKGPOSTFIX=myorganisation
# Script to run after a build
POSTBUILD="clean -c"
# Build mode. On the host, builds ALWAYS run inside Docker containers;
# native (host) builds are no longer supported. The native build path is
# retained only for in-container use by the -S dev shell, so BUILDMODE=native
# set here is ignored on the host (it only takes effect inside a container).
BUILDMODE=docker
# Target distribution for Docker builds (REQUIRED on the host, e.g., trixie, bookworm)
BUILDDISTRO=bookworm
# Docker image names per distro (optional, overrides default mapping)
#DOCKER_IMAGE_TRIXIE=debian:trixie
# Docker image prefix for custom images (optional)
#DOCKER_IMAGE_PREFIX=
# Directory containing Dockerfiles (defaults to script directory /docker)
#DOCKER_DIR=$HOME/bin/build.git/docker
