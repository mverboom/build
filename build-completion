#!/usr/bin/env bash
#
# Bash completion for the build script.
#
# Completes:
#   * recipe names (read from RECIPEDIR in ~/.buildrc)
#   * command-line options (-c -b -p -r -a -q -v -x -s -f -R -h
#     and the argument-taking -d -i -S -A -m)
#   * option arguments where a meaningful value is known:
#       -d / -S   target distribution codename (via `build --list-distros`)
#       -A        running Docker container (name or id)
#
# Options may be bundled (e.g. `build -bpd trixie` == `build -b -p -d trixie`);
# the trailing flag of a bundle is the one whose argument is completed.
#
# Install by sourcing this file from your ~/.bashrc, or copy/symlink it into
# /etc/bash_completion.d/ (or ~/.local/share/bash-completion/completions/).
#
# Copyright 2011-2019 Mark Verboom
