#     along with Build.  If not, see <http://www.gnu.org/licenses/>.

# Print the recipe names found in RECIPEDIR (as declared in ~/.buildrc).
# Returns nothing (empty completion) when the config or directory is absent.
_build_recipe_names() {
   local buildrc="${BUILD_BUILDRC:-$HOME/.buildrc}"
   [[ -f "$buildrc" ]] || return 0

   # Pull the last RECIPEDIR assignment out of the config without sourcing
   # the whole file (sourcing would pollute the interactive shell).
   local line value
   line=$(grep -E '^[[:space:]]*RECIPEDIR=' "$buildrc" | tail -1) || return 0
   [[ -n "$line" ]] || return 0

   value="${line#*RECIPEDIR=}"
   # Strip an optional surrounding pair of quotes.
   value="${value#[\"\']}"
   value="${value%[\"\']}"
   # Expand a leading tilde and the common $HOME/$USER references that
   # buildrc files use, without sourcing the config (which would leak its
   # other variables into the interactive shell) or resorting to eval.
   case "$value" in
      '~'*) value="$HOME${value#\~}" ;;
   esac
   value="${value//\$HOME/$HOME}"
   value="${value//\$USER/$USER}"

   [[ -n "$value" && -d "$value" ]] || return 0
   find -L "$value" -maxdepth 1 -name '*.recipe' -printf '%f\n' 2>/dev/null \
      | sed 's/\.recipe$//'
}

# Print the target distributions build knows about, by delegating to
# `build --list-distros`. This keeps build as the single source of truth for
# the supported distro set (no duplicated list here). Falls back to nothing
# when the build command is not on PATH.
_build_distros() {
   local build_bin
   build_bin=$(command -v build 2>/dev/null) || return 0
   "$build_bin" --list-distros 2>/dev/null
}

# Completion entry point for the build command.
_build_completions() {
   local cur prev
   cur=${COMP_WORDS[COMP_CWORD]}
   prev=${COMP_WORDS[COMP_CWORD-1]}

   # If the previous word is an option (possibly bundled, e.g. -bpd) whose
   # trailing flag takes an argument, complete that argument. getopts consumes
   # the remainder of a bundle as the argument of an arg-taking flag, so only
   # the trailing flag determines what (if anything) the next word is.
   local arg_kind=""
   if [[ "$prev" == -* ]]; then
      local last="${prev: -1}"
      case "$last" in
         d|S) arg_kind="distro" ;;
         A)   arg_kind="container" ;;
         i|m) arg_kind="none" ;;
      esac
   fi

   case "$arg_kind" in
      distro)
         mapfile -t COMPREPLY < <(compgen -W "$(_build_distros)" -- "$cur")
         return 0
         ;;
      container)
         # Offer running Docker container names and ids (if docker exists).
         if command -v docker > /dev/null 2>&1; then
            local containers
            containers=$(docker ps \
                           --format '{{.Names}}' 2>/dev/null; \
                        docker ps \
                           --format '{{.ID}}' 2>/dev/null)
            mapfile -t COMPREPLY < <(compgen -W "$containers" -- "$cur")
         fi
         return 0
         ;;
      none)
         # -i / -m: no meaningful static completion; leave to the user.
         return 0
         ;;
   esac

   # An option being typed: complete the available short options.
   if [[ "$cur" == -* ]]; then
      local opts="-c -b -p -r -a -q -v -x -s -f -R -h -d -i -S -A -m"
      mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
      return 0
   fi

   # Otherwise: complete recipe names.
   mapfile -t COMPREPLY < <(compgen -W "$(_build_recipe_names)" -- "$cur")
   return 0
}

complete -F _build_completions build