#!/usr/bin/env bash
#
# cacheclean - report on and manage the build download cache (~/cache)
#
# The cache holds two kinds of entries:
#   * versioned downloads (B_GET http/sf) - one file per version, e.g.
#     freecad-1.0.2, freecad-1.1.0, ... These accumulate without bound.
#   * single-file caches (B_GET git/go/hg/svn) - a tarball per package that is
#     updated in place. These are the efficiency cache that avoids re-cloning
#     on every build and must be kept.
#
# This script reports usage, prunes stale versioned downloads (keeping the
# newest N per package), optionally compacts the git tarballs, and optionally
# removes caches for packages that no longer have a recipe.
#
# Copyright 2025 Mark Verboom
