set -u

# Global variables and constants
LOCK="/tmp/build.lck"
QUIET=0
VERBOSE=0
_BUILD_TMP=""

# Default configuration (overridden by ~/.buildrc)
DESTDIR="$HOME/build"
DESTSPLIT=""
CACHEDIR="$HOME/cache"
TMPDIR="$HOME/temp"
RECIPEDIR="$HOME/recipes"
PKGLIST="$RECIPEDIR/pkglist"
PKGDIR="$HOME/packages"
LOGDIR="$HOME/log"
INSTDEP="yes"
DEINSTDEP="yes"
TODEBREPO=""
PKGPOSTFIX=""
PKGMAIL=""
PKGORG=""
POSTBUILD=""
PROXY=""
# Source-integrity strict mode (SECURITY.md group A). When 1, git-based
# recipes must declare a gpgkey and plain-http fetches are refused even with
# allow_insecure.
STRICT=0

# Per-distro apt/repository configuration.
# Builds must not inherit apt config (repositories, proxies, keys, credentials)
# from the host OS. Instead, each target distro's apt configuration is declared
# in a file under BUILD_REPOS_DIR named after the distro (codename, or
# family-codename). If no file exists for a distro, the standard Debian default
# repositories are used. See BUILD.md "APT / REPOSITORIES".
BUILD_REPOS_DIR="${BUILD_REPOS_DIR:-$HOME/.build-repos.d}"
# State populated by load_distro_repos() and consumed by
# docker_add_apt_config(). REPO_ORDER lists repo ids in declaration order; the
# REPO_* associative arrays hold per-repo fields.
NO_DEFAULT_REPOS=0
DEFAULT_REPOS=""
declare -A REPO_URL=() REPO_SUITE=() REPO_COMPONENTS=() REPO_PROXY=()
declare -A REPO_AUTH=() REPO_AUTHFILE=() REPO_KEY=() REPO_ARCH=() REPO_SIGNEDBY=()
declare -a REPO_ORDER=()
# Path to the generated apt-config mount directory (set by docker_add_apt_config).
_BUILD_APT_DIR=""

# Docker build configuration.
# On the host, builds always run inside Docker. The native build path is
# retained only for in-container use (the -S dev shell), where there is no
# Docker-in-Docker available. main() forces BUILDMODE=docker on the host.
: "${BUILDMODE:=docker}"
BUILDDISTRO="${BUILDDISTRO:-}"
DOCKER_DIR="${DOCKER_DIR:-}"
DOCKER_IMAGE_PREFIX="${DOCKER_IMAGE_PREFIX:-}"
BUILD_DEPS="${BUILD_DEPS:-}"
SHELL_MODE=0
ATTACH_CONTAINER=""
# Host directory bind-mounted over the container's /tmp during builds, so
# large source extractions land on a volume with free space instead of the
# container's (potentially small) writable layer. Empty = use the container's
# own /tmp (default behaviour). Must be 777; each build gets its own
# subdirectory under it. See BUILD.md "DOCKER / STORAGE".
BUILDDOCKERTMP="${BUILDDOCKERTMP:-}"
# Automatic Docker cleanup before each build session. "yes"/"on"/1 prunes
# dangling images and build cache (leftovers from interrupted/failed builds;
# keeps base images). "full"/"all" also removes unused images (aggressive:
# base images get rebuilt on the next build). Empty/"no"/0 = off.
# Defaults to "yes" so the script self-cleans without ~/.buildrc config; set
# DOCKERAUTOPRUNE=off in ~/.buildrc to disable.
DOCKERAUTOPRUNE="${DOCKERAUTOPRUNE:-yes}"
# Distribution segment for the output directory (e.g. "debian-trixie").
# Computed in main() from BUILDDISTRO (docker mode) or lsb_release (native).
B_DISTRODIR=""
# Target distribution codename (e.g. "trixie", "bookworm"). Platform-agnostic
# identifier of the distro being built for; exported so the TODEBREPO command
# (and other publish hooks) know which repository to add a package to.
# Computed in main() alongside B_DISTRODIR by distro_dir().
B_DISTRO=""

# Initialize option variables (set by parse_options)
B_FORCE=0
DEBUG=""
DEBUGSHELL=""
B_INSTANCE=""
B_NOPKGRM=0
DO_CHECK=0
DO_BUILD=0
DO_PACKAGE=0
DO_REPO=0
email=""

# Source configuration
if [[ -f "$HOME/.buildrc" ]]; then
   # shellcheck source=~/.buildrc
   source "$HOME/.buildrc"
else
   printf '%s\n' "No configuration file found."
   exit 1
fi

# OS detection
[[ -f /etc/os-release ]] || { printf '%s\n' "Unable to determine os, no /etc/os-release."; exit 1; }
source /etc/os-release
OS="$NAME"

# Trap for temp dir cleanup
trap '[[ -n "${_BUILD_TMP:-}" ]] && rm -rf "$_BUILD_TMP" 2>/dev/null' EXIT

# --- Utility functions ---

# Output a message respecting quiet level.
# Use ERR=1 prefix to output to stderr.
# Use -f flag to force output at quiet level 1.
output() {
   local force=0
   [[ "${1:-}" == "-f" ]] && { force=1; shift; }
   (( QUIET == 2 )) && return
   (( force == 0 && QUIET == 1 )) && return
   [[ -n "${ERR:-}" ]] && (>&2 printf '%s\n' "$1") || printf '%s\n' "$1"
}

# Print a short head/tail excerpt of a build log to stderr. Used to surface
# the failure reason in quiet mode (QUIET == 1): there the live Docker log
# stream is discarded (docker logs -f > /dev/null) and the native build
# pipeline is teed to /dev/null, so the generic "(build failed)" line
# otherwise hides WHY it failed -- e.g. a refused/insecure B_GET URL, a
# failed download, or a sha256 mismatch. Mirrors the excerpt format used by
# the email summary (head 5 / tail 5 with a "Skip middle..." marker).
# Parameters: log_file
_log_excerpt() {
   local log="$1"
   [[ -e "$log" ]] || return 0
   if (( $(wc -l < "$log") > 10 )); then
      { head -5 "$log"; printf '%s\n' "Skip middle..."; tail -5 "$log"; } | sed 's/^/  /' >&2
   else
      sed 's/^/  /' "$log" >&2
   fi
}

# Email a build-completion summary to the address given with -m.
# Uses the work_* arrays populated by main(). Includes a per-recipe summary
# (build/package ok/fail with percentages) and, only for recipes that were
# actually built and failed, log excerpts (head 5 / tail 5). The target
# distribution is included in the subject. No-op when no -m was given.
sendmail() {
   [[ -z "$email" ]] && return
   if ! command -v mail > /dev/null 2>&1; then
      output "mail command not found, cannot send summary to $email"
      return
   fi

   local i pkg log
   local buildtotal=0 built=0 pkgtotal=0 packaged=0
   local summaryok="" summaryfail=""
   local buildsubject="" pkgsubject="" subject
   local distro_label="${BUILDDISTRO:-}"
   [[ -z "$distro_label" ]] && distro_label=$(printf '%s' "${distr:-}" | tr '[:upper:]' '[:lower:]')

   for i in "${!work_recipes[@]}"; do
      pkg="${work_recipes[$i]} ${work_version[$i]}:"
      if [[ -n "${work_build[$i]:-}" ]]; then
         buildtotal=$(( buildtotal + 1 ))
         if (( work_build[i] == 1 )); then
            built=$(( built + 1 ))
            summaryok+="${pkg} build ok"
            if [[ -n "${work_packaged[$i]:-}" ]]; then
               pkgtotal=$(( pkgtotal + 1 ))
               if (( work_packaged[i] == 0 )); then
                  packaged=$(( packaged + 1 ))
                  summaryok+=", package ok"
               else
                  summaryok+=", package fail"
               fi
            fi
            summaryok+=$'\n'
         else
            summaryfail+="${pkg} build fail"$'\n'
         fi
      fi
   done

   # Nothing was built or packaged; don't send an empty mail.
   (( buildtotal == 0 && pkgtotal == 0 )) && return

   local buildperc=0 pkgperc=0
   (( buildtotal > 0 )) && { buildperc=$(( built * 100 / buildtotal )); buildsubject="${buildperc}% built"; }
   (( pkgtotal > 0 ))   && { pkgperc=$(( packaged * 100 / pkgtotal )); pkgsubject="${pkgperc}% packaged"; }
   [[ -n "$buildsubject" || -n "$pkgsubject" ]] && subject="$buildsubject, $pkgsubject"

   {
      printf '%s\n' "Summary:"
      [[ -n "$summaryok" ]]   && printf '%s' "$summaryok"
      [[ -n "$summaryfail" ]] && printf '%s' "$summaryfail"
      printf '\n'
      if (( built < buildtotal )); then
         printf '%s\n' "Log excerpt for failed builds:"
         for i in "${!work_recipes[@]}"; do
            # Only include recipes that were actually built and failed; skip
            # ones that were already built (work_build unset) or succeeded.
            [[ "${work_build[$i]:-}" != "0" ]] && continue
            printf '%s\n' "${work_recipes[$i]} ${work_version[$i]}:"
            log="$LOGDIR/${work_recipes[$i]}-${work_arch[${work_recipes[$i]}]}.log"
            [[ -e "$log" ]] || { printf '\n'; continue; }
            if (( $(wc -l < "$log") > 10 )); then
               { head -5 "$log"; printf '%s\n' "Skip middle..."; tail -5 "$log"; } | sed 's/^/  /'
            else
               sed 's/^/  /' "$log"
            fi
            printf '\n'
         done
      fi
   } | mail -r "$HOSTNAME" -s "build completed${distro_label:+ $distro_label} (${subject%%, })" "$email"
}

usage() {
   printf '%s\n' "Usage: build [OPTION]... [RECIPE]..."
   printf '%s\n' ""
   printf '%s\n' "Operation mode:"
   printf '%s\n' "   -c  Check version, runs the version check section of the specified recipe(s)."
   printf '%s\n' "   -b  Build, runs the build version of the specified recipe(s)."
   printf '%s\n' "   -p  Package, runs the package section of the specified recipe(s)."
   printf '%s\n' "   -r  To repository, creates packages and copies to repository for specified recipe(s)"
   printf '%s\n' ""
   printf '%s\n' "Operation modifiers:"
   printf '%s\n' "   -a  Select all recipes available."
   printf '%s\n' "   -q  Quiet output"
   printf '%s\n' "   -v  Verbose output: show command output that is normally suppressed"
   printf '%s\n' "   -x  Enable debugging output"
   printf '%s\n' "   -s  Drop to a shell when building process fails to inspect."
   printf '%s\n' "   -f  Force build for recipe, even if complete build is already available."
   printf '%s\n' "   -d  Specify target distribution for Docker (required on the host, e.g., -d trixie, -d bookworm)"
   printf '%s\n' "   -i  Specify an instance for a recipe"
   printf '%s\n' "   -R  Don't remove required packages after building and skip any post build script."
   printf '%s\n' "   -m  Mail a completion summary to the given email address."
   printf '%s\n' "   -h  This help message"
   printf '%s\n' ""
   printf '%s\n' "Docker interactive commands:"
   printf '%s\n' "   -S  Shell, start interactive development shell in a Docker container for the"
   printf '%s\n' "       specified distro (e.g., -S bookworm, -S trixie)."
   printf '%s\n' "   -A  Attach, re-attach to a running Docker container by container ID."
   printf '%s\n' ""
   printf '%s\n' "A recipe name may be suffixed with a forced version and/or instance:"
   printf '%s\n' "   recipe@version            build a specific version (skips version check)"
   printf '%s\n' "   recipe:instance           build for a specific instance"
   printf '%s\n' "   recipe@version:instance    both, in either order (recipe:instance@version)"
   printf '%s\n' "Several recipes can be built at different versions/instances in one command."
   printf '%s\n' ""
   return 1
}

# Check for required software on the host system.
# Outputs a space-separated list of required command names.
# Always returns 1 (used in command substitution to generate a list).
require_software() {
   case "$OS" in
   "Debian GNU/Linux")
      printf '%s\n' "gawk grep git svn wget fakeroot bzip2 hg lsb_release jq xml2"
      ;;
   "CentOS Linux")
      printf '%s\n' "gawk grep git svn wget bzip2 hg jq"
      ;;
   esac
   return 1
}

# Run sanity checks before starting build operations.
sanity_check() {
   local missing=""
   local name

   # In Docker mode, skip host-side tool checks (tools are in the container)
   if [[ "$BUILDMODE" != "docker" ]]; then
      for name in $(require_software); do
         if ! command -v "$name" > /dev/null 2>&1; then
            missing="$missing $name"
         fi
      done
      [[ -n "$missing" ]] && { output "Missing required software to run script:$missing"; return 1; }
   fi
   [[ -z "$PKGDIR" ]] && { ERR=1 output "PKGDIR not defined"; return 1; }
   [[ -d "$PKGDIR" ]] || { ERR=1 output "PKGDIR $PKGDIR does not exist, creating."; mkdir -p "$PKGDIR"; }
   [[ -d "$LOGDIR" ]] || { ERR=1 output "LOGDIR $LOGDIR does not exist, creating."; mkdir -p "$LOGDIR"; }
   [[ -d "$TMPDIR" ]] || { ERR=1 output "TMPDIR $TMPDIR does not exist, creating."; mkdir -p "$TMPDIR"; }
}

# Determine architecture string for the current system.
arch_get() {
   local arch
   arch=$(uname -m)
   case "$arch" in
   "i686")
      printf '%s\n' "i386"
      ;;
   "x86_64")
      printf '%s\n' "amd64"
      ;;
   *)
      printf '%s\n' "$arch"
      ;;
   esac
}

# Try to acquire the build lock file.
lock_get() {
   [[ -z "${B_METABUILD:-}" ]] && return 0
   if [[ -f "$LOCK" ]] && pgrep -F "$LOCK" > /dev/null; then
      return 1
   else
      printf '%s' "$$" > "$LOCK"
      return 0
   fi
}

# Release the build lock file.
lock_free() {
   [[ -z "${B_METABUILD:-}" ]] && return 0
   rm -f "$LOCK"
}

# --- Domain functions ---

# Get a specific item from a recipe section.
# Parameters: recipe label item [default]
# Returns 0 if value is empty, 1 if value was found.
recipe_item_get() {
   local recipe="$RECIPEDIR/$1.recipe"
   local label="$2"
   local item="$3"
   local value
   value=$(recipe_section_get "$1" "$label" optional | grep "^${item}=")
   if [[ -z "$value" ]] && (( $# == 4 )); then
      printf '%s\n' "$4"
   else
      printf '%s\n' "${value/*=/}"
   fi
   [[ -z "$value" ]] && return 0 || return 1
}

# Get the content of a section from a recipe file.
# Parameters: [-q] recipe label [optional]
#   -q      quiet mode, suppress error messages
#   optional if set, return success when section not found
recipe_section_get() {
   local quiet=0
   [[ "$1" == "-q" ]] && { quiet=1; shift; }
   local recipename="$1"
   local recipe="$RECIPEDIR/$recipename.recipe"
   local label="$2"
   local opt="${3:-}"

   if [[ ! -f "$recipe" ]]; then
      if [[ -z "$opt" ]]; then
         (( quiet == 0 )) && \
            >&2 output "Recipe $recipename ($recipe) does not exist."
         return 1
      else
         return 0
      fi
   fi

   if ! grep "^\[$label\]" "$recipe" > /dev/null 2>&1; then
      if [[ -z "$opt" ]]; then
         (( quiet == 0 )) && \
            >&2 output "No section $label found in recipe $recipe"
         return 1
      else
         return 0
      fi
   fi

   awk "BEGIN {found=0;} 
        /^\[/ {found=0;} 
        { if (found==1) { 
             print \$0;} };
        /^\[$label\]/ { found=1;}" "$recipe" | grep -v "^#"
}

# Run a sudo package command, surfacing errors always and full output when
# VERBOSE=1. Used by the native build dependency path (the -S dev shell).
# Parameters: command [args...]
_sudo_pkg() {
   local logf
   logf=$(mktemp) || { "$@"; return $?; }
   local rc
   if [[ "${VERBOSE:-0}" == "1" ]]; then
      sudo "$@" 2>&1 | tee "$logf"
      rc=${PIPESTATUS[0]}
   else
      sudo "$@" > "$logf" 2>&1
      rc=$?
      if (( rc != 0 )); then
         output -f "Command failed (exit $rc): sudo $*"
         cat "$logf" >&2
      fi
   fi
   rm -f "$logf"
   return "$rc"
}

# Install required build dependencies.
# Parameters: space-separated list of package names
# In Docker mode, packages are installed inside the container by the entrypoint.
# The package list is stored in BUILD_DEPS for the entrypoint to process.
build_require() {
   local pkgs="$*"
   local missing=0
   local -a toinst=()
   local -a toinsttr=()
   local pkg

   # In Docker mode, collect dependencies for the container entrypoint
   if [[ "$BUILDMODE" == "docker" ]]; then
      [[ -n "$pkgs" ]] && BUILD_DEPS="${BUILD_DEPS:-} $pkgs"
      return 0
   fi

   for pkg in $pkgs; do
      local query_result
      query_result=$(dpkg-query -s "${pkg/*@/}" 2>&1)
      local query_status=$?
      if (( query_status != 0 )) || [[ "$query_result" == *"not-installed"* ]]; then
         output "Package $pkg required for build, but not installed."
         if [[ "$INSTDEP" == "yes" ]]; then
            [[ "$pkg" == "${pkg/*@/}" ]] && \
               toinst+=("$pkg") || \
               toinsttr+=("$pkg")
         else
            missing=1
         fi
      fi
   done

   if (( ${#toinst[@]} != 0 )); then
      _sudo_pkg apt-get update || { output -f "apt-get update failed."; return 1; }
      _sudo_pkg apt-get -qq -y install "${toinst[@]}" || \
         { output -f "Error installing dependencies (${toinst[*]})."; return 1; }
   fi

   if (( ${#toinsttr[@]} != 0 )); then
      for pkg in "${toinsttr[@]}"; do
         _sudo_pkg apt-get -qq -y -t "${pkg/@*/}" install "${pkg/@*/}" || \
            { output -f "Error installing dependency ($pkg)."; return 1; }
      done
   fi

   (( missing == 1 )) && return 1
   return 0
}

# Remove previously installed build dependencies.
# Parameters: space-separated list of package names
build_require_remove() {
   local pkgs="$1"
   local pkg
   local -a list=()
   for pkg in $pkgs; do
      list+=("${pkg/*@/}")
   done
   sudo apt-get -qq -y --purge remove "${list[@]}" > /dev/null
   # TODO: Check return code
}

# Build a recipe: install dependencies, set up environment, run build commands.
# Parameters: recipe_name version
build() {
   B_NAME="$1"
   B_VERSION="$2"
   local versiondir
   if [[ -n "$B_INSTANCE" ]]; then
      versiondir="$B_VERSION-$B_INSTANCE"
   else
      versiondir="$B_VERSION"
   fi

   # Find recipe required section if available
   local pkgs
   pkgs=$(recipe_section_get "$B_NAME" "REQUIRED $distr $rel" opt)
   if [[ -z "$pkgs" ]]; then
      pkgs=$(recipe_section_get "$B_NAME" "REQUIRED $distr" opt)
      if [[ -z "$pkgs" ]]; then
         pkgs=$(recipe_section_get "$B_NAME" "REQUIRED" opt)
      fi
   fi

   [[ -n "$PKGPOSTFIX" ]] && pkgs="${pkgs//B_PF/$PKGPOSTFIX}"
   # Reset the per-container dependency list so deps from previous recipes in
   # the same run (e.g. `build -a`) do not leak into this recipe's container.
   # build_require() only appends to BUILD_DEPS; without a reset each successive
   # container would be told to install the union of all preceding recipes' deps,
   # which can over-constrain apt (e.g. grunt pulling nodejs while another recipe
   # pulls nodejs-lts-lnw, which Conflicts nodejs).
   BUILD_DEPS=""
   build_require "$pkgs" || return 1

   if [[ -n "$B_INSTANCE" ]]; then
      ID="${B_NAME}_${B_VERSION}-${B_INSTANCE}_${B_ARCH}"
   else
      ID="${B_NAME}_${B_VERSION}_${B_ARCH}"
   fi
   B_BUILDNR=$(package_buildnr_get "$ID")

   # Find BUILD section (add extensions for distribution and distribution version)
   local CMD
   if ! CMD=$(recipe_section_get -q "$B_NAME" "BUILD $distr $rel"); then
      if ! CMD=$(recipe_section_get -q "$B_NAME" "BUILD $distr"); then
         if ! CMD=$(recipe_section_get -q "$B_NAME" "BUILD"); then
            return 1
         fi
      fi
   fi

   local TMP
   TMP=$(mktemp -p "$TMPDIR" -d)
   _BUILD_TMP="$TMP"

   if [[ -n "$DESTSPLIT" ]]; then
      B_INSTALLDIR="$DESTDIR/$B_DISTRODIR/$B_ARCH/$B_NAME/$versiondir"
   else
      B_INSTALLDIR="$DESTDIR/$B_DISTRODIR/$B_ARCH/$B_NAME-$versiondir"
   fi
   (( B_FORCE == 1 )) && rm -rf "$B_INSTALLDIR"
   mkdir -p "$B_INSTALLDIR"

   # Source integrity (SECURITY.md group A): read optional recipe [INFO] keys.
   #   gpgkey         - A1: expected git tag signer (40-char fingerprint or id).
   #   commit         - A2: pinned commit SHA the resolved git ref must match.
   #   sha256         - A3: expected SHA-256 of an http/sf downloaded asset.
   #   allow_insecure - A4: explicitly allow plain http:// / git:// fetches.
   B_GPGKEY=$(recipe_item_get "$B_NAME" INFO gpgkey) || true
   B_COMMIT=$(recipe_item_get "$B_NAME" INFO commit) || true
   B_SHA256=$(recipe_item_get "$B_NAME" INFO sha256) || true
   B_ALLOW_INSECURE=$(recipe_item_get "$B_NAME" INFO allow_insecure) || true
   B_GPGKEYFILE=$(recipe_item_get "$B_NAME" INFO gpgkeyfile) || true
   B_STRICT="${STRICT:-0}"

   # Define build environment variables and functions
   B_CACHEDIR="$CACHEDIR"
   [[ -d "$RECIPEDIR/$B_NAME.files/B_BUILD" ]] && B_FILES="$RECIPEDIR/$B_NAME.files/B_BUILD"
   export B_VERSION B_INSTALLDIR B_ARCH B_INSTANCE B_CACHEDIR B_NAME B_BUILDNR B_FILES B_FORCE B_DISTRODIR B_DISTRO
   export B_GPGKEY B_COMMIT B_SHA256 B_ALLOW_INSECURE B_GPGKEYFILE B_STRICT

   # Define build environment functions (used in both native and Docker modes)
   # These are exported for native mode and dumped to env script for Docker mode.

   # Download/cached retrieval of build sources
   # shellcheck disable=SC2317
   B_GET() {
      (( $# < 3 )) && { >&2 printf '%s\n' "Insufficient arguments to B_GET."; return 1; }
      local method="$1"
      local option=""
      if [[ "${2:0:1}" == "-" ]]; then
         option="$2"
         shift
         (( $# < 3 )) && { >&2 printf '%s\n' "Insufficient arguments to B_GET."; return 1; }
      fi
      local url="$2"
      local fn="$3"
      local targetdir="$B_CACHEDIR/$B_NAME"
      local target="$targetdir/$fn-$B_VERSION"
      local targetnover="$targetdir/$fn"

      # A4: enforce encrypted transport. Reject plain http://, git:// and
      # svn:// URLs unless the recipe explicitly opts in via allow_insecure=1.
      # The go method uses scheme-less import paths and is exempt.
      if [[ "$method" != "go" ]]; then
         case "$url" in
            https://*|git@*|ssh://*|svn+ssh://*|file://*) : ;;
            http://*|git://*|svn://*)
               if [[ "${B_ALLOW_INSECURE:-0}" != "1" ]]; then
                  ERR=1 output -f "B_GET: refusing insecure URL: $url (set allow_insecure=1 to override)"
                  return 1
               fi
               ;;
            *)
               ERR=1 output -f "B_GET: refusing unrecognised URL scheme: $url"
               return 1
               ;;
         esac
      fi

      case "$method" in
      "http")
         if [[ ! -f "$target" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Http downloading files.."
            local -a wopts=(-O "$target" --secure-protocol=TLSv1_2)
            [[ "${B_ALLOW_INSECURE:-0}" != "1" ]] && wopts+=(--https-only)
            flock -w 60 "$target" wget "${wopts[@]}" "$url" || { rm -f "$target"; ERR=1 output -f "Error downloading file."; return 1; }
         fi
         # A3: verify checksum of the asset (fresh or cached) when sha256 is set.
         if [[ -n "${B_SHA256:-}" ]]; then
            local digest
            digest=$(sha256sum "$target" | cut -d' ' -f1) || { ERR=1 output -f "B_GET: cannot checksum $target"; return 1; }
            if [[ "$digest" != "$B_SHA256" ]]; then
               ERR=1 output -f "B_GET: sha256 mismatch for $fn (got ${digest}, want ${B_SHA256})"
               return 1
            fi
            output "B_GET: sha256 verified for $fn"
         fi
         flock -w 60 "$target" cp "$target" "$fn"
         ;;
      "sf")
         if [[ ! -f "$target" ]]; then
            # A4: force HTTPS for the SourceForge RSS feed (a known weak link).
            local sfurl="$url"
            sfurl="${sfurl/http:\/\/https:\/\/}"
            url=$(wget -q --secure-protocol=TLSv1_2 --https-only -O - "$sfurl/rss?path=/" | xml2 | grep '/rss/channel/item/link' | grep "$B_VERSION" | cut -d '=' -f 2 | tail -1)
            [[ -n "$url" ]] || { ERR=1 output -f "B_GET: no SourceForge download found for $B_VERSION"; return 1; }
            url="${url/http:\/\/https:\/\/}"
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Http sf downloading files.."
            local -a wopts=(-O "$target" --secure-protocol=TLSv1_2)
            [[ "${B_ALLOW_INSECURE:-0}" != "1" ]] && wopts+=(--https-only)
            flock -w 60 "$target" wget "${wopts[@]}" "$url" || { rm -f "$target"; ERR=1 output -f "Error downloading file."; return 1; }
         fi
         if [[ -n "${B_SHA256:-}" ]]; then
            local digest
            digest=$(sha256sum "$target" | cut -d' ' -f1) || { ERR=1 output -f "B_GET: cannot checksum $target"; return 1; }
            if [[ "$digest" != "$B_SHA256" ]]; then
               ERR=1 output -f "B_GET: sha256 mismatch for $fn (got ${digest}, want ${B_SHA256})"
               return 1
            fi
            output "B_GET: sha256 verified for $fn"
         fi
         flock -w 60 "$target" cp "$target" "$fn"
         ;;
      "git")
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Git downloading files.."
            if ! git clone "$url" "$fn"; then
               printf '%s\n' "Error cloning repository."; return 1
            fi
            # Fetch every tag explicitly. Some upstreams (e.g. influxdb) tag
            # releases on commits that no branch points at; git's default
            # tag auto-follow then skips them and `git checkout v$B_VERSION`
            # fails. --tags forces all tags (and their objects) down.
            (cd "$fn" || exit 1; git fetch --tags origin)
            if [[ "$option" == "-s" ]]; then
               (cd "$fn" || exit; git submodule update --init --recursive)
            fi
            flock -w 60 "$targetnover" tar cfz "$targetnover" "$fn"
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            cd "$fn" || return 1
            git fetch --tags origin
            if [[ "$(git rev-parse @)" != "$(git rev-parse '@{u}')" ]]; then
               git pull --tags
               if [[ "$option" == "-s" ]]; then
                  git submodule update --init --recursive
               fi
               cd ..
               flock -w 60 "$targetnover" tar cfz "$targetnover" "$fn"
            else
               cd ..
            fi
         fi
         ;;
      "go")
         export GOROOT=/opt/go
         export PATH="${PATH}:${GOROOT}/bin"
         export GOPATH
         GOPATH=$(pwd)
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Go downloading files.."
            if ! go get "$url"; then
               printf '%s\n' "Error downloading repository."; return 1
            fi
            flock -w 60 "$targetnover" tar cfz "$targetnover" .
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            if ! go get -u "$url"; then
               printf '%s\n' "Error updating repository."; return 1
            fi
            flock -w 60 "$targetnover" tar cfz "$targetnover" .
         fi
         ;;
      "hg")
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Mercurial downloading files.."
            if ! hg clone "$url" "$fn"; then
               printf '%s\n' "Error cloning repository."; return 1
            fi
            flock -w 60 "$targetnover" tar cfz "$targetnover" "$fn"
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            cd "$fn" || return 1
            if [[ "$(hg id | cut -d' ' -f 1)" != "$(hg id "$url")" ]]; then
               hg pull
               cd ..
               flock -w 60 "$targetnover" tar cfz "$targetnover" "$fn"
            else
               cd ..
            fi
         fi
         ;;
      "svn")
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Subversion downloading files.."
            if ! svn checkout --non-interactive --trust-server-cert -q "$url" "$fn"; then
               printf '%s\n' "Error checking out repository."; return 1
            fi
            flock -w 60 "$targetnover" tar cfz "$targetnover" "$fn"
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            cd "$fn" || return 1
            if [[ "$(svn info --non-interactive --trust-server-cert "$url" | grep Revision | cut -d' ' -f2)" != "$(svn info --non-interactive --trust-server-cert | grep Revision | cut -d' ' -f 2)" ]]; then
               svn update --non-interactive --trust-server-cert
               cd ..
               flock -w 60 "$targetnover" tar cfz "$targetnover" "$fn"
            else
               cd ..
            fi
         fi
         ;;
      *)
         printf '%s\n' "B_GET: unknown method $method"
         return 1
         ;;
      esac
   }
   export -f B_GET

   # Verify and check out a git tag/commit with source-integrity checks
   # (SECURITY.md group A1 & A2). Replaces a bare `git checkout tags/v$B_VERSION`
   # in recipes so that tag signatures (A1) and pinned commits (A2) are enforced.
   # Parameters: <ref>  e.g. "v$B_VERSION" or "tags/v$B_VERSION"
   # Uses B_GPGKEY (A1), B_COMMIT (A2) and B_STRICT from the build environment.
   # shellcheck disable=SC2317
   B_GITCHECKOUT() {
      (( $# < 1 )) && { >&2 printf '%s\n' "Insufficient arguments to B_GITCHECKOUT."; return 1; }
      local ref="$1"
      local tag
      if [[ "$ref" == tags/* ]]; then
         tag="${ref#tags/}"
      else
         tag="$ref"
         ref="tags/$ref"
      fi

      if ! git checkout "$ref" 2>/dev/null; then
         git checkout "$tag" || { output "B_GITCHECKOUT: failed to checkout $tag"; return 1; }
      fi

      # A2: refuse to build if the resolved ref does not match the pinned commit.
      if [[ -n "${B_COMMIT:-}" ]]; then
         local head
         head=$(git rev-parse HEAD 2>/dev/null) || { output "B_GITCHECKOUT: cannot resolve HEAD"; return 1; }
         if [[ "$head" != "$B_COMMIT" ]]; then
            output "B_GITCHECKOUT: resolved commit ${head} does not match pinned commit ${B_COMMIT}"
            return 1
         fi
         output "B_GITCHECKOUT: pinned commit verified (${head})"
      fi

      # A1: verify the git tag signature against the expected signer.
      if [[ -n "${B_GPGKEY:-}" ]]; then
         if ! command -v gpg > /dev/null 2>&1; then
            output "B_GITCHECKOUT: gpg not available but gpgkey is set"
            return 1
         fi
         # Fetch the expected key if it is not already in the keyring.
         # A local key file (gpgkeyfile) is preferred over keyserver fetch so
         # verification works in network-restricted build environments.
         if ! gpg --list-keys "$B_GPGKEY" > /dev/null 2>&1; then
            if [[ -n "${B_GPGKEYFILE:-}" ]]; then
               local keyfile="$B_GPGKEYFILE"
               if [[ "$keyfile" != /* ]] && [[ -n "${B_FILES:-}" ]]; then
                  keyfile="$B_FILES/$keyfile"
               fi
               if [[ -f "$keyfile" ]]; then
                  gpg --import "$keyfile" 2>/dev/null || { output "B_GITCHECKOUT: could not import gpg key file ${B_GPGKEYFILE}"; return 1; }
               else
                  output "B_GITCHECKOUT: gpgkeyfile not found: ${B_GPGKEYFILE}"; return 1
               fi
            else
               # Try several keyservers; keys.openpgp.org returns some keys
               # without user IDs (which gpg skips), so ubuntu/pgpkeys are used
               # as fallbacks.
               local ks
               for ks in hkps://keys.openpgp.org hkps://keyserver.ubuntu.com hkps://pgpkeys.eu; do
                  gpg --keyserver "$ks" --recv-keys "$B_GPGKEY" 2>/dev/null
                  gpg --list-keys "$B_GPGKEY" > /dev/null 2>&1 && break
               done
            fi
            gpg --list-keys "$B_GPGKEY" > /dev/null 2>&1 || { output "B_GITCHECKOUT: could not fetch gpg key ${B_GPGKEY}"; return 1; }
         fi
         local raw
         if ! raw=$(git verify-tag --raw "$tag" 2>&1); then
            output "B_GITCHECKOUT: tag ${tag} signature invalid or missing"
            output "$raw"
            return 1
         fi
         # Confirm the signature was made by the expected key (fingerprint or id).
         if ! printf '%s\n' "$raw" | grep -qE "GOODSIG ${B_GPGKEY}|VALIDSIG ${B_GPGKEY}"; then
            output "B_GITCHECKOUT: tag ${tag} not signed by expected key ${B_GPGKEY}"
            return 1
         fi
         output "B_GITCHECKOUT: tag ${tag} signature verified"
      elif [[ "${B_STRICT:-0}" == "1" ]]; then
         output "B_GITCHECKOUT: STRICT mode requires a gpgkey for git checkouts"
         return 1
      fi
      return 0
   }
   export -f B_GITCHECKOUT

   # Update the package build number in PKGLIST
   # shellcheck disable=SC2317
   B_UPDATEPKGBLD() {
      local ID
      # shellcheck source=~/.buildrc
      [[ -f "$HOME/.buildrc" ]] && source "$HOME/.buildrc"
      if [[ -n "$B_INSTANCE" ]]; then
         ID="${B_NAME}_${B_VERSION}-${B_INSTANCE}_${B_ARCH}"
      else
         ID="${B_NAME}_${B_VERSION}_${B_ARCH}"
      fi
      grep "^$ID" "$PKGLIST" > /dev/null && sed -i "/^$ID/d" "$PKGLIST"
      printf '%s\t%s\n' "$ID" "$B_BUILDNR" >> "$PKGLIST"
   }
   export -f B_UPDATEPKGBLD

   # Create symlinks for all files in a source directory to a destination directory
   # Parameters: [-r] source_dir dest_dir
   #   -r  recurse into subdirectories
   # shellcheck disable=SC2317
   B_LINKFILES() {
      local rec=0
      [[ "$1" == "-r" ]] && { rec=1; shift; }
      local src="$1"
      local dst="$2"
      local name

      [[ -d "$B_INSTALLDIR/$src" ]] || { printf '%s\n' "B_LINKFILES: source needs to be a directory within the B_INSTALLDIR tree."; return 1; }
      [[ -d "$B_INSTALLDIR/$dst" ]] || mkdir -p "$B_INSTALLDIR/$dst"
      shopt -s nullglob
      pushd "$B_INSTALLDIR/$src" > /dev/null || return 1
      for name in *; do
         if [[ "${name/%.real/}" == "$name" ]]; then
            if [[ -d "$B_INSTALLDIR/$src/$name" ]] && (( rec == 1 )); then
               B_LINKFILES -r "$src/$name" "$dst/$name"
            else
               ln -s "$src/$name" "$B_INSTALLDIR/$dst"
            fi
         fi
      done
      popd > /dev/null || return 1
   }
   export -f B_LINKFILES

   # Create a symlink for a single file to a destination directory
   # Parameters: source_file dest_dir
   # shellcheck disable=SC2317
   B_LINKFILE() {
      local src="$1"
      local dst="$2"
      [[ -f "$B_INSTALLDIR/$src" ]] || { printf '%s\n' "B_LINKFILE: source needs to be a file within the B_INSTALLDIR tree."; return 1; }
      [[ -d "$B_INSTALLDIR/$dst" ]] || mkdir -p "$B_INSTALLDIR/$dst"
      ln -s "$src" "$B_INSTALLDIR/$dst"
   }
   export -f B_LINKFILE

   # --- Docker mode: run build inside container ---
   if [[ "$BUILDMODE" == "docker" ]]; then
      # Select Docker image based on target distro
      local image
      image=$(docker_image_select "$BUILDDISTRO")

      # Write build command to a temp file
      local buildfile
      buildfile=$(mktemp -p "$TMPDIR" build-cmd-"${B_NAME}"-XXXXXX.sh)
      printf '#!/usr/bin/env bash\n' > "$buildfile"
      printf '%s\n' "$CMD" >> "$buildfile"
      chmod +x "$buildfile"

      # Write build environment to a temp file
      local envfile
      envfile=$(mktemp -p "$TMPDIR" build-env-"${B_NAME}"-XXXXXX.sh)
      docker_prepare_env "$envfile" || { rm -f "$envfile" "$buildfile"; return 1; }

      # If packaging is also requested, prepare package command
      local pkgcmdfile=""
      if (( DO_PACKAGE != 0 )); then
         pkgcmdfile=$(mktemp -p "$TMPDIR" pkg-cmd-"${B_NAME}"-XXXXXX.sh)
         docker_prepare_package_cmd "$pkgcmdfile" "$B_NAME" "$B_VERSION" || { rm -f "$envfile" "$buildfile" "$pkgcmdfile"; return 1; }
      fi

      # Run build (and optionally package) inside Docker container
      docker_run_build "$image" "$envfile" "$buildfile" "$pkgcmdfile"
      local result=$?

      # Clean up temp files
      rm -f "$envfile" "$buildfile" "$pkgcmdfile"

      if (( result != 0 )); then
         rm -rf "$B_INSTALLDIR"
         return 1
      fi
      return 0
   fi

   # --- Native mode: run build directly on host ---

   # Setting to set temporary files to the build folder
   export XDG_CACHE_HOME="$TMP/.cache"
   export YARN_CACHE_FOLDER="$TMP/.cache/yarn"

   local result
   local -a opts=()
   [[ "$DEBUG" == "1" ]] && opts+=("-x")
   opts+=("-e" "-c")

   # Remove the install directory if the build is interrupted (Ctrl-C), so a
   # half-built tree is not mistaken for a completed build on the next run.
   # The trap is cleared once the build command (and optional debug shell) has
   # finished; the existing result-based cleanup handles normal failure/success.
   trap 'rm -rf "${B_INSTALLDIR:-}" 2>/dev/null; exit 130' INT TERM

   pushd "$TMP" > /dev/null || return 1
   if [[ "$QUIET" == "1" ]]; then
      bash "${opts[@]}" "$CMD" 2>&1 | tee "$LOGDIR/${B_NAME}-${B_ARCH}.log" > /dev/null
   else
      bash "${opts[@]}" "$CMD" 2>&1 | tee "$LOGDIR/${B_NAME}-${B_ARCH}.log"
   fi
   # Capture exit status of the bash command (first in pipeline), not tee
   result=${PIPESTATUS[0]}
   if (( result != 0 )) && [[ -n "$DEBUGSHELL" ]]; then
      printf '%s\n' "## Build failed. Dropping to shell."
      printf '%s\n' "## See $LOGDIR/${B_NAME}-${B_ARCH}.log for build information."
      printf '%s\n' "## Any changes to the build root will be removed after exit."
      printf '%s\n' "## Type exit to return."
      printf '%s\n' ""
      PS1="\h:\w buildroot $ " bash --norc
   fi
   # Build command phase over: clear the interrupt trap so a Ctrl-C during
   # post-build cleanup (e.g. dependency removal on a successful build) does
   # not wipe a valid install directory.
   trap - INT TERM
   popd > /dev/null || return 1
   find "$TMP" -type d -print0 | xargs -0 chmod +w
   rm -rf "$TMP"
   _BUILD_TMP=""

   [[ -n "$pkgs" && "$DEINSTDEP" == "yes" ]] && (( B_NOPKGRM == 0 )) && build_require_remove "$pkgs"
   [[ -n "${POSTBUILD:-}" ]] && (( B_NOPKGRM == 0 )) && $POSTBUILD

   if (( result != 0 )); then
      rm -rf "$B_INSTALLDIR"
      return 1
   fi
   return 0
}

# Get the next build number for a package from PKGLIST.
# Parameters: package_id
package_buildnr_get() {
   local ID="$1"
   [[ -d "$(dirname "$PKGLIST")" ]] || mkdir -p "$(dirname "$PKGLIST")"
   [[ -f "$PKGLIST" ]] || touch "$PKGLIST"
   local BUILDNR
   BUILDNR=$(grep "^$ID" "$PKGLIST" | cut -d'	' -f 2)
   [[ -z "$BUILDNR" ]] && BUILDNR=0
   printf '%s\n' "$(( BUILDNR + 1 ))"
}

# Copy built packages to the repository.
# Parameters: package files to push
package_torepo() {
   local pkg type
   local -a deb_pkgs=()
   local -A unknown_types=()
   local RET=0

   for pkg in "$@"; do
      type="${pkg/*./}"
      case "$type" in
      "deb")
         deb_pkgs+=("$pkg")
         ;;
      *)
         # Emit the "not implemented" error once per unknown type.
         [[ -z "${unknown_types[$type]:-}" ]] && \
            ERR=1 output "Copy to repository not implemented for type $type"
         unknown_types["$type"]=1
         RET=1
         ;;
      esac
   done

   cd "$PKGDIR" || return 1
   if (( ${#deb_pkgs[@]} != 0 )); then
      if [[ -n "${TODEBREPO:-}" ]]; then
         $TODEBREPO "${deb_pkgs[@]}" || RET=1
      else
         ERR=1 output "TODEBREPO not configured"
         RET=1
      fi
   fi
   return "$RET"
}

# Package a built recipe into a distributable package.
# Parameters: recipe_name version
package() {
   local pkg="$1"
   local version="$2"
   local pkgtype
   local ID

   # Ensure B_NAME is set (build() sets it, but a package-only run -p may skip
   # build()). Used for the per-recipe log file path so packaging output lands in
   # the same log as the build output.
   B_NAME="$pkg"

   recipe_section_get "$pkg" PKG > /dev/null || return 1

   if [[ -n "$B_INSTANCE" ]]; then
      ID="$version-$B_INSTANCE"
   else
      ID="$version"
   fi
   if [[ -n "$DESTSPLIT" ]]; then
      ID="$pkg/$ID"
   else
      ID="$pkg-$ID"
   fi

   if [[ ! -d "$DESTDIR/$B_DISTRODIR/$B_ARCH/$ID" ]]; then
      ERR=1 output "Version $version of $pkg is not available for packaging."
      return 1
   fi

   if [[ -n "$B_INSTANCE" ]]; then
      ID="${version}-${B_INSTANCE}"
   else
      ID="${version}"
   fi
   local type
   type=$(recipe_item_get "$pkg" PKG type)
   for pkgtype in ${type/,/ }; do
      case "$pkgtype" in
      "deb")
         if [[ "$OS" == "Debian GNU/Linux" ]]; then
            package_deb "$pkg" "$version" "$ID"
            return $?
         fi
         ;;
      "rpm")
         if [[ "$OS" == "CentOS Linux" ]]; then
            package_rpm "$pkg" "$version" "$ID"
            return $?
         fi
         ;;
      *)
         ERR=1 output "Unknown package type ($pkgtype)."
         return 1
         ;;
      esac
   done
}

# TODO: Implement RPM package building (planned for Phase 3 of docker-implementation-plan.md)
package_rpm() {
   local pkg="$1"
   local version="$2"

   local pkgready
   pkgready=$(recipe_item_get "$pkg" PKG pkgready) || true
   local P_PKGDIR="${pkg}-${ID}"

   if [[ -z "$pkgready" ]]; then
      local P_PKGNAME="${pkg}_${ID}_${B_ARCH}"
      local P_BUILDNR
      P_BUILDNR=$(package_buildnr_get "${P_PKGNAME}")
      local INFO
      INFO=$(recipe_section_get "$pkg" DEB) || return 1
      local TMP
      TMP=$(mktemp -p "$TMPDIR" -d)

      printf '%s\n' "P_PKGNAME $P_PKGNAME"
      printf '%s\n' "P_BUILDNR $P_BUILDNR"

      mkdir -p "$TMP/DEBIAN"

      printf '%s\n' "Creating rpm packages is not implemented."
      return 1
   else
      printf '%s\n' "pkgready not implemented for rpm."
      return 1
   fi
}

# Build a Debian package from a built recipe.
# Parameters: recipe_name version package_id
package_deb() {
   local pkg="$1"
   local version="$2"

   local pkgready
   pkgready=$(recipe_item_get "$pkg" PKG pkgready) || true

   local pkgdir
   if [[ -n "$DESTSPLIT" ]]; then
      pkgdir="$DESTDIR/$B_DISTRODIR/$B_ARCH/$pkg/$version"
   else
      pkgdir="$DESTDIR/$B_DISTRODIR/$B_ARCH/$pkg-$version"
   fi

   if [[ -z "$pkgready" ]]; then
      local P_PKGNAME="${pkg}_${ID}_${B_ARCH}"
      local P_BUILDNR
      P_BUILDNR=$(package_buildnr_get "${P_PKGNAME}")

      # Find recipe package section
      local INFO
      if ! INFO=$(recipe_section_get -q "$pkg" "DEB $rel"); then
         if ! INFO=$(recipe_section_get "$pkg" DEB); then
            return 1
         fi
      fi

      local TMP
      TMP=$(mktemp -p "$TMPDIR" -d)
      mkdir -p "$TMP/build/DEBIAN"
      local pkgversion
      pkgversion="${version//\-/}-$P_BUILDNR+deb$(lsb_release -r -s | cut -d'.' -f 1)"

      if printf '%s' "$INFO" | grep -q B_DEPENDS; then
         local CMD
         local DEPS
         CMD=$(recipe_section_get "$pkg" DEB_DEPENDS)
         DEPS=$(B_VERSION=$version bash -c "$CMD")
         INFO=$(printf '%s\n' "$INFO" | sed "/^Depends:/ s/B_DEPENDS/$DEPS/")
      fi
      [[ -n "$PKGPOSTFIX" ]] && INFO=$(printf '%s\n' "$INFO" | sed "/^Package:/ s/$/-$PKGPOSTFIX/" | sed "s/B_PF/$PKGPOSTFIX/g")
      [[ -n "$PKGPOSTFIX" ]] && INFO="${INFO//B_MAIL/$PKGMAIL}"
      [[ -n "$PKGORG" ]] && INFO="${INFO//B_ORG/$PKGORG}"
      [[ -n "$PKGMAIL" ]] && INFO="${INFO//B_MAIL/$PKGMAIL}"

      cd "$pkgdir" || return 1
      tar pcfB - . | (cd "$TMP/build" || exit; tar pxfB -)
      cd "$TMP/build" || return 1

      if [[ -d "$RECIPEDIR/$pkg.files/B_DEBIAN" ]]; then
         (cd "$RECIPEDIR/$pkg.files/B_DEBIAN" || exit; tar cf - .) | tar xf -
      fi

      # Mark config files
      find . -path "*/etc/*" -type f | sed "s/^\.//" > DEBIAN/conffiles
      local configfiles
      configfiles=$(recipe_item_get "$pkg" PKG configfiles) || true
      [[ -n "$configfiles" ]] && { printf '%s\n' "$configfiles" | tr ' ' '\n' >> DEBIAN/conffiles; }

      printf '%s\n' "$INFO" | sed "s/B_VERSION/$pkgversion/" | sed "s/B_ARCH/$B_ARCH/" > "$TMP/build/DEBIAN/control"

      cd "$TMP" || return 1
      local pkglog="$LOGDIR/${B_NAME}-${B_ARCH}.log"
      # Append packaging output to the per-recipe log so build + package output
      # for a recipe live in one place. In native mode, also show it live when
      # not quiet; in docker mode the entrypoint already echoes the log on
      # failure/verbose, so we don't print here (would duplicate in the log).
      printf '\n### Packaging %s (version %s)\n' "$pkg" "$version" >> "$pkglog"
      fakeroot dpkg --build "$TMP/build" . > "$TMP/.buildoutput" 2>&1
      local result=$?
      cat "$TMP/.buildoutput" >> "$pkglog"
      (( QUIET == 0 && BUILDMODE != "docker" )) && cat "$TMP/.buildoutput"
      local pkgfile
      pkgfile=$(cut -d "'" -f 4 "$TMP/.buildoutput")
      pkgfile="${pkgfile/*\//}"

      if (( result != 0 )); then
         rm -rf "$TMP"
         ERR=1 output "Error while building package (see $pkglog)."
         return 1
      fi

      grep "^${P_PKGNAME}_${B_ARCH}" "$PKGLIST" > /dev/null && sed -i "/^${P_PKGNAME}_${B_ARCH}/d" "$PKGLIST"
      printf '%s\t%s\n' "${P_PKGNAME}_${B_ARCH}" "$P_BUILDNR" >> "$PKGLIST"

      mv "$TMP/$pkgfile" "$PKGDIR"
      rm -rf "$TMP"
   else
      if [[ "$(printf '%s\n' "$pkgdir"/*.deb)" == "$pkgdir/*.deb" ]]; then
         ERR=1 output "Recipe indicates package should be in build dir, but it isn't."
         return 1
      else
         local -a deb_files=("$pkgdir"/*.deb)
         cp "${deb_files[@]}" "$PKGDIR"
         pkgfile=$(basename "${deb_files[0]}")
      fi
   fi
   printf '%s\n' "$pkgfile"
}

# Get the latest version of a recipe by running its VERSION section.
# Parameters: recipe_name
version_get() {
   local pkg="$1"
   local CMD

   export B_SARCH
   export B_NAME="$1"

   # Find the newest tag for a git repository with filtering options
   # shellcheck disable=SC2317
   B_GITVER() {
      local exclude='-e "alpha\|beta\|preview\|rc\|a$\|b$\|b[0-9]*$"'
      local include=""
      local preregex=""
      local postregex=""
      local prefilter='s/^v//'
      local postfilter=""
      local DEBUG=0

      while getopts :aDr:R:i:e:f:F: opt; do
         case $opt in
         r) preregex="$preregex; $OPTARG" ;;
         R) postregex="$postregex; $OPTARG" ;;
         f) prefilter="$prefilter; s/$OPTARG//" ;;
         i) include="$include -e $OPTARG" ;;
         e) exclude="$exclude -e $OPTARG" ;;
         F) postfilter="$postfilter; s/$OPTARG//" ;;
         a) exclude="" ;;
         D) DEBUG=1 ;;
         \?) printf '%s\n' "Unknown option: -$OPTARG" ;;
         :) printf '%s\n' "Option -$OPTARG requires argument" ;;
         esac
      done
      shift $((OPTIND - 1))

      [[ -n "$preregex" ]] && preregex="sed \"$preregex\"" || preregex="cat"
      prefilter="sed \"$prefilter\""
      [[ -n "$include" ]] && include="grep -i $include" || include="cat"
      [[ -n "$exclude" ]] && exclude="grep -iv $exclude" || exclude="cat"
      [[ -n "$postfilter" ]] && postfilter="sed \"$postfilter\"" || postfilter="cat"
      [[ -n "$postregex" ]] && postregex="sed \"$postregex\"" || postregex="cat"

      local CMD="git ls-remote --tags $1 | grep -v '{}' |
                 sed 's#.*refs/tags/##' |
                 $preregex |
                 $prefilter |
                 $include |
                 $exclude |
                 $postfilter |
                 $postregex |
                 sort -t. -k 1,1n -k 2,2n -k 3,3n -k 4,4n | tail -1"
      (( DEBUG == 1 )) && printf '%s\n' "$CMD" > /tmp/b_gitver
      bash -c "$CMD"
   }

   # Get the last commit date for a GitLab repository
   # shellcheck disable=SC2317
   B_GITLABVER() {
      local USR
      local REPO
      local BRANCH="${2:-}"
      USR="$(printf '%s' "$1" | cut -d'/' -f 4)"
      REPO="$(printf '%s' "$1" | cut -d'/' -f 5)"
      wget -q -O - "https://gitlab.com/api/v4/projects/${USR}%2F${REPO}/repository/commits?ref_name=${BRANCH:-master}" | jq -r '.[0].committed_date[0:10] | gsub("-";"")'
   }

   # Get the last commit date for a GitHub repository
   # shellcheck disable=SC2317
   B_GITHUBVER() {
      local URL="$1"
      local BRANCH="${2:-}"
      wget -q -O - "https://api.github.com/repos/${URL/*github.com\//}/commits/${BRANCH:-master}" | jq -cr '.commit.committer.date[0:10] | gsub("-";"")'
   }

   # Get the latest version for a Sourceforge project
   # shellcheck disable=SC2317
   B_SFVER() {
      local URL="$1"
      # A4: force HTTPS for the SourceForge RSS feed (a known weak link).
      URL="${URL/http:\/\/https:\/\/}"
      wget -q --secure-protocol=TLSv1_2 --https-only -O - "$URL/rss?path=/" | xml2 | grep '/rss/channel/item/link' | sed 's/.*\/files\/\([^\/]\+\)\/.*/\1/; s/.\+-\(.\+\)/\1/' | sort -t. -k 1,1n -k 2,2n -k 3,3n -k 4,4n | tail -1
   }

   # Get the last changed date for an SVN repository
   # shellcheck disable=SC2317
   B_SVNDATE() {
      date -d "$(svn info --non-interactive --trust-server-cert "$1" | grep 'Last Changed Date:' | cut -d':' -f2-)" "+%Y%m%d"
   }

   # Get the revision number for an SVN repository
   # shellcheck disable=SC2317
   B_SVNREV() {
      svn info --non-interactive --trust-server-cert "$1" | grep Revision | cut -d' ' -f2
   }

   # Get the revision ID for a Mercurial repository
   # shellcheck disable=SC2317
   B_HGREV() {
      hg id "$1"
   }

   export -f B_GITVER B_GITHUBVER B_SVNDATE B_SVNREV B_HGREV B_GITLABVER B_SFVER

   if ! CMD=$(recipe_section_get "$pkg" VERSION); then
      output "$CMD"; return 1
   fi

   local -a opts=()
   [[ "$DEBUG" == "1" ]] && opts+=("-x")
   opts+=("-e" "-c")
   local ver
   if ! ver=$(bash "${opts[@]}" "$CMD" 2>/dev/null); then
      >&2 output "Error while running version command for $pkg."; return 1
   fi
   [[ -z "$ver" ]] && { >&2 output "Version command for $pkg returned no output."; return 1; }
   printf '%s\n' "$ver"
   return 0
}

# Check if a recipe has a build section for this system.
# Parameters: recipe_name
recipe_select_build() {
   local recipe="$1"

   if ! recipe_section_get -q "$recipe" "BUILD $distr $rel" > /dev/null; then
      if ! recipe_section_get -q "$recipe" "BUILD $distr" > /dev/null; then
         if ! recipe_section_get -q "$recipe" "BUILD" > /dev/null; then
            return 1
         fi
      fi
   fi
   return 0
}

# Check if a recipe is for this architecture.
# Parameters: recipe_name
recipe_select_arch() {
   local recipe="$1"
   local arch
   arch=$(recipe_item_get "$recipe" INFO arch)
   [[ -z "$arch" ]] && arch="$B_SARCH"
   for B_ARCH in ${arch/,/ }; do
      if [[ "$B_ARCH" == "all" || "$B_ARCH" == "$B_SARCH" ]]; then
         return 0
      fi
   done
   return 1
}

# Check if a recipe's version is already built.
# Parameters: recipe_name [forced_version] [instance]
# Returns 0 if not built, 1 if already built, 2 if version check failed.
# When forced_version is given, the recipe's version section is skipped.
# instance (if any) is included in the built-output path check.
check_version_built() {
   local pkg="$1"
   local fver="${2:-}"
   local inst="${3:-}"
   local RET=0
   local version versiondir pkgdir

   if [[ -n "$fver" ]]; then
      version="$fver"
   else
      version=$(version_get "$pkg") || return 2
   fi

   versiondir="$version"
   [[ -n "$inst" ]] && versiondir="$version-$inst"

   if [[ -n "$DESTSPLIT" ]]; then
      pkgdir="$DESTDIR/$B_DISTRODIR/$B_ARCH/$pkg/$versiondir"
   else
      pkgdir="$DESTDIR/$B_DISTRODIR/$B_ARCH/$pkg-$versiondir"
   fi

   if [[ -d "$pkgdir" ]]; then
      printf '%s\n' "$version"
      RET=1
   else
      printf '%s\n' "$version"
   fi
   return "$RET"
}

# --- Docker domain functions ---

# Print the list of known Debian-based distribution codenames that build
# can target. Single source of truth for the supported distro set; used by
# is_debian_distro() and by the hidden --list-distros helper (for bash
# completion).
known_distros() {
   printf '%s\n' \
      trixie bookworm sid bullseye buster stretch jessie
}

# Check if the given distro is a Debian-based distribution.
# Parameters: distro_name
# Returns 0 if Debian-based, 1 otherwise.
is_debian_distro() {
   local distro="$1"
   local d
   for d in $(known_distros); do
      [[ "$d" == "$distro" ]] && return 0
   done
   return 1
}

# Compute the distribution segment for the output directory.
# Produces a family-codename string such as "debian-trixie".
#
# Historically each distribution had its own build server, so output was
# split per host (DESTDIR was set per host, e.g. ~/build/<hostname>). With
# Docker all distributions build on one host, so the target distribution is
# encoded in the output path instead: $DESTDIR/<segment>/$B_ARCH/...
#
# In Docker mode, BUILDDISTRO may be given as either a bare codename
# ("trixie") or a family-codename ("debian-trixie"). Known codenames are
# mapped to their family. In native mode (e.g. the -S dev shell running
# inside a container), the running system's lsb_release output is used.
distro_dir() {
   local family="" codename=""
   if [[ -n "${BUILDDISTRO:-}" ]]; then
      if [[ "$BUILDDISTRO" == *-* ]]; then
         family="${BUILDDISTRO%%-*}"
         codename="${BUILDDISTRO#*-}"
      else
         codename="$BUILDDISTRO"
         if is_debian_distro "$codename"; then
            family="debian"
         else
            family="$codename"
         fi
      fi
   else
      family=$(lsb_release -i -s 2>/dev/null | tr '[:upper:]' '[:lower:]')
      codename=$(lsb_release -c -s 2>/dev/null | tr '[:upper:]' '[:lower:]')
      [[ -z "$family" ]] && family="unknown"
      [[ -z "$codename" ]] && codename="$family"
   fi
   # Set the global distribution globals: the directory segment (family-codename)
   # and the platform-agnostic bare codename used by publish hooks (TODEBREPO).
   B_DISTRODIR="$family-$codename"
   B_DISTRO="$codename"
}

# Declare a custom apt repository in a per-distro config file.
# Usage: repo <id> key=value ...
#   url=<url>          repository URL (required)
#   suite=<suite>      distribution suite / codename (required)
#   components=<c...>  space-separated components (default: main)
#   proxy=<url|DIRECT> per-repository proxy, or DIRECT to bypass the generic
#                      proxy for this repository's host
#   auth=<user:pass>   HTTP basic auth credentials for the repository host
#   authfile=<path>    path to an apt auth.conf.d credentials file (relative
#                      paths resolve against BUILD_REPOS_DIR)
#   key=<src>          signing key: file:<path> (relative to BUILD_REPOS_DIR or
#                      absolute), url:<https-url> or a plain https:// URL
#   signedby=<keyid>   optional apt signed-by key id (if key not given)
#   arch=<archs>       restrict to architectures (e.g. amd64,arm64)
repo() {
   local id="$1"; shift
   local kv k v
   if [[ -z "${REPO_URL[$id]+x}" ]]; then
      REPO_ORDER+=("$id")
   fi
   for kv in "$@"; do
      k="${kv%%=*}"; v="${kv#*=}"
      case "$k" in
         url)        REPO_URL["$id"]="$v" ;;
         suite)      REPO_SUITE["$id"]="$v" ;;
         components) REPO_COMPONENTS["$id"]="$v" ;;
         proxy)      REPO_PROXY["$id"]="$v" ;;
         auth)       REPO_AUTH["$id"]="$v" ;;
         authfile)   REPO_AUTHFILE["$id"]="$v" ;;
         key)        REPO_KEY["$id"]="$v" ;;
         signedby)   REPO_SIGNEDBY["$id"]="$v" ;;
         arch)       REPO_ARCH["$id"]="$v" ;;
         *) ERR=1 output "repo: unknown field '$k' for repository '$id'" ;;
      esac
   done
}

# Load per-distro apt/repository configuration.
# Sources $BUILD_REPOS_DIR/<distro> (or <family>-<distro>) if present, which may
# set PROXY (distro-specific generic proxy override), NO_DEFAULT_REPOS,
# DEFAULT_REPOS and declare repositories via the `repo` helper.
# Parameters: distro_codename
distro_repos_load() {
   local distro="${1:-}"
   local cfgfile=""
   # Reset state for this invocation.
   REPO_ORDER=()
   REPO_URL=() REPO_SUITE=() REPO_COMPONENTS=() REPO_PROXY=()
   REPO_AUTH=() REPO_AUTHFILE=() REPO_KEY=() REPO_ARCH=() REPO_SIGNEDBY=()
   NO_DEFAULT_REPOS=0
   DEFAULT_REPOS=""

   [[ -z "$distro" ]] && return 0

   local f
   for f in "${BUILD_REPOS_DIR}/${B_DISTRODIR}" "${BUILD_REPOS_DIR}/${distro}"; do
      if [[ -f "$f" ]]; then
         cfgfile="$f"
         break
      fi
   done
   [[ -z "$cfgfile" ]] && return 0

   # Source the per-distro config. It may reference the `repo` helper and set
   # PROXY/NO_DEFAULT_REPOS/DEFAULT_REPOS. Paths in `key=`/`authfile=` are
   # resolved against the config file's directory by the generator.
   # shellcheck source=/dev/null
   source "$cfgfile"
}

# Emit the standard Debian default sources for a codename into a .list file.
# Used when NO_DEFAULT_REPOS is not set and DEFAULT_REPOS is not provided.
# Parameters: output_list_file codename
_distro_default_sources() {
   local out="$1" codename="$2"
   local comps="main contrib non-free"
   case "$codename" in
      bookworm|trixie|sid) comps="main contrib non-free non-free-firmware" ;;
   esac
   {
      printf 'deb http://deb.debian.org/debian %s %s\n' "$codename" "$comps"
      if [[ "$codename" != sid ]]; then
         printf 'deb http://deb.debian.org/debian %s-updates %s\n' "$codename" "$comps"
         printf 'deb http://security.debian.org/debian-security %s-security %s\n' "$codename" "$comps"
      fi
   } > "$out"
}

# Generate the in-container apt configuration for a distro into a temp dir.
# Produces sources.list (empty), sources.list.d/*.list, apt.conf.d/99build-proxy,
# keyrings/*.gpg and auth.conf.d/*.conf entirely from build config -- never
# from the host's /etc/apt. Returns the dir path on stdout.
# Parameters: distro_codename
distro_apt_generate() {
   local distro="${1:-}"
   local cfgdir
   cfgdir=$(mktemp -d -t build-apt-XXXXXX) || { ERR=1 output "mktemp failed"; return 1; }
   mkdir -p "$cfgdir/sources.list.d" "$cfgdir/apt.conf.d" "$cfgdir/keyrings" "$cfgdir/auth.conf.d"
   : > "$cfgdir/sources.list"   # neutralise any image /etc/apt/sources.list

   # Only generate apt config for Debian-based distros (others have no apt).
   if [[ -n "$distro" ]] && ! is_debian_distro "$distro"; then
      printf '%s' "$cfgdir"
      return 0
   fi

   # Resolve config-file-relative key/authfile paths against the config dir.
   local cfgdir_base=""
   local f
   for f in "${BUILD_REPOS_DIR}/${B_DISTRODIR}" "${BUILD_REPOS_DIR}/${distro}"; do
      [[ -f "$f" ]] && { cfgdir_base=$(dirname "$f"); break; }
   done

   # --- Sources: defaults ---
   if [[ "${NO_DEFAULT_REPOS:-0}" == "1" ]]; then
      : # no default sources
   elif [[ -n "${DEFAULT_REPOS:-}" ]]; then
      printf '%s\n' "$DEFAULT_REPOS" > "$cfgdir/sources.list.d/00-default.list"
   else
      _distro_default_sources "$cfgdir/sources.list.d/00-default.list" "$distro"
   fi

   # --- Sources: custom repositories + per-repo proxy + keys + auth ---
   local id url suite comps proxy key auth authfile arch signedby host opts
   local proxyconf="$cfgdir/apt.conf.d/99build-proxy"
   : > "$proxyconf"
   for id in "${REPO_ORDER[@]}"; do
      url="${REPO_URL[$id]:-}"; suite="${REPO_SUITE[$id]:-}"
      comps="${REPO_COMPONENTS[$id]:-main}"
      [[ -z "$url" || -z "$suite" ]] && { ERR=1 output "repo '$id': url and suite are required"; rm -rf "$cfgdir"; return 1; }
      # host for proxy/auth directives
      host="${url#*://}"; host="${host%%/*}"
      # one-line sources entry with optional apt options [arch=... signed-by=...]
      opts=""
      [[ -n "${REPO_ARCH[$id]:-}" ]] && opts+="arch=${REPO_ARCH[$id]} "
      if [[ -n "${REPO_KEY[$id]:-}" ]]; then
         opts+="signed-by=/etc/apt/keyrings/${id}.gpg "
      elif [[ -n "${REPO_SIGNEDBY[$id]:-}" ]]; then
         opts+="signed-by=${REPO_SIGNEDBY[$id]} "
      fi
      if [[ -n "$opts" ]]; then
         printf 'deb [ %s] %s %s %s\n' "${opts% }" "$url" "$suite" "$comps" > "$cfgdir/sources.list.d/${id}.list"
      else
         printf 'deb %s %s %s\n' "$url" "$suite" "$comps" > "$cfgdir/sources.list.d/${id}.list"
      fi
      # per-repo proxy directive (overrides the generic http_proxy/https_proxy
      # env for this host; DIRECT bypasses the generic proxy).
      proxy="${REPO_PROXY[$id]:-}"
      if [[ -n "$proxy" && -n "$host" ]]; then
         if [[ "$proxy" == "DIRECT" ]]; then
            printf 'Acquire::http::Proxy::%s "DIRECT";\n' "$host" >> "$proxyconf"
            printf 'Acquire::https::Proxy::%s "DIRECT";\n' "$host" >> "$proxyconf"
         else
            printf 'Acquire::http::Proxy::%s "%s";\n' "$host" "$proxy" >> "$proxyconf"
            printf 'Acquire::https::Proxy::%s "%s";\n' "$host" "$proxy" >> "$proxyconf"
         fi
      fi
      # signing key import -> keyrings/<id>.gpg
      key="${REPO_KEY[$id]:-}"
      if [[ -n "$key" ]]; then
         local keysrc="$key" keytmp=""
         case "$key" in
            file:*) keysrc="${key#file:}" ;;
            url:*)  keysrc="${key#url:}" ;;
         esac
         if [[ "$key" == file:* ]]; then
            [[ "$keysrc" != /* ]] && keysrc="$cfgdir_base/$keysrc"
         fi
         if [[ "$key" == url:* ]] || [[ "$key" == http* ]]; then
            keytmp=$(mktemp) || { ERR=1 output "mktemp failed"; rm -rf "$cfgdir"; return 1; }
            if ! wget -q --secure-protocol=TLSv1_2 -O "$keytmp" "$keysrc" 2>/dev/null \
               && ! curl -fsSL -o "$keytmp" "$keysrc" 2>/dev/null; then
               ERR=1 output "repo '$id': failed to fetch key $keysrc"; rm -f "$keytmp"; rm -rf "$cfgdir"; return 1
            fi
            keysrc="$keytmp"
         fi
         [[ -f "$keysrc" ]] || { ERR=1 output "repo '$id': key not found: $key"; rm -f "$keytmp"; rm -rf "$cfgdir"; return 1; }
         if ! gpg --dearmor --yes --output "$cfgdir/keyrings/${id}.gpg" "$keysrc" 2>/dev/null; then
            # Fallback: file may already be a binary keyring.
            cp -f "$keysrc" "$cfgdir/keyrings/${id}.gpg" 2>/dev/null || {
               ERR=1 output "repo '$id': failed to import key $keysrc"; rm -f "$keytmp"; rm -rf "$cfgdir"; return 1; }
         fi
         rm -f "$keytmp"
      fi
      # auth credentials -> auth.conf.d/<id>.conf
      auth="${REPO_AUTH[$id]:-}"; authfile="${REPO_AUTHFILE[$id]:-}"
      if [[ -n "$authfile" ]]; then
         [[ "$authfile" != /* ]] && authfile="$cfgdir_base/$authfile"
         cp -f "$authfile" "$cfgdir/auth.conf.d/${id}.conf" 2>/dev/null || {
            ERR=1 output "repo '$id': authfile not found: $authfile"; rm -rf "$cfgdir"; return 1; }
      elif [[ -n "$auth" && -n "$host" ]]; then
         local user pass
         user="${auth%%:*}"; pass="${auth#*:}"
         printf 'machine %s login %s password %s\n' "$host" "$user" "$pass" > "$cfgdir/auth.conf.d/${id}.conf"
      fi
   done

   printf '%s' "$cfgdir"
}

# Add generated apt configuration mounts for a Debian-based build.
# Replaces the old host-/etc/apt mounting: the container's apt config is built
# solely from build configuration (defaults + per-distro file), so builds no
# longer depend on the host OS's repositories, proxies, keys or credentials.
# Parameters: docker_args_array_name (reference) distro_codename
docker_add_apt_config() {
   local -n args_ref="$1"
   local distro="${2:-}"

   _BUILD_APT_DIR=$(distro_apt_generate "$distro") || return 1
   local d="$_BUILD_APT_DIR"

   # Replace the image's sources.list and sources.list.d entirely with our
   # generated set (defaults + custom repos).
   args_ref+=("-v" "${d}/sources.list:/etc/apt/sources.list:ro")
   args_ref+=("-v" "${d}/sources.list.d:/etc/apt/sources.list.d:ro")

   # Per-repo proxy directives (additive; the image's apt.conf.d is untouched).
   if [[ -s "$d/apt.conf.d/99build-proxy" ]]; then
      args_ref+=("-v" "${d}/apt.conf.d/99build-proxy:/etc/apt/apt.conf.d/99build-proxy:ro")
   fi

   # Signing keys (mounted individually; image keyrings kept).
   local kf
   for kf in "$d"/keyrings/*.gpg; do
      [[ -f "$kf" ]] || continue
      args_ref+=("-v" "${kf}:/etc/apt/keyrings/$(basename "$kf"):ro")
   done

   # Auth credentials (mounted individually).
   local af
   for af in "$d"/auth.conf.d/*.conf; do
      [[ -f "$af" ]] || continue
      args_ref+=("-v" "${af}:/etc/apt/auth.conf.d/$(basename "$af"):ro")
   done
}

# Select the Docker image for a given distro name.
# Checks for custom image config, image prefix, then default mapping.
# Parameters: distro_name
# Returns the image name via printf.
docker_image_select() {
   local distro="$1"
   local image

   # Check for custom image config (e.g., DOCKER_IMAGE_TRIXIE)
   local config_var
   config_var="DOCKER_IMAGE_$(printf '%s' "$distro" | tr '[:lower:]' '[:upper:]')"
   if [[ -n "${!config_var:-}" ]]; then
      image="${!config_var}"
   elif [[ -n "$DOCKER_IMAGE_PREFIX" ]]; then
      image="${DOCKER_IMAGE_PREFIX}${distro}"
   else
      # Default mapping (uses custom build images with entrypoint)
      case "$distro" in
         trixie)    image="build-trixie:latest" ;;
         bookworm)  image="build-bookworm:latest" ;;
         sid)       image="build-sid:latest" ;;
         *)         image="debian:$distro" ;;
      esac
   fi
   printf '%s' "$image"
}

# Compute the content hash used to decide whether a build image is stale.
# Hashes the entrypoint and the distro's Dockerfile together, so any change to
# either (entrypoint logic, package list, base layer) is detected.
# Parameters: dockerfile_path
# Prints the sha256 on stdout; returns 1 if inputs are missing.
_docker_image_hash() {
   local dockerfile="$1"
   local entrypoint="${dockerfile%/*}/entrypoint.sh"
   [[ -f "$entrypoint" && -f "$dockerfile" ]] || return 1
   { cat "$entrypoint"; cat "$dockerfile"; } | sha256sum | awk '{print $1}'
}

# Ensure the Docker image for a distro exists and is up to date with the
# entrypoint and Dockerfile shipped with this script. Builds (or rebuilds) the
# image automatically when it is missing or when its recorded content hash no
# longer matches, so an admin never has to rebuild images by hand after an
# entrypoint/Dockerfile change. No-op for distros that use a pulled or
# externally configured image (no Dockerfile.<distro> found in DOCKER_DIR).
# Parameters: distro_name
# Returns 0 if the image is ready (or nothing to build), 1 on build failure.
docker_image_ensure() {
   local distro="$1"
   local image
   image=$(docker_image_select "$distro")

   local docker_dir="${DOCKER_DIR:-${0%/*}/docker}"
   local dockerfile="$docker_dir/Dockerfile.${distro}"
   # No shipped Dockerfile for this distro: nothing to build (pulled image).
   [[ -f "$dockerfile" ]] || return 0

   local hash
   hash=$(_docker_image_hash "$dockerfile") || {
      ERR=1 output "Cannot compute image hash; missing entrypoint.sh or Dockerfile.${distro}."
      return 1
   }

   local current=""
   if docker image inspect "$image" > /dev/null 2>&1; then
      current=$(docker image inspect --format '{{index .Config.Labels "build.image.hash"}}' "$image" 2>/dev/null)
   fi

   # Up to date: nothing to do.
   [[ "$current" == "$hash" ]] && return 0

   output -f "Rebuilding Docker image ${image} (entrypoint/Dockerfile changed)."
   local build_log
   build_log=$(mktemp -p "${TMPDIR:-/tmp}" build-image-XXXXXX.log)
   local rc
   if (( VERBOSE == 0 )); then
      docker build --label build.image.hash="$hash" -t "$image" \
         -f "$dockerfile" "$docker_dir" > "$build_log" 2>&1
      rc=$?
      (( rc != 0 )) && { ERR=1 output "Docker image build failed:"; cat "$build_log" >&2; }
   else
      docker build --label build.image.hash="$hash" -t "$image" \
         -f "$dockerfile" "$docker_dir"
      rc=$?
      (( rc != 0 )) && ERR=1 output "Docker image build failed (see output above)."
   fi
   rm -f "$build_log"
   return "$rc"
}

# Remove leftover build/package containers from previous runs. Every
# build-system container inherits the build.image.hash label from the build
# base image (set by docker_image_ensure), so filtering on that catches both
# current build containers (which also carry build.system=build) and legacy
# containers from older script versions that predate the build.system label.
# Only exited containers are removed here, so an active container is never
# killed (concurrent builds are already prevented by the build lock).
# Interactive -S shells use a separate label (build.system=shell) and are left
# alone (and clean themselves up via --rm on exit).
_docker_reap() {
   local leftovers
   leftovers=$(docker ps -aq --filter label=build.image.hash --filter status=exited 2>/dev/null)
   [[ -z "$leftovers" ]] && return 0
   local -a ids=()
   read -ra ids <<< "$leftovers"
   output "Reaping ${#ids[@]} leftover build container(s) (${ids[*]})."
   docker rm -f "${ids[@]}" > /dev/null 2>&1
}

# Best-effort Docker cleanup run once before each build session. Removes the
# leftovers of interrupted/failed builds (dangling images and build cache) so
# /var/lib/docker does not fill up and starve container writable layers of
# space. Controlled by DOCKERAUTOPRUNE in ~/.buildrc:
#   yes/on/1 - prune dangling images + build cache (safe; keeps base images)
#   full/all - also remove unused images (aggressive: base images are rebuilt
#              by docker_image_ensure on the next build)
#   anything else / empty - off
# Never fatal: a prune failure is reported but does not block the build.
_docker_autoprune() {
   local mode="${DOCKERAUTOPRUNE:-}"
   case "$mode" in
      ""|0|no|off|No|Off|NO|OFF) return 0 ;;
      yes|on|1|full|all|YES|ON|FULL|ALL) : ;;
      *) output "DOCKERAUTOPRUNE: unknown value '$mode' (expected yes, full or off)"; return 0 ;;
   esac
   command -v docker > /dev/null 2>&1 || return 0
   docker image prune -f > /dev/null 2>&1 || true
   docker builder prune -f > /dev/null 2>&1 || true
   if [[ "$mode" == "full" || "$mode" == "all" || "$mode" == "FULL" || "$mode" == "ALL" ]]; then
      output "Docker auto-prune (full): removing unused images (base images will be rebuilt)..."
      docker image prune -a -f > /dev/null 2>&1 || true
   fi
   return 0
}

# Prepare the build environment script for use inside a Docker container.
# Writes all exported variables and function definitions to a script file
# that will be sourced inside the container.
# Parameters: envfile_path
# Returns 0 on success.
docker_prepare_env() {
   local envfile="$1"

   {
      printf '#!/usr/bin/env bash\n'
      printf '# Build environment for %s\n\n' "${B_NAME}"

      # Export all B_* variables
      printf 'export B_VERSION="%s"\n' "$B_VERSION"
      printf 'export B_INSTALLDIR="%s"\n' "$B_INSTALLDIR"
      printf 'export B_DISTRODIR="%s"\n' "$B_DISTRODIR"
      printf 'export B_DISTRO="%s"\n' "$B_DISTRO"
      printf 'export B_ARCH="%s"\n' "$B_ARCH"
      printf 'export B_NAME="%s"\n' "$B_NAME"
      printf 'export B_BUILDNR="%s"\n' "$B_BUILDNR"
      printf 'export B_CACHEDIR="%s"\n' "$B_CACHEDIR"
      printf 'export B_FILES="%s"\n' "${B_FILES:-}"
      printf 'export B_FORCE="%s"\n' "$B_FORCE"
      printf 'export B_INSTANCE="%s"\n' "${B_INSTANCE:-}"
      printf 'export BUILDMODE=docker\n'
      printf 'export TMPDIR=/tmp\n'
      printf 'export HOME="%s"\n' "$HOME"
      printf 'export PKGLIST="%s"\n' "$PKGLIST"
      printf 'export DESTDIR="%s"\n' "$DESTDIR"
      printf 'export DESTSPLIT="%s"\n' "${DESTSPLIT:-}"
      printf 'export RECIPEDIR="%s"\n' "$RECIPEDIR"
      printf 'export LOGDIR="%s"\n' "$LOGDIR"
      printf 'export XDG_CACHE_HOME="/tmp/.cache"\n'
      printf 'export YARN_CACHE_FOLDER="/tmp/.cache/yarn"\n'

      # Packaging variables
      printf 'export PKGDIR="%s"\n' "$PKGDIR"
      printf 'export PKGPOSTFIX="%s"\n' "${PKGPOSTFIX:-}"
      printf 'export PKGMAIL="%s"\n' "${PKGMAIL:-}"
      printf 'export PKGORG="%s"\n' "${PKGORG:-}"
      printf 'export QUIET=%s\n' "$QUIET"
      printf 'export B_VERBOSE=%s\n' "${VERBOSE:-0}"

      # Source-integrity variables (SECURITY.md group A)
      printf 'export B_GPGKEY="%s"\n' "${B_GPGKEY:-}"
      printf 'export B_COMMIT="%s"\n' "${B_COMMIT:-}"
      printf 'export B_SHA256="%s"\n' "${B_SHA256:-}"
      printf 'export B_ALLOW_INSECURE="%s"\n' "${B_ALLOW_INSECURE:-}"
      printf 'export B_GPGKEYFILE="%s"\n' "${B_GPGKEYFILE:-}"
      printf 'export B_STRICT="%s"\n' "${B_STRICT:-0}"

      # Distribution variables (used by package_deb for section selection)
      printf 'distr="%s"\n' "${distr:-}"
      printf 'rel="%s"\n' "${rel:-}"

      # Function definitions (exported from build() function scope)
      declare -f B_GET B_GITCHECKOUT B_LINKFILES B_LINKFILE B_UPDATEPKGBLD

      # Utility functions needed by packaging
      declare -f output

      # Recipe functions needed by packaging
      declare -f recipe_section_get recipe_item_get

      # Package functions
      declare -f package_buildnr_get package_deb package_rpm

   } > "$envfile"

   return 0
}

# Prepare the package command script for use inside a Docker container.
# Writes a script that sets up packaging variables and calls the appropriate
# packaging function (package_deb or package_rpm).
# Parameters: envfile_path recipe_name version
# Returns the path to the package command script.
docker_prepare_package_cmd() {
   local pkgfile="$1"
   local pkg="$2"
   local version="$3"
   local id_val

   # Compute ID (same logic as package() function)
   if [[ -n "${B_INSTANCE:-}" ]]; then
      id_val="${version}-${B_INSTANCE}"
   else
      id_val="${version}"
   fi

   cat > "$pkgfile" << PKGSCRIPT
#!/usr/bin/env bash
# Package command for ${pkg} version ${version}

pkg="${pkg}"
version="${version}"
ID="${id_val}"

if [[ -n "\$DESTSPLIT" ]]; then
   pkgdir="\$DESTDIR/\$B_DISTRODIR/\$B_ARCH/\$pkg/\$version"
else
   pkgdir="\$DESTDIR/\$B_DISTRODIR/\$B_ARCH/\$pkg-\$version"
fi
if [[ ! -d "\$pkgdir" ]]; then
   ERR=1 output "Version \$version of \$pkg is not available for packaging."
   exit 1
fi

pkg_type=\$(recipe_item_get "\$pkg" PKG type) || true
for pkgtype in \${pkg_type/,/ }; do
   case "\$pkgtype" in
      "deb")
         pkgfile=\$(package_deb "\$pkg" "\$version") || exit 1
         if [[ -n "\$pkgfile" ]]; then
            printf '%s' "\$pkgfile" > "\${LOGDIR}/.package-result-\${pkg}.txt"
         else
            printf 'package_deb returned empty result\n' >&2
            exit 1
         fi
         ;;
      "rpm")
         pkgfile=\$(package_rpm "\$pkg" "\$version") || exit 1
         if [[ -n "\$pkgfile" ]]; then
            printf '%s' "\$pkgfile" > "\${LOGDIR}/.package-result-\${pkg}.txt"
         else
            printf 'package_rpm returned empty result\n' >&2
            exit 1
         fi
         ;;
      *)
         ERR=1 output "Unknown package type (\$pkgtype)."
         exit 1
         ;;
   esac
done
PKGSCRIPT

   chmod +x "$pkgfile"
   return 0
}

# Append the common environment (-e) flags to a docker args array.
# Build-only vars (B_FILES, B_FORCE, BUILD_DEPS) are added by the caller when
# running a build, so a package-only container never installs build deps.
# Parameters: array_name (nameref)
_docker_env_args() {
   local -n _ea_ref="$1"
   _ea_ref+=(
      "-e" "B_VERSION=${B_VERSION}"
      "-e" "B_INSTALLDIR=${B_INSTALLDIR:-}"
      "-e" "B_DISTRODIR=${B_DISTRODIR:-}"
      "-e" "B_DISTRO=${B_DISTRO:-}"
      "-e" "B_ARCH=${B_ARCH}"
      "-e" "B_NAME=${B_NAME}"
      "-e" "B_BUILDNR=${B_BUILDNR:-1}"
      "-e" "B_CACHEDIR=${CACHEDIR:-}"
      "-e" "B_INSTANCE=${B_INSTANCE:-}"
      "-e" "HOME=${HOME}"
      "-e" "BUILDMODE=docker"
      "-e" "HOST_UID=$(id -u)"
      "-e" "HOST_GID=$(id -g)"
      "-e" "TMPDIR=/tmp"
      "-e" "DESTDIR=${DESTDIR}"
      "-e" "DESTSPLIT=${DESTSPLIT:-}"
      "-e" "RECIPEDIR=${RECIPEDIR}"
      "-e" "LOGDIR=${LOGDIR}"
      "-e" "PKGLIST=${PKGLIST}"
      "-e" "PKGDIR=${PKGDIR}"
      "-e" "PKGPOSTFIX=${PKGPOSTFIX:-}"
      "-e" "PKGMAIL=${PKGMAIL:-}"
      "-e" "PKGORG=${PKGORG:-}"
      "-e" "B_GPGKEY=${B_GPGKEY:-}"
      "-e" "B_COMMIT=${B_COMMIT:-}"
      "-e" "B_SHA256=${B_SHA256:-}"
      "-e" "B_ALLOW_INSECURE=${B_ALLOW_INSECURE:-}"
      "-e" "B_GPGKEYFILE=${B_GPGKEYFILE:-}"
      "-e" "B_STRICT=${B_STRICT:-0}"
      "-e" "B_VERBOSE=${VERBOSE:-0}"
      "-e" "distr=${distr:-}"
      "-e" "rel=${rel:-}"
   )
}

# Run a Docker container for a build and/or package phase.
# Single implementation backing both docker_run_build and docker_run_package.
# Parameters: image envfile [buildfile] [pkgcmdfile]
#   buildfile  - if given, the build phase runs (with DEBUGSHELL sentinel
#                support and the symlink-base mount loop); if absent, this is a
#                package-only run.
#   pkgcmdfile - optional package command script; if given alongside a build,
#                packaging runs after the build in the same container.
# Returns the exit status of the container.
_docker_run() {
   local image="$1" envfile="$2" buildfile="${3:-}" pkgcmdfile="${4:-}"
   local container_id result
   local -a docker_args=()

   local build_mode=0
   [[ -n "$buildfile" ]] && build_mode=1

   # Hostname for identification
   docker_args+=("--hostname" "$([[ $build_mode == 1 ]] && printf 'build' || printf 'package')-${B_NAME}")

   # Mount volumes (same paths inside and outside container).
   # Resolve symlinks for directories that may be symlinked on the host.
   #
   # Only the specific home sub-trees the build needs are mounted -- NOT the
   # whole $HOME. Mounting the whole home lets build tools (cargo, gradle,
   # cpanm, maven, ccache, npm, ...) write their caches into $HOME/.<tool> on
   # the host, where they persist as unbounded, unintended build artifacts
   # (the .cargo/.gradle/.cpanm/... accumulation this fixes). By leaving those
   # paths unmounted, such writes land in the container's ephemeral writable
   # layer and are discarded when the container is removed, so only the real
   # build output (~/build, ~/packages, ~/log), the legitimate caches
   # (~/cache, ~/.gnupg), and build state (~/etc) persist. The interactive
   # dev shell (-S / docker_run_shell) still mounts the whole home, as a dev
   # shell is expected to have the user's full environment.
   local recipes_real home_real
   recipes_real=$(readlink -f "$RECIPEDIR")
   home_real=$(readlink -f "$HOME")
   docker_args+=("-v" "${recipes_real}:${RECIPEDIR}")
   # CACHEDIR is only needed for builds; package-only runs don't use it.
   [[ $build_mode == 1 ]] && docker_args+=("-v" "$(readlink -f "$CACHEDIR"):${CACHEDIR}")
   # ~/etc holds PKGLIST (build-number state), read and written in-container
   # by B_UPDATEPKGBLD / package_deb, so it must persist and be writable.
   [[ -d "$HOME/etc" ]] && docker_args+=("-v" "$(readlink -f "$HOME/etc"):${HOME}/etc")
   # Credentials/config the build needs from $HOME (read-only):
   #   .buildrc  - re-sourced by B_UPDATEPKGBLD for PKGLIST/PKGORG/PKGMAIL/...
   #   .ssh      - SSH keys/config/known_hosts for git clone over ssh://
   #   .gitconfig - safe even if unused (clone/verify need no commit identity)
   [[ -f "$HOME/.buildrc" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.buildrc"):${HOME}/.buildrc:ro")
   [[ -d "$HOME/.ssh" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.ssh"):${HOME}/.ssh:ro")
   [[ -f "$HOME/.gitconfig" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.gitconfig"):${HOME}/.gitconfig:ro")
   # ~/.gnupg: persistent GPG keyring cache for B_GITCHECKOUT source-integrity
   # verification (SECURITY.md group A1). Read-write so keys fetched from a
   # keyserver or imported from a recipe key file persist across builds (works
   # offline, avoids per-build re-fetch). Apt repo signing keys are separate --
   # docker_add_apt_config mounts those at /etc/apt/keyrings.
   [[ -d "$HOME/.gnupg" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.gnupg"):${HOME}/.gnupg")

   # Optional: bind-mount a host directory over the container's /tmp so large
   # source extractions land on a volume with space instead of the container's
   # small writable layer (BUILDDOCKERTMP in ~/.buildrc). Build-only; /tmp is
   # where the entrypoint extracts sources. The read-only build-script files
   # are mounted under /opt/build (not /tmp) so Docker does not create
   # root-owned placeholder files inside this bind mount.
   local docker_tmp=0
   local bdt_subdir=""
   if [[ $build_mode == 1 && -n "${BUILDDOCKERTMP:-}" ]]; then
      local bdt_real bdt_mode
      bdt_real=$(readlink -f "$BUILDDOCKERTMP" 2>/dev/null) || bdt_real="$BUILDDOCKERTMP"
      if ! mkdir -p "$bdt_real" 2>/dev/null; then
         ERR=1 output "BUILDDOCKERTMP: cannot create directory $bdt_real"
         return 1
      fi
      # BUILDDOCKERTMP must be world-writable/searchable (777). The container's
      # builduser (same UID as the host user) writes source extractions into the
      # bind-mounted /tmp; if the directory is not open to all the build fails
      # deep inside with a confusing "permission denied". Check up front so the
      # error names the cause and the fix instead of surfacing mid-build.
      bdt_mode=$(stat -c '%a' "$bdt_real" 2>/dev/null || echo "")
      if [[ "$bdt_mode" != "777" ]]; then
         ERR=1 output "BUILDDOCKERTMP: $bdt_real must have 777 permissions (found ${bdt_mode:-unknown}); fix with: chmod 777 $bdt_real"
         return 1
      fi
      # Create a unique per-build subdirectory under BUILDDOCKERTMP and bind-mount
      # it over the container's /tmp. This isolates concurrent builds (no clashes
      # from shared source-extraction names like a bare "git clone" destination)
      # and lets the host drop the whole build tree afterwards with a single
      # rmdir: the container runs as root and cleans the contents before exiting,
      # so root-owned artifacts (created by apt/dpkg/etc.) are removed even though
      # the host builduser could not delete them.
      bdt_subdir="${bdt_real}/build-${B_NAME:-build}-$$-$RANDOM"
      if ! mkdir -p "$bdt_subdir" 2>/dev/null || ! chmod 777 "$bdt_subdir" 2>/dev/null; then
         ERR=1 output "BUILDDOCKERTMP: cannot create build directory $bdt_subdir"
         return 1
      fi
      docker_args+=("-v" "${bdt_subdir}:/tmp")
      docker_tmp=1
      # Ensure the symlink-target base dir is mounted so the path resolves
      # inside the container (same logic as the symlink-base loop below).
      local bdt_base
      bdt_base=$(dirname "$bdt_real")
      if [[ "$bdt_base" != "$HOME" && "$bdt_base" != "$RECIPEDIR" && "$bdt_base" != "$CACHEDIR" && "$bdt_base" != "$DESTDIR" && "$bdt_base" != "$LOGDIR" ]]; then
         docker_args+=("-v" "${bdt_base}:${bdt_base}")
      fi
   fi

   docker_args+=(
      "-v" "$(readlink -f "$DESTDIR"):${DESTDIR}"
      "-v" "$(readlink -f "$LOGDIR"):${LOGDIR}"
      "-v" "${envfile}:/opt/build/build-env.sh:ro"
   )
   [[ -n "$buildfile" ]] && docker_args+=("-v" "${buildfile}:/opt/build/build-cmd.sh:ro")
   [[ -n "$pkgcmdfile" ]] && docker_args+=("-v" "${pkgcmdfile}:/opt/build/package-cmd.sh:ro")

   # Also mount symlink target base dirs so chains resolve inside the container.
   # This handles cases like /home/builduser/recipes -> /home/builduser.orig/recipes
   # where the symlink target must be reachable at its real path. Needed for the
   # build phase (which may checkout sources into these paths) AND the package
   # phase (which reads recipe files and the build output dir).
   #
   # $home_real itself is deliberately excluded from the loop: mounting its
   # base (e.g. /home) would expose the whole home tree -- including the
   # tool-cache dot-dirs this per-subdir strategy keeps ephemeral. The guard
   # also skips any base that is $HOME or an ancestor of it for the same
   # reason. (A split setup where individual subdirs symlink to a *different*
   # real home may still expose that target's tree; not present in the
   # current deployment.)
   if [[ $build_mode == 1 || -n "$pkgcmdfile" ]]; then
      local mount_real base_real
      for mount_real in "$recipes_real" "$(readlink -f "$CACHEDIR")" "$(readlink -f "$DESTDIR")" "$(readlink -f "$LOGDIR")" "$(readlink -f "$HOME/etc")" "$(readlink -f "$HOME/.ssh")" "$(readlink -f "$HOME/.gnupg")" "$(readlink -f "$HOME/.buildrc")" "$(readlink -f "$HOME/.gitconfig")"; do
         base_real=$(dirname "$mount_real")
         if [[ "$base_real" != "$HOME" && "$base_real" != "$RECIPEDIR" && "$base_real" != "$CACHEDIR" && "$base_real" != "$DESTDIR" && "$base_real" != "$LOGDIR" && "$home_real" != "$base_real" && "$home_real" != "${base_real}/"* ]]; then
            docker_args+=("-v" "${base_real}:${base_real}")
         fi
      done

      # Mount the real target directories of the current recipe's symlinked
      # recipe file and .files dir so they resolve inside the container.
      # Recipe files (and their .files companions) are commonly symlinks into
      # a separate recipes source tree (e.g. ~/recipes.github/<name>/); only
      # ~/recipes is bind-mounted above, so a symlink like
      # ~/recipes/<name>.recipe -> ../recipes.github/<name>/<name>.recipe
      # dangles inside the container unless its target directory is also
      # mounted. The package phase reads recipe sections and
      # <name>.files/B_DEBIAN in-container, so the targets must be reachable.
      # No-op for real (non-symlinked) recipe files. Read-only: recipes are
      # never written to from a build/package container.
      local rpath rtarget rbase existing_mounts
      for rpath in "$RECIPEDIR/$B_NAME.recipe" "$RECIPEDIR/$B_NAME.files"; do
         [[ -L "$rpath" ]] || continue
         rtarget=$(readlink -f "$rpath" 2>/dev/null) || continue
         [[ -n "$rtarget" ]] || continue
         if [[ -d "$rtarget" ]]; then
            rbase="$rtarget"
         else
            rbase=$(dirname "$rtarget")
         fi
         # Skip $HOME / ancestors (would re-expose the whole home tree) and
         # dirs already covered by an existing mount.
         [[ "$rbase" == "$HOME" || "$HOME" == "$rbase"/* ]] && continue
         existing_mounts=" ${docker_args[*]} "
         [[ "$existing_mounts" == *" -v ${rbase}:${rbase}"* ]] && continue
         docker_args+=("-v" "${rbase}:${rbase}:ro")
      done
   fi

   # Mount PKGDIR if it exists
   if [[ -d "$PKGDIR" ]]; then
      docker_args+=("-v" "${PKGDIR}:${PKGDIR}")
   fi

   # Mount generated apt configuration for Debian-based builds (defaults +
   # custom repos, per-repo proxy, keys, auth) -- never host /etc/apt.
   docker_add_apt_config docker_args "${BUILDDISTRO:-}" || return 1

   # Pass environment variables (common set; build-only vars added below)
   _docker_env_args docker_args
   if [[ $build_mode == 1 ]]; then
      docker_args+=(
         "-e" "B_FILES=${B_FILES:-}"
         "-e" "B_FORCE=${B_FORCE}"
         "-e" "BUILD_DEPS=${BUILD_DEPS:-}"
         "-e" "B_DOCKERTMP=${docker_tmp}"
      )
   fi

   # Proxy settings
   [[ -n "$PROXY" ]] && docker_args+=("-e" "http_proxy=${PROXY}" "-e" "https_proxy=${PROXY}")

   if [[ -n "$buildfile" && -n "$pkgcmdfile" ]]; then
      output "Building ${B_NAME} (${image})..."
   elif [[ -n "$buildfile" ]]; then
      output "Building ${B_NAME} (${image})..."
   else
      output "Packaging ${B_NAME} (${image})..."
   fi

   # Reap leftover containers from previous (possibly interrupted) runs so
   # overlay2 does not accumulate exited build containers.
   _docker_reap

   docker_args+=("--label" "build.system=build")

   # Unique token ties the container's debug-wait sentinel to this run (build only).
   local debug_token="" sentinel="" debug_ready=0
   if [[ $build_mode == 1 ]]; then
      debug_token="${B_NAME:-build}-$$-$RANDOM"
      docker_args+=("-e" "DEBUGSHELL=${DEBUGSHELL:-0}")
      docker_args+=("-e" "_BUILD_DEBUG_TOKEN=${debug_token}")
      sentinel="$LOGDIR/.build-debug-${debug_token}"
   fi

   # Run container detached; the entrypoint writes build output to the mounted
   # log file (append) and cats it to stdout for `docker logs`. Truncate the
   # per-recipe log first so each run starts fresh -- otherwise the entrypoint
   # appends across runs and verbose mode replays stale output from previous
   # builds, making failures hard to read.
   : > "$LOGDIR/${B_NAME}-${B_ARCH}.log" 2>/dev/null || true
   container_id=$(docker run -d "${docker_args[@]}" "$image")
   if [[ -z "$container_id" ]]; then
      ERR=1 output "Failed to start Docker container."
      [[ -n "${bdt_subdir:-}" ]] && rmdir "$bdt_subdir" 2>/dev/null || true
      rm -rf "$_BUILD_APT_DIR" 2>/dev/null
      return 1
   fi

   # Stream logs in the background while we wait for completion (or debug-wait).
   # In quiet mode the container's log file already captures all build output;
   # suppress the live stream so nothing leaks to the host stdout/stderr (which
   # would, e.g., trigger an unwanted cron mail on top of the -m summary).
   if (( QUIET >= 1 )); then
      docker logs -f "$container_id" > /dev/null 2>&1 &
   else
      docker logs -f "$container_id" 2>&1 &
   fi
   local logpid=$!

   # Best-effort cleanup if interrupted (Ctrl-C): remove the container so it
   # does not leak, and drop the per-build /tmp subdirectory so root-owned
   # artifacts do not accumulate. The container is killed before it can run its
   # own cleanup, so try to exec a root cleanup first; if that fails (container
   # already gone) fall back to removing what the host builduser can. Leftover
   # containers are also reaped at the start of the next run.
   # On Ctrl-C, also drop the install directory for build runs so a
   # half-built tree is not mistaken for a completed build on the next run.
   # Package-only runs (build_mode == 0) keep the (successful) install dir.
   trap 'kill "$logpid" 2>/dev/null; docker exec "$container_id" find /tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; docker rm -f "$container_id" > /dev/null 2>&1; [[ $build_mode == 1 && -n "${B_INSTALLDIR:-}" ]] && rm -rf "$B_INSTALLDIR" 2>/dev/null; [[ -n "${bdt_subdir:-}" ]] && rmdir "$bdt_subdir" 2>/dev/null; exit 130' INT TERM

   local st
   while :; do
      st=$(docker inspect -f '{{.State.Status}}' "$container_id" 2>/dev/null || echo exited)
      [[ "$st" == "exited" ]] && break
      if [[ -n "$sentinel" && -f "$sentinel" ]]; then
         debug_ready=1
         break
      fi
      sleep 1
   done

   kill "$logpid" 2>/dev/null
   wait "$logpid" 2>/dev/null
   trap - INT TERM

   if [[ "$debug_ready" == "1" ]]; then
      # Build failed with DEBUGSHELL: the entrypoint keeps the container alive so
      # the user can inspect it interactively via docker exec.
      printf '\n'
      printf '%s\n' "## Build failed. Container $container_id kept alive for debugging."
      printf '%s\n' "## Attach with: docker exec -it -w /tmp -e PS1='\\h:\\w buildroot $ ' $container_id bash --norc"
      printf '%s\n' "## Type exit to return (the container is then removed automatically)."
      printf '%s\n' ""
      # Drop into a clean shell (no host bashrc) at the build root (/tmp, where
      # sources are extracted) with a default PS1 so custom host prompts don't
      # error out.
      docker exec -it -w /tmp -e PS1='\h:\w buildroot $ ' "$container_id" bash --norc
      rm -f "$sentinel"
      # Clean the per-build /tmp (root-owned artifacts included) while the
      # container is still alive, then remove it and drop the now-empty subdir.
      docker exec "$container_id" find /tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
      docker rm -f "$container_id" > /dev/null 2>&1
      [[ -n "${bdt_subdir:-}" ]] && rmdir "$bdt_subdir" 2>/dev/null || true
      rm -rf "$_BUILD_APT_DIR" 2>/dev/null
      return 1
   fi

   # Normal completion: capture the container's exit code and clean up.
   # The entrypoint's exit trap already emptied the per-build /tmp subdirectory
   # (as root), so rmdir should succeed; guard anyway in case a crashed prior
   # run left root-owned files the host builduser cannot remove.
   local exit_code
   exit_code=$(docker inspect --format='{{.State.ExitCode}}' "$container_id" 2>/dev/null || echo "1")
   result="$exit_code"
   docker rm "$container_id" > /dev/null 2>&1

   if [[ -n "${bdt_subdir:-}" ]]; then
      rmdir "$bdt_subdir" 2>/dev/null || ERR=1 output "BUILDDOCKERTMP: could not remove $bdt_subdir (leftover root-owned files); remove manually as root"
   fi

   rm -rf "$_BUILD_APT_DIR" 2>/dev/null

   return "$result"
}

# Run the build phase (and optionally package phase) inside a Docker container.
# Parameters: image envfile buildfile [pkgcmdfile]
#   pkgcmdfile - optional path to package command script; if provided,
#               the container will also run the packaging phase after build.
# Returns the exit status of the docker run command.
docker_run_build() {
   _docker_run "$1" "$2" "$3" "${4:-}"
}

# Run only the packaging phase inside a Docker container.
# Used when BUILDMODE=docker and -p is specified without -b, so the host
# doesn't need dpkg/fakeroot installed.
# Parameters: image envfile pkgcmdfile
# Returns the exit status of the docker run command.
# After the container exits, reads the package result file to get the filename.
docker_run_package() {
   _docker_run "$1" "$2" "" "$3"
}

# Start interactive development shell in a Docker container.
# Mounts all build directories and provides the build environment so the user
# can run builds, inspect files, and develop recipes interactively.
# Parameters: distro_name
# Returns exit code of the docker run command.
docker_shell() {
   local distro="$1"
   local image
   image=$(docker_image_select "$distro")

   # Build/rebuild the image automatically if missing or stale; for distros
   # without a shipped Dockerfile (pulled images) this is a no-op.
   docker_image_ensure "$distro" || return 1
   if ! docker image inspect "$image" > /dev/null 2>&1; then
      ERR=1 output "Docker image '$image' not found. Pull it with: docker pull $image"
      return 1
   fi

   # Reap leftover build containers from previous runs before starting a shell.
   _docker_reap

   local -a docker_args=(
      "-it"
      "--rm"
      "--label" "build.system=shell"
      "--hostname" "build-dev-${distro}"
   )

   # Mount volumes (resolve symlinks for directories that may be symlinked on the host)
   local recipes_real home_real
   recipes_real=$(readlink -f "$RECIPEDIR")
   home_real=$(readlink -f "$HOME")
   docker_args+=(
      "-v" "${home_real}:${HOME}"
      "-v" "${recipes_real}:${RECIPEDIR}"
      "-v" "$(readlink -f "$CACHEDIR"):${CACHEDIR}"
      "-v" "$(readlink -f "$DESTDIR"):${DESTDIR}"
      "-v" "$(readlink -f "$LOGDIR"):${LOGDIR}"
   )

   # Mount PKGDIR if it exists
   if [[ -d "$PKGDIR" ]]; then
      docker_args+=("-v" "${PKGDIR}:${PKGDIR}")
   fi

   # Mount generated apt configuration for Debian-based builds (defaults +
   # custom repos, per-repo proxy, keys, auth) -- never host /etc/apt.
   docker_add_apt_config docker_args "$distro" || return 1

   # Mount the build script into the container so 'build' command works inside
   local build_script_path
   build_script_path=$(command -v build 2>/dev/null || true)
   # Fallback: use the running script's own path
   if [[ -z "$build_script_path" ]]; then
      build_script_path="${0}"
   fi
   if [[ -n "$build_script_path" && -f "$build_script_path" ]]; then
      docker_args+=("-v" "${build_script_path}:${HOME}/bin/build:ro")
   fi

   # Also mount the torepo script if available
   local torepo_path
   torepo_path=$(command -v torepo 2>/dev/null || true)
   if [[ -n "$torepo_path" && -f "$torepo_path" ]]; then
      docker_args+=("-v" "${torepo_path}:${HOME}/bin/torepo:ro")
   fi

   # Environment variables
   # Set BUILDMODE=native so that builds inside the container run natively
   # (Docker is not available inside the container)
   docker_args+=(
      "-e" "HOME=${HOME}"
      "-e" "B_ARCH=${B_SARCH}"
      "-e" "BUILDMODE=native"
      "-e" "HOST_UID=$(id -u)"
      "-e" "HOST_GID=$(id -g)"
      "-e" "RECIPEDIR=${RECIPEDIR}"
      "-e" "DESTDIR=${DESTDIR}"
      "-e" "CACHEDIR=${CACHEDIR}"
      "-e" "PKGDIR=${PKGDIR}"
      "-e" "LOGDIR=${LOGDIR}"
      "-e" "PKGLIST=${PKGLIST}"
      "-e" "DESTSPLIT=${DESTSPLIT:-}"
   )

   # Pass instance if specified
   [[ -n "${B_INSTANCE:-}" ]] && docker_args+=("-e" "B_INSTANCE=${B_INSTANCE}")
   # Verbose flag (so the entrypoint surfaces suppressed command output)
   docker_args+=("-e" "B_VERBOSE=${VERBOSE:-0}")

   # Proxy settings
   [[ -n "$PROXY" ]] && docker_args+=("-e" "http_proxy=${PROXY}" "-e" "https_proxy=${PROXY}")

   printf '## Build development shell for %s\n' "$distro"
   printf '## Image: %s\n' "$image"
   printf '## Type exit to leave.\n'
   printf '## Use sudo apt-get install <pkg> to install packages.\n'
   printf '\n'

   docker run "${docker_args[@]}" "$image"
   local rc=$?
   rm -rf "$_BUILD_APT_DIR" 2>/dev/null
   return $rc
}

# Attach to a running Docker container for interactive debugging.
# Convenience wrapper around docker exec for re-attaching to containers
# left running after a failed build with -s flag.
# Parameters: container_id
# Returns exit code of the docker exec command.
docker_attach() {
   local container_id="$1"

   # Verify the container exists and is running
   if ! docker inspect --format='{{.State.Status}}' "$container_id" > /dev/null 2>&1; then
      ERR=1 output "Container '$container_id' not found."
      return 1
   fi

   local status
   status=$(docker inspect --format='{{.State.Status}}' "$container_id" 2>/dev/null)
   if [[ "$status" != "running" ]]; then
      ERR=1 output "Container '$container_id' is not running (status: $status)."
      return 1
   fi

   printf '## Attaching to container %s\n' "$container_id"
   printf '## Type exit to detach.\n'
   printf '\n'

   # Drop into a clean shell (no host bashrc) at the build root (/tmp, where
   # sources are extracted) with a default PS1 so custom host prompts don't
   # error out.
   docker exec -it -w /tmp -e PS1='\h:\w buildroot $ ' "$container_id" bash --norc
   return $?
}

# Parse command-line options and populate work arrays.
# Parameters: script arguments
parse_options() {
   B_FORCE=0
   DEBUG=""
   DEBUGSHELL=""
   B_INSTANCE=""
   DO_CHECK=0
   DO_BUILD=0
   DO_PACKAGE=0
   DO_REPO=0
   B_NOPKGRM=0
   local all=0

   while getopts :csbprad:i:RS:A:xvqfhm: opt; do
      case $opt in
      c)
         DO_CHECK=1
         ;;
      b)
         DO_CHECK=2
         DO_BUILD=1
         ;;
      p)
         DO_CHECK=2
         DO_PACKAGE=1
         ;;
      r)
         DO_CHECK=2
         DO_PACKAGE=2
         DO_REPO=1
         ;;
      a)
         all=1
         ;;
      d)
         BUILDDISTRO="$OPTARG"
         ;;
      i)
         B_INSTANCE="$OPTARG"
         ;;
      R)
         B_NOPKGRM=1
         ;;
      S)
         SHELL_MODE=1
         BUILDDISTRO="$OPTARG"
         ;;
      A)
         ATTACH_CONTAINER="$OPTARG"
         ;;
      x)
         DEBUG=1
         ;;
      v)
         VERBOSE=1
         ;;
      s)
         DEBUGSHELL=1
         ;;
      q)
         QUIET=$((QUIET + 1))
         ;;
      f)
         B_FORCE=1
         ;;
      h)
         usage
         return 1
         ;;
      m)
         email="$OPTARG"
         ;;
      \?)
         printf '%s\n' "Unknown option: -$OPTARG"
         usage
         return 1
         ;;
      :)
         printf '%s\n' "Option -$OPTARG requires argument"
         usage
         return 1
         ;;
      esac
   done
   shift $((OPTIND - 1))

   if (( DO_CHECK == 0 && DO_BUILD == 0 && DO_PACKAGE == 0 && DO_REPO == 0 )) && (( SHELL_MODE == 0 )) && [[ -z "$ATTACH_CONTAINER" ]]; then
      output "No action specified."
      return 1
   fi

   # Determine distribution and release (distr/rel) before selecting recipes.
   # recipe_select_build() (used by the -a loop below) references these, so they
   # must be set here, after getopts populated BUILDDISTRO. In Docker mode use
   # the specified distro; otherwise detect from the running system.
   if [[ -n "$BUILDDISTRO" ]]; then
      IFS='-' read -r distr rel <<< "$BUILDDISTRO"
      distr=$(printf '%s' "$distr" | tr '[:lower:]' '[:upper:]')
      rel=$(printf '%s' "${rel:-$distr}" | tr '[:lower:]' '[:upper:]')
   else
      distr=$(lsb_release -i -s | tr '[:lower:]' '[:upper:]')
      rel=$(lsb_release -c -s | tr '[:lower:]' '[:upper:]')
   fi

   local recipe base rest version instance instancereq
   for recipe in "$@"; do
      # Recipe arguments may carry a forced version and/or instance suffix:
      #   recipe, recipe@version, recipe:instance, recipe@version:instance
      #   or recipe:instance@version (the @/: parts may appear in either order).
      base="${recipe%%[:@]*}"
      rest="${recipe#"$base"}"
      version=""
      instance=""
      if [[ "$rest" == *@* ]]; then
         version="${rest#*@}"
         version="${version%%:*}"
      fi
      if [[ "$rest" == *:* ]]; then
         instance="${rest#*:}"
         instance="${instance%%@*}"
      fi
      recipe="$base"

      if [[ ! -f "$RECIPEDIR/$recipe.recipe" ]]; then
         output "recipe $recipe does not exist."
         continue
      fi
      if recipe_select_arch "$recipe"; then
         if recipe_select_build "$recipe"; then
            instancereq=$(recipe_item_get "$recipe" INFO instance)
            if [[ -n "$instancereq" && -z "$instance" && -z "${B_INSTANCE:-}" ]]; then
               output "Recipe $recipe requires an instance, but none specified."
               continue
            fi
            work_recipes+=("$recipe")
            work_arch["$recipe"]="$B_ARCH"
            [[ -n "$version" ]]  && work_forcever["$recipe"]="$version"
            [[ -n "$instance" ]] && work_instance["$recipe"]="$instance"
         else
            output "$recipe has no build section for this system."
         fi
      else
         output "$recipe not for this architecture."
      fi
   done

   if (( all == 1 )); then
      local recipe
      for recipe in "$RECIPEDIR"/*.recipe; do
         recipe=$(basename -s .recipe "$recipe")
         local exclude
         exclude=$(recipe_item_get "$recipe" INFO excludefromall)
         if [[ "$exclude" != "1" ]]; then
            if recipe_select_arch "$recipe"; then
               if recipe_select_build "$recipe"; then
                  instancereq=$(recipe_item_get "$recipe" INFO instance)
                  if [[ -n "$instancereq" && -z "${B_INSTANCE:-}" ]]; then
                     output "Recipe $recipe requires an instance, skipping."
                     continue
                  fi
                  work_recipes+=("$recipe")
                  work_arch["$recipe"]="$B_ARCH"
               else
                  output "$recipe has no build section for this system."
               fi
            else
               output "$recipe not for this architecture or no build section."
            fi
         else
            output "$recipe excluded from building."
         fi
      done
   fi

   if (( ${#work_recipes[@]} == 0 )) && (( SHELL_MODE == 0 )) && [[ -z "$ATTACH_CONTAINER" ]]; then
      output "No recipe(s) specified."
      return 1
   fi
}

# --- Main function ---

main() {
   local i=0
   local retval=0
   declare -A work_arch
   declare -A work_forcever=()
   declare -A work_instance=()
   declare -a work_recipes=()
   declare -a work_version=()
   declare -a work_built=()
   declare -a work_build=()
   declare -a work_package=()
   declare -a work_packaged=()

   # Hidden helper: print the known target distributions and exit. Used by
   # bash completion (build-completion) as the single source of truth, so the
   # completion does not duplicate the distro list. Runs before sanity_check
   # to avoid requiring Docker or a valid build configuration.
   if [[ "${1:-}" == "--list-distros" ]]; then
      known_distros
      return 0
   fi

   sanity_check || return 1

   B_SARCH=$(arch_get)
   parse_options "$@" || return 1

   # Global -i instance (if any), captured before the build loops so a
   # per-recipe :instance can override it without leaking to the next recipe.
   local global_instance="${B_INSTANCE:-}"

   # Distribution segment for the output directory (e.g. debian-trixie).
   # See distro_dir() for the derivation rules. distro_dir() also sets the
   # platform-agnostic B_DISTRO codename as a side effect.
   distro_dir
   export B_DISTRO

   # Load per-distro apt/repository configuration (may override PROXY for this
   # distro and declare custom repositories). Must run after distro_dir sets
   # B_DISTRO/B_DISTRODIR and before PROXY is exported below.
   distro_repos_load "$B_DISTRO"

   [[ -n "$PROXY" ]] && { export http_proxy="$PROXY"; export https_proxy="$PROXY"; }

   # The host always builds with Docker. The native build path is retained only
   # for in-container use (the -S dev shell / /.dockerenv fallback), where no
   # Docker-in-Docker is available. Silently override any BUILDMODE=native set
   # in ~/.buildrc when running on the real host.
   if [[ ! -f /.dockerenv ]]; then
      BUILDMODE=docker
   fi

   # Docker-specific sanity checks (must be after parse_options for BUILDDISTRO)
   if [[ "$BUILDMODE" == "docker" ]]; then
      if ! command -v docker > /dev/null 2>&1 || ! docker info > /dev/null 2>&1; then
         # Inside a container (e.g., the -S dev shell) there is no Docker-in-Docker,
         # so fall back to the native build path on the container's system. This
         # branch is unreachable on the host (host has /.dockerenv absent and
         # BUILDMODE forced to docker above; missing docker there is an error).
         if [[ -f /.dockerenv ]]; then
            output "Running inside container, falling back to native build mode."
            BUILDMODE=native
         else
            ERR=1 output "Docker not found or not running. The host requires Docker to build."
            return 1
         fi
      fi
      # Only require a distro if we are still building in Docker (the in-container
      # fallback above may have switched us to native, which derives distro from
      # the container's own lsb_release instead).
      if [[ "$BUILDMODE" == "docker" ]]; then
         [[ -n "$BUILDDISTRO" ]] || { ERR=1 output "Docker builds require --distro (-d) to be specified (e.g., -d bookworm)."; return 1; }
      fi
   fi

   # In Docker mode, make sure the target image exists and is up to date with
   # the shipped entrypoint/Dockerfile before we start any build or package
   # work (no-op for check-only runs and for pulled-image distros).
   if [[ "$BUILDMODE" == "docker" ]] && (( DO_BUILD != 0 || DO_PACKAGE != 0 )); then
      _docker_autoprune
      docker_image_ensure "$BUILDDISTRO" || return 1
   fi

   # Handle --attach mode: re-attach to a running Docker container
   if [[ -n "$ATTACH_CONTAINER" ]]; then
      command -v docker > /dev/null 2>&1 || { ERR=1 output "Docker not found."; return 1; }
      docker_attach "$ATTACH_CONTAINER"
      return $?
   fi

   # Handle --shell mode: start interactive development shell in a Docker container
   if (( SHELL_MODE == 1 )); then
      command -v docker > /dev/null 2>&1 || { ERR=1 output "Docker not found."; return 1; }
      docker info > /dev/null 2>&1 || { ERR=1 output "Docker daemon not running or not accessible."; return 1; }
      [[ -n "$BUILDDISTRO" ]] || { ERR=1 output "--shell requires a distro name (e.g., -S bookworm)."; return 1; }
      docker_shell "$BUILDDISTRO"
      return $?
   fi

   if (( DO_CHECK != 0 )); then
      # Get current version and check if already built
      for i in "${!work_recipes[@]}"; do
         B_ARCH="${work_arch[${work_recipes[$i]}]}"
         local r="${work_recipes[$i]}"
         work_version[i]=$(check_version_built "$r" "${work_forcever[$r]:-}" "${work_instance[$r]:-$global_instance}")
         work_built[i]=$?
         if (( DO_CHECK == 1 || (DO_BUILD == 1 && B_FORCE == 0) )); then
            (( work_built[i] == 1 )) && output "${work_recipes[$i]} ${work_version[$i]} (already built)"
         fi
         if (( DO_CHECK == 1 || DO_PACKAGE != 0 )); then
            (( work_built[i] == 0 )) && output "${work_recipes[$i]} ${work_version[$i]} (not built)"
         fi
      done
   fi

   if (( DO_BUILD != 0 )); then
      # If not built or forced, then build
      lock_get || { printf '%s\n' "Unable to get lock, other instance running?"; return 1; }
      for i in "${!work_recipes[@]}"; do
         B_ARCH="${work_arch[${work_recipes[$i]}]}"
         B_INSTANCE="${work_instance[${work_recipes[$i]}]:-$global_instance}"
         if (( work_built[i] == 0 || B_FORCE == 1 )); then
            build "${work_recipes[$i]}" "${work_version[$i]}"
            if [[ $? -eq 1 ]]; then
               output -f "${work_recipes[$i]} ${work_version[$i]} (build failed)"
               # In quiet mode the live build output is suppressed, so surface a
               # short log excerpt to stderr so the failure reason (e.g. a failed
               # B_GET download) is visible instead of just "(build failed)".
               if (( QUIET == 1 )); then
                  printf '%s\n' "Log excerpt for failed build ${work_recipes[$i]} ${work_version[$i]}:" >&2
                  _log_excerpt "$LOGDIR/${work_recipes[$i]}-${work_arch[${work_recipes[$i]}]}.log"
               fi
               work_build[i]=0
               retval=1
            else
               work_build[i]=1
               output -f "${work_recipes[$i]} ${work_version[$i]} (build succeeded)"

               # In Docker mode, build+package was combined. Read result file.
               if [[ "$BUILDMODE" == "docker" ]] && (( DO_PACKAGE != 0 )); then
                  local result_file="$LOGDIR/.package-result-${work_recipes[$i]}.txt"
                  if [[ -f "$result_file" ]]; then
                     work_package[i]=$(cat "$result_file")
                     work_packaged[i]=0
                     rm -f "$result_file"
                     output "${work_recipes[$i]} ${work_version[$i]} (package created)"
                  fi
               fi
            fi
         fi
      done
      lock_free
   fi

   if (( DO_PACKAGE != 0 )); then
      # if no build action and version built, package. if build action successful, build.
      for i in "${!work_recipes[@]}"; do
         B_ARCH="${work_arch[${work_recipes[$i]}]}"
         B_INSTANCE="${work_instance[${work_recipes[$i]}]:-$global_instance}"

         # Skip if already packaged (e.g., in Docker combined build+package)
         [[ "${work_packaged[$i]:-1}" == "0" ]] && continue

         local b=0
         (( DO_BUILD == 0 && work_built[i] == 1 )) && b=1
         [[ "${work_build[$i]:-0}" == "1" ]] && b=1
         if (( b == 1 )); then
            if [[ "$BUILDMODE" == "docker" ]]; then
               # Package inside Docker container (package-only mode)
               B_NAME="${work_recipes[$i]}"
               B_VERSION="${work_version[$i]}"
               if [[ -n "${B_INSTANCE:-}" ]]; then
                  ID="${B_NAME}_${B_VERSION}-${B_INSTANCE}_${B_ARCH}"
               else
                  ID="${B_NAME}_${B_VERSION}_${B_ARCH}"
               fi
               B_BUILDNR=$(package_buildnr_get "$ID")

               # Compute B_INSTALLDIR (normally set in build(), but we skipped it)
               if [[ -n "$DESTSPLIT" ]]; then
                  B_INSTALLDIR="$DESTDIR/$B_DISTRODIR/$B_ARCH/$B_NAME/$B_VERSION"
               else
                  B_INSTALLDIR="$DESTDIR/$B_DISTRODIR/$B_ARCH/$B_NAME-$B_VERSION"
               fi
               B_CACHEDIR="$CACHEDIR"
               B_FILES=""
               B_FORCE=0

               local image
               image=$(docker_image_select "$BUILDDISTRO")

               local envfile
               envfile=$(mktemp -p "$TMPDIR" build-env-"${B_NAME}"-XXXXXX.sh)
               docker_prepare_env "$envfile"

               local pkgcmdfile
               pkgcmdfile=$(mktemp -p "$TMPDIR" pkg-cmd-"${B_NAME}"-XXXXXX.sh)
               docker_prepare_package_cmd "$pkgcmdfile" "$B_NAME" "$B_VERSION"

               docker_run_package "$image" "$envfile" "$pkgcmdfile"
               local pkg_result=$?

               rm -f "$envfile" "$pkgcmdfile"

               if (( pkg_result == 0 )); then
                  local result_file="$LOGDIR/.package-result-${work_recipes[$i]}.txt"
                  if [[ -f "$result_file" ]]; then
                     work_package[i]=$(cat "$result_file")
                     work_packaged[i]=0
                     rm -f "$result_file"
                     output "${work_recipes[$i]} ${work_version[$i]} (package created)"
                  else
                     # Container exited 0 but no result file — packaging may have failed silently
                     work_packaged[i]=1
                     output -f "${work_recipes[$i]} ${work_version[$i]} (package create failed)"
                     retval=1
                  fi
               else
                  work_packaged[i]=1
                  output -f "${work_recipes[$i]} ${work_version[$i]} (package create failed)"
                  if (( QUIET == 1 )); then
                     printf '%s\n' "Log excerpt for failed packaging ${work_recipes[$i]} ${work_version[$i]}:" >&2
                     _log_excerpt "$LOGDIR/${work_recipes[$i]}-${work_arch[${work_recipes[$i]}]}.log"
                  fi
                  retval=1
               fi
            else
               work_package[i]=$(package "${work_recipes[$i]}" "${work_version[$i]}")
               work_packaged[i]=$?
               if (( work_packaged[i] == 0 )); then
                  output "${work_recipes[$i]} ${work_version[$i]} (package created)"
               else
                  output -f "${work_recipes[$i]} ${work_version[$i]} (package create failed)"
                  if (( QUIET == 1 )); then
                     printf '%s\n' "Log excerpt for failed packaging ${work_recipes[$i]} ${work_version[$i]}:" >&2
                     _log_excerpt "$LOGDIR/${work_recipes[$i]}-${work_arch[${work_recipes[$i]}]}.log"
                  fi
                  retval=1
               fi
            fi
         else
            work_package[i]=1
         fi
      done
   fi

   if (( DO_REPO != 0 )); then
      lock_get || { printf '%s\n' "Unable to get lock, other instance running?"; return 1; }
      local -a pkgs=()
      for i in "${!work_recipes[@]}"; do
         [[ "${work_packaged[$i]:-1}" == "0" ]] && pkgs+=("${work_package[$i]}")
      done
      B_ARCH="${work_arch[${work_recipes[$i]:-0}]}"
      if (( ${#pkgs[@]} != 0 )); then
         if package_torepo "${pkgs[@]}"; then
            output "packages pushed to repo"
         else
            output -f "packages not pushed to repo"
            retval=1
         fi
      fi
      lock_free
   fi

   sendmail

   return "$retval"
}

main "$@"
