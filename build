set -u

# Global variables and constants
LOCK="/tmp/build.lck"
QUIET=0
VERBOSE=0
_BUILD_TMP=""

# Default configuration (overridden by ~/.buildrc). ${VAR:-default} so that
# values exported into the container by the host (BUILD_ENV_VARS) survive for
# nested 'build' invocations (meta recipes): inside the container ~/.buildrc is
# deliberately absent, and the exported values are the ones that match the
# host's bind-mounted paths (LOGDIR, PKGDIR, PKGLIST, TMPDIR, ...). On the
# host these environment variables are unset, so the defaults apply and
# ~/.buildrc still wins where it is sourced.
DESTDIR="${DESTDIR:-$HOME/build}"
DESTSPLIT="${DESTSPLIT:-}"
CACHEDIR="${CACHEDIR:-$HOME/cache}"
TMPDIR="${TMPDIR:-$HOME/temp}"
RECIPEDIR="${RECIPEDIR:-$HOME/recipes}"
PKGLIST="${PKGLIST:-$RECIPEDIR/pkglist}"
PKGDIR="${PKGDIR:-$HOME/packages}"
LOGDIR="${LOGDIR:-$HOME/log}"
INSTDEP="${INSTDEP:-yes}"
DEINSTDEP="${DEINSTDEP:-yes}"
TODEBREPO="${TODEBREPO:-}"
PKGPOSTFIX="${PKGPOSTFIX:-}"
PKGMAIL="${PKGMAIL:-}"
PKGORG="${PKGORG:-}"
PROXY="${PROXY:-}"
# Real build host name (captured on the host, passed to containers so
# provenance records the actual build server, not the container hostname).
BUILD_HOST="$(hostname 2>/dev/null)"
# Source-integrity strict mode (SECURITY.md group A). When 1, git-based
# recipes must declare a gpgkey and plain-http fetches are refused even with
# allow_insecure.
STRICT=0

# Vulnerability scanning default (SECURITY.md group F4). Global default for
# the [SECURITY] vulnscan= recipe key: advisory (warn but continue) or enforce
# (fail on findings at or above VULNSCAN_SEVERITY). Empty = no scan unless a
# recipe sets its own vulnscan= key. A recipe's [SECURITY] vulnscan= overrides
# this.
VULNSCAN="${VULNSCAN:-}"

# Severity level at which vulnscan=enforce fails (SECURITY.md group F4).
# GitHub/OSV severity scale: LOW < MODERATE < HIGH < CRITICAL. Default HIGH
# (enforce fails on HIGH and CRITICAL; LOW/MODERATE always pass). Set to
# CRITICAL to fail on CRITICAL only, or MODERATE/MEDIUM/LOW to be stricter.
VULNSCAN_SEVERITY="${VULNSCAN_SEVERITY:-HIGH}"

# Static build-script guard default (SECURITY.md group F6). Global default for
# the [SECURITY] srcguard= recipe key: advisory (warn but continue) or enforce
# (fail on any suspicious build-script pattern). Empty = no scan unless a
# recipe sets its own srcguard= key. A recipe's [SECURITY] srcguard= overrides
# this. Heuristic; may produce false positives, so advisory is recommended.
SRCGUARD="${SRCGUARD:-}"

# Per-distro apt/repository configuration.
# Builds must not inherit apt config (repositories, proxies, keys, credentials)
# from the host OS. Instead, each target distro's apt configuration is declared
# in a file under BUILD_REPOS_DIR named after the distro (codename, or
# family-codename). If no file exists for a distro, the standard Debian default
# repositories are used. See BUILD.md "APT / REPOSITORIES".
BUILD_REPOS_DIR="${BUILD_REPOS_DIR:-$HOME/.build-repos.d}"
# State populated by load_distro_repos() and consumed by
# docker_add_apt_config(). REPO_ORDER lists repo ids in declaration order; the
# REPO_* associative arrays hold per-repo fields.
NO_DEFAULT_REPOS=0
DEFAULT_REPOS=""
declare -A REPO_URL=() REPO_SUITE=() REPO_COMPONENTS=() REPO_PROXY=()
declare -A REPO_AUTH=() REPO_AUTHFILE=() REPO_KEY=() REPO_ARCH=() REPO_SIGNEDBY=()
declare -a REPO_ORDER=()
# Path to the generated apt-config mount directory (set by docker_add_apt_config).
_BUILD_APT_DIR=""

# Docker build configuration.
# On the host, builds always run inside Docker. The native build path is
# retained only for in-container use (the -S dev shell), where there is no
# Docker-in-Docker available. main() forces BUILDMODE=docker on the host.
: "${BUILDMODE:=docker}"
BUILDDISTRO="${BUILDDISTRO:-}"
DOCKER_DIR="${DOCKER_DIR:-}"
DOCKER_IMAGE_PREFIX="${DOCKER_IMAGE_PREFIX:-}"
BUILD_DEPS="${BUILD_DEPS:-}"
SHELL_MODE=0
ATTACH_CONTAINER=""
# Host directory bind-mounted over the container's /tmp during builds, so
# large source extractions land on a volume with free space instead of the
# container's (potentially small) writable layer. Empty = use the container's
# own /tmp (default behaviour). Must be 777; each build gets its own
# subdirectory under it. See BUILD.md "DOCKER / STORAGE".
BUILDDOCKERTMP="${BUILDDOCKERTMP:-}"
# Automatic Docker cleanup before each build session. "yes"/"on"/1 prunes
# dangling images and build cache (leftovers from interrupted/failed builds;
# keeps base images). "full"/"all" also removes unused images (aggressive:
# base images get rebuilt on the next build). Empty/"no"/0 = off.
# Defaults to "yes" so the script self-cleans without ~/.buildrc config; set
# DOCKERAUTOPRUNE=off in ~/.buildrc to disable.
DOCKERAUTOPRUNE="${DOCKERAUTOPRUNE:-yes}"
# Number of versioned download versions to keep per package in CACHEDIR after a
# build session. Versioned B_GET http/sf downloads accumulate one file per
# version (e.g. freecad-1.0.2, freecad-1.1.0, ...); this prunes the oldest so
# the cache does not grow without bound. Single-file caches (git/go/hg/svn
# tarballs, which are the efficiency cache that avoids re-cloning) are never
# touched. Set to 0 or empty to disable pruning.
MAXCACHEKEEP="${MAXCACHEKEEP:-3}"
# Number of built versions to keep per package in DESTDIR after a build session.
# Build output accumulates one directory per version (e.g. act_runner/2.0.1,
# act_runner/2.1.0, ...); this prunes the oldest so the build output does not
# grow without bound. Set to 0 or empty to disable pruning.
MAXBUILDKEEP="${MAXBUILDKEEP:-1}"
# Build-time cutoff (seconds) for keeping build output after packaging. Builds
# that take at least this long keep their full output in DESTDIR (so a
# packaging-only recipe change can be re-packaged without a full rebuild);
# faster builds have their output replaced with an empty marker directory (the
# version is still recorded as built, but a rebuild is cheap). Set to 0 or
# empty to keep all build output (default behaviour).
BUILDKEEPTIME="${BUILDKEEPTIME:-0}"
# Distribution segment for the output directory (e.g. "debian-trixie").
# Computed in main() from BUILDDISTRO (docker mode) or lsb_release (native).
B_DISTRODIR=""
# Target distribution codename (e.g. "trixie", "bookworm"). Platform-agnostic
# identifier of the distro being built for; exported so the TODEBREPO command
# (and other publish hooks) know which repository to add a package to.
# Computed in main() alongside B_DISTRODIR by distro_dir().
B_DISTRO=""

# Out-parameter of docker_package_only(): on success (return 0) it holds the
# package filename the container wrote; empty otherwise. Read by main()'s
# package-only Docker branch.
DOCKER_PKG_FILE=""

# Initialize option variables (set by parse_options)
B_FORCE=0
DEBUG=""
DEBUGSHELL=""
B_INSTANCE=""
B_NOPKGRM=0
DO_CHECK=0
DO_BUILD=0
DO_PACKAGE=0
DO_REPO=0
email=""

# Source configuration. On the host .buildrc is mandatory. Inside a build
# container it is deliberately NOT mounted: the host exports the configuration
# into the container (BUILD_ENV_VARS), and a nested 'build' invocation (meta
# recipes that build other recipes) must not re-resolve .buildrc's
# HOSTNAME-based paths (LOGDIR, PKGDIR, PKGLIST) against the container's own
# hostname (build-<recipe>) -- those paths are bind-mounted at their host
# values.
if [[ -f "$HOME/.buildrc" ]]; then
   # shellcheck source=~/.buildrc
   source "$HOME/.buildrc"
elif [[ ! -f /.dockerenv ]]; then
   printf '%s\n' "No configuration file found."
   exit 1
fi

# OS detection
[[ -f /etc/os-release ]] || { printf '%s\n' "Unable to determine os, no /etc/os-release."; exit 1; }
source /etc/os-release
OS="$NAME"

# Trap for temp dir cleanup
trap '[[ -n "${_BUILD_TMP:-}" ]] && rm -rf "$_BUILD_TMP" 2>/dev/null' EXIT

# --- Utility functions ---

# Output a message respecting quiet level.
# Use ERR=1 prefix to output to stderr.
# Use -f flag to force output at quiet level 1.
output() {
   local force=0 verbose=0
   [[ "${1:-}" == "-f" ]] && { force=1; shift; }
   [[ "${1:-}" == "-v" ]] && { verbose=1; shift; }
   (( QUIET == 2 )) && return
   (( force == 0 && QUIET == 1 )) && return
   (( VERBOSE == 0 && verbose == 1 )) && return
   [[ -n "${ERR:-}" ]] && (>&2 printf '%s\n' "$1") || printf '%s\n' "$1"
}

# Print a short head/tail excerpt of a build log. Used to surface the failure
# reason in quiet mode (QUIET == 1): there the live Docker log stream is
# discarded (docker logs -f > /dev/null) and the native build pipeline is
# teed to /dev/null, so the generic "(build failed)" line otherwise hides WHY
# it failed -- e.g. a refused/insecure B_GET URL, a failed download, or a
# sha256 mismatch. Mirrors the excerpt format used by the email summary
# (head 5 / tail 5 with a "Skip middle..." marker).
# Parameters: log_file [fd]  (fd defaults to 2/stderr; use 1 for the mail body)
_log_excerpt() {
   local log="$1" fd="${2:-2}"
   [[ -e "$log" ]] || return 0
   if (( $(wc -l < "$log") > 10 )); then
      { head -5 "$log"; printf '%s\n' "Skip middle..."; tail -5 "$log"; } | sed 's/^/  /' >&"$fd"
   else
      sed 's/^/  /' "$log" >&"$fd"
   fi
}

# In quiet mode, surface a short log excerpt to stderr for a failed run.
# Parameters: label recipe version arch
_fail_excerpt() {
   (( QUIET == 1 )) || return 0
   printf '%s\n' "$1 $2 $3:" >&2
   _log_excerpt "$LOGDIR/${2}-${4}.log"
}

# Download $url to $target over HTTPS-only wget (unless allow_insecure), under
# a per-file flock so concurrent builds don't corrupt the cache entry.
# Parameters: target url
_b_wget_fetch() {
   local target="$1" url="$2"
   local -a wopts=(-O "$target" --secure-protocol=TLSv1_2)
   [[ "${B_ALLOW_INSECURE:-0}" != "1" ]] && wopts+=(--https-only)
   flock -w 60 "$target" wget "${wopts[@]}" "$url" || { rm -f "$target"; ERR=1 output -f "Error downloading file."; return 1; }
}

# Verify the SHA-256 of a cached asset (A3) when B_SHA256 is set, then copy it
# into the build tree under $fn. Parameters: target fn
_b_verify_copy() {
   local target="$1" fn="$2"
   if [[ -n "${B_SHA256:-}" ]]; then
      local digest
      digest=$(sha256sum "$target" | cut -d' ' -f1) || { ERR=1 output -f "B_GET: cannot checksum $target"; return 1; }
      if [[ "$digest" != "$B_SHA256" ]]; then
         ERR=1 output -f "B_GET: sha256 mismatch for $fn (got ${digest}, want ${B_SHA256})"
         return 1
      fi
      output "B_GET: sha256 verified for $fn"
   fi
   flock -w 60 "$target" cp "$target" "$fn"
}

# Store a directory tree into a cached tarball atomically: write to a
# temporary '.new' name first and only replace the cache entry when tar
# succeeded, so an interrupted tar cannot leave a corrupt archive behind
# (original build script behaviour, see commit 5566fe3).
# Parameters: archive_path directory_to_store
_cache_store() {
   local archive="$1" dir="$2"
   if ! flock -w 60 "$archive" tar cfz "$archive.new" "$dir"; then
      printf '%s\n' "Unable to store in cache."
      rm -f "$archive.new"
      return 1
   fi
   mv -f "$archive.new" "$archive"
}

# Refresh a shallow git clone in the build tree so it is ready to build from.
# Moves to the default branch and shallow-fetches its tip (so date-based recipes
# that build the default-branch head get the latest code), then shallow-fetches
# the current version tag (with and without a leading 'v') so tag-based recipes
# can `git checkout v$B_VERSION`. Used by the B_GET git method to keep the cache
# small (only the needed history, not the full clone). Never fatal. Parameters:
# repo_dir
_b_git_refresh() {
   local repo="$1" branch
   (cd "$repo" || exit 1
      branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
      if [[ -z "$branch" ]]; then
         branch=$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed 's#origin/##')
         [[ "$branch" == "HEAD" ]] && branch=""
      fi
      if [[ -n "$branch" ]]; then
         git checkout -f "$branch" > /dev/null 2>&1
         git fetch --depth 1 origin > /dev/null 2>&1 || true
         git reset --hard "origin/$branch" > /dev/null 2>&1 || true
      fi
      if [[ -n "${B_VERSION:-}" ]]; then
         git fetch --depth 1 origin tag "v$B_VERSION" > /dev/null 2>&1 || true
         git fetch --depth 1 origin tag "$B_VERSION" > /dev/null 2>&1 || true
      fi
      # A recipe may name its version tag differently from v$B_VERSION/$B_VERSION
      # (e.g. termix uses release-$B_VERSION-tag). The [INFO] gittag= key lets it
      # specify the exact tag to shallow-fetch. The value may reference $B_VERSION
      # (and other exported build vars); eval is safe here because the recipe is
      # trusted input (its BUILD section already runs arbitrary shell).
      if [[ -n "${B_GITTAG:-}" ]]; then
         local tag
         tag=$(eval "printf '%s' \"$B_GITTAG\"")
         git fetch --depth 1 origin tag "$tag" > /dev/null 2>&1 || true
      fi
   )
}

# Compose the package identity string used in PKGLIST and build-number lookups.
# Uses B_NAME, B_VERSION, B_INSTANCE, B_ARCH from the environment.
_b_pkg_id() {
   if [[ -n "${B_INSTANCE:-}" ]]; then
      printf '%s' "${B_NAME}_${B_VERSION}-${B_INSTANCE}_${B_ARCH}"
   else
      printf '%s' "${B_NAME}_${B_VERSION}_${B_ARCH}"
   fi
}

# Compute the build output directory for a recipe version (with optional
# instance suffix), honouring DESTSPLIT. Prints the path (no trailing newline).
# Parameters: name version [instance]
_b_installdir() {
   local name="$1" version="$2" inst="${3:-}"
   local versiondir="$version"
   [[ -n "$inst" ]] && versiondir="$version-$inst"
   if [[ -n "$DESTSPLIT" ]]; then
      printf '%s' "$DESTDIR/$B_DISTRODIR/$B_ARCH/$name/$versiondir"
   else
      printf '%s' "$DESTDIR/$B_DISTRODIR/$B_ARCH/$name-$versiondir"
   fi
}

# Ensure the expected GPG key (B_GPGKEY) is in the keyring, for B_GITCHECKOUT's
# tag-signature verification (SECURITY.md group A1). A local key file
# (B_GPGKEYFILE) is preferred over keyserver fetch so verification works in
# network-restricted build environments. Uses B_GPGKEY/B_GPGKEYFILE/B_FILES.
# Returns 0 if the key is available, 1 on failure (with a message).
_b_gpg_ensure_key() {
   command -v gpg > /dev/null 2>&1 || { output "B_GITCHECKOUT: gpg not available but gpgkey is set"; return 1; }
   gpg --list-keys "$B_GPGKEY" > /dev/null 2>&1 && return 0
   if [[ -n "${B_GPGKEYFILE:-}" ]]; then
      local keyfile="$B_GPGKEYFILE"
      if [[ "$keyfile" != /* ]] && [[ -n "${B_FILES:-}" ]]; then
         keyfile="$B_FILES/$keyfile"
      fi
      if [[ -f "$keyfile" ]]; then
         gpg --import "$keyfile" 2>/dev/null || { output "B_GITCHECKOUT: could not import gpg key file ${B_GPGKEYFILE}"; return 1; }
      else
         output "B_GITCHECKOUT: gpgkeyfile not found: ${B_GPGKEYFILE}"; return 1
      fi
   else
      # Try several keyservers; keys.openpgp.org returns some keys without
      # user IDs (which gpg skips), so ubuntu/pgpkeys are used as fallbacks.
      local ks
      for ks in hkps://keys.openpgp.org hkps://keyserver.ubuntu.com hkps://pgpkeys.eu; do
         gpg --keyserver "$ks" --recv-keys "$B_GPGKEY" 2>/dev/null
         gpg --list-keys "$B_GPGKEY" > /dev/null 2>&1 && break
      done
   fi
   gpg --list-keys "$B_GPGKEY" > /dev/null 2>&1 || { output "B_GITCHECKOUT: could not fetch gpg key ${B_GPGKEY}"; return 1; }
   return 0
}

# Exported so they are available to B_GET / B_GITCHECKOUT in child shells
# (native build path) and serialized into the Docker env script.
export -f _b_wget_fetch _b_verify_copy _b_pkg_id _b_gpg_ensure_key _b_git_refresh
# output is used by the exported functions above and by B_VULNSCAN/B_SRCGUARD
# (appended to the native build command); without it those fail with
# "output: command not found" in the bash -c build subprocess.
export -f output

# Email a build-completion summary to the address given with -m.
# Uses the work_* arrays populated by main(). Includes a per-recipe summary
# (build/package ok/fail with percentages) and, only for recipes that were
# actually built and failed, log excerpts (head 5 / tail 5). The target
# distribution is included in the subject. No-op when no -m was given.
# (Not named sendmail: that would shadow the sendmail MTA binary.)
_send_summary() {
   [[ -z "$email" ]] && return
   if ! command -v mail > /dev/null 2>&1; then
      output "mail command not found, cannot send summary to $email"
      return
   fi

   local i pkg log
   local buildtotal=0 built=0 pkgtotal=0 packaged=0
   local summaryok="" summaryfail=""
   local buildsubject="" pkgsubject="" subject
   # Canonical lowercased distro codename (set by distro_dir()); avoids
   # re-deriving/re-lowercasing BUILDDISTRO or distr here.
   local distro_label="${B_DISTRO:-}"

   for i in "${!work_recipes[@]}"; do
      pkg="${work_recipes[$i]} ${work_version[$i]}:"
      if [[ -n "${work_build[$i]:-}" ]]; then
         buildtotal=$(( buildtotal + 1 ))
         if (( work_build[i] == 1 )); then
            built=$(( built + 1 ))
            summaryok+="${pkg} build ok"
            if [[ -n "${work_packaged[$i]:-}" ]]; then
               pkgtotal=$(( pkgtotal + 1 ))
               if (( work_packaged[i] == 0 )); then
                  packaged=$(( packaged + 1 ))
                  summaryok+=", package ok"
               else
                  summaryok+=", package fail"
               fi
            fi
            summaryok+=$'\n'
         else
            summaryfail+="${pkg} build fail"$'\n'
         fi
      fi
   done

   # Nothing was built or packaged; don't send an empty mail.
   (( buildtotal == 0 && pkgtotal == 0 )) && return

   local buildperc=0 pkgperc=0
   (( buildtotal > 0 )) && { buildperc=$(( built * 100 / buildtotal )); buildsubject="${buildperc}% built"; }
   (( pkgtotal > 0 ))   && { pkgperc=$(( packaged * 100 / pkgtotal )); pkgsubject="${pkgperc}% packaged"; }
   [[ -n "$buildsubject" || -n "$pkgsubject" ]] && subject="$buildsubject, $pkgsubject"

   {
      [[ -n "${BUILD_DURATION:-}" ]] && printf '%s\n' "Build duration: $BUILD_DURATION"
      printf '%s\n' "Summary:"
      [[ -n "$summaryok" ]]   && printf '%s' "$summaryok"
      [[ -n "$summaryfail" ]] && printf '%s' "$summaryfail"
      printf '\n'
      if (( built < buildtotal )); then
         printf '%s\n' "Log excerpt for failed builds:"
         for i in "${!work_recipes[@]}"; do
            # Only include recipes that were actually built and failed; skip
            # ones that were already built (work_build unset) or succeeded.
            [[ "${work_build[$i]:-}" != "0" ]] && continue
            printf '%s\n' "${work_recipes[$i]} ${work_version[$i]}:"
            log="$LOGDIR/${work_recipes[$i]}-${work_arch[${work_recipes[$i]}]}.log"
            _log_excerpt "$log" 1
            printf '\n'
         done
      fi
   } | mail -r "$HOSTNAME" -s "build completed${distro_label:+ $distro_label} (${subject%%, })" "$email"
}

usage() {
   cat <<-EOF
	Usage: build [OPTION]... [RECIPE]...

	Operation mode:
	   -c  Check version, runs the version check section of the specified recipe(s).
	   -b  Build, runs the build version of the specified recipe(s).
	   -p  Package, runs the package section of the specified recipe(s).
	   -r  To repository, creates packages and copies to repository for specified recipe(s)

	Operation modifiers:
	   -a  Select all recipes available.
	   -l  Dryrun: only report which recipes would be built, packaged and/or
	       pushed to the repository, without executing any of it.
	   -q  Quiet output
	   -v  Verbose output: show command output that is normally suppressed
	   -x  Enable debugging output
	   -s  Drop to a shell when building process fails to inspect.
	   -f  Force build for recipe, even if complete build is already available.
	   -d  Specify target distribution for Docker (required on the host, e.g., -d trixie, -d bookworm)
	   -i  Specify an instance for a recipe
	   -R  Don't remove required packages after building and skip any post build script.
	   -m  Mail a completion summary to the given email address.
	   -h  This help message

	Docker interactive commands:
	   -S  Shell, start interactive development shell in a Docker container for the
	       specified distro (e.g., -S bookworm, -S trixie).
	   -A  Attach, re-attach to a running Docker container by container ID.

	A recipe name may be suffixed with a forced version and/or instance:
	   recipe@version            build a specific version (skips version check)
	   recipe:instance           build for a specific instance
	   recipe@version:instance    both, in either order (recipe:instance@version)
	Several recipes can be built at different versions/instances in one command.

	EOF
   return 1
}

# Run sanity checks before starting build operations.
sanity_check() {
   local missing=""
   local name

   # In Docker mode, skip host-side tool checks (tools are in the container).
   # Native builds only run in Debian-based containers (the -S dev shell), so
   # the requirement list is Debian-only.
   if [[ "$BUILDMODE" != "docker" ]]; then
      for name in gawk grep git svn wget fakeroot bzip2 hg lsb_release jq xml2; do
         if ! command -v "$name" > /dev/null 2>&1; then
            missing="$missing $name"
         fi
      done
      [[ -n "$missing" ]] && { output "Missing required software to run script:$missing"; return 1; }
   fi
   [[ -z "$PKGDIR" ]] && { ERR=1 output "PKGDIR not defined"; return 1; }
   [[ -d "$PKGDIR" ]] || { ERR=1 output "PKGDIR $PKGDIR does not exist, creating."; mkdir -p "$PKGDIR"; }
   [[ -d "$LOGDIR" ]] || { ERR=1 output "LOGDIR $LOGDIR does not exist, creating."; mkdir -p "$LOGDIR"; }
   [[ -d "$TMPDIR" ]] || { ERR=1 output "TMPDIR $TMPDIR does not exist, creating."; mkdir -p "$TMPDIR"; }
}

# Determine architecture string for the current system.
arch_get() {
   local arch
   arch=$(uname -m)
   case "$arch" in
   "i686")
      printf '%s\n' "i386"
      ;;
   "x86_64")
      printf '%s\n' "amd64"
      ;;
   *)
      printf '%s\n' "$arch"
      ;;
   esac
}

# Build lock: fd 9 is opened on $LOCK for the lifetime of the script; a build
# session holds an exclusive flock on it. flock is atomic (no test-then-write
# race), is released automatically on process exit (no stale locks from killed
# runs), and lock_free can never remove another process's lock.
exec 9>"$LOCK"

# Try to acquire the build lock (non-blocking). Nested builds (B_METABUILD)
# never lock.
lock_get() {
   [[ -n "${B_METABUILD:-}" ]] && return 0
   flock -n 9
}

# Release the build lock.
lock_free() {
   [[ -n "${B_METABUILD:-}" ]] && return 0
   flock -u 9
}

# --- Domain functions ---

# Get a specific item from a recipe section.
# Parameters: recipe label item [default]
# Returns 0 if value is empty, 1 if value was found.
# Repeated keys are supported: all matching lines are joined with commas
# (e.g. multiple vulnscan-ignore= lines in a [SECURITY] section).
recipe_item_get() {
   local recipe="$RECIPEDIR/$1.recipe"
   local label="$2"
   local item="$3"
   local value
   value=$(recipe_section_get "$1" "$label" optional | grep "^${item}=" | sed 's/^[^=]*=//' | paste -sd, -)
   if [[ -z "$value" ]] && (( $# == 4 )); then
      printf '%s\n' "$4"
   else
      printf '%s\n' "$value"
   fi
   [[ -z "$value" ]] && return 0 || return 1
}

# Get the content of a section from a recipe file.
# Parameters: [-q] recipe label [optional]
#   -q      quiet mode, suppress error messages
#   optional if set, return success when section not found
recipe_section_get() {
   local quiet=0
   [[ "$1" == "-q" ]] && { quiet=1; shift; }
   local recipename="$1"
   local recipe="$RECIPEDIR/$recipename.recipe"
   local label="$2"
   local opt="${3:-}"

   if [[ ! -f "$recipe" ]]; then
      if [[ -z "$opt" ]]; then
         (( quiet == 0 )) && \
            >&2 output "Recipe $recipename ($recipe) does not exist."
         return 1
      else
         return 0
      fi
   fi

   # Single pass: locate the section, print its non-comment body, and report
   # 2 = section absent, 1 = section present but empty, 0 = content printed.
   # (Replaces a separate grep existence check + awk + `grep -v ^#` pipeline.)
   awk "BEGIN {found=0; seen=0; printed=0}
        /^\[/ {found=0}
        /^\[$label\]/ {found=1; seen=1; next}
        { if (found==1 && \$0 !~ /^#/) {print; printed++} }
        END { if (!seen) exit 2; exit (printed>0 ? 0 : 1) }" "$recipe"
   local rc=$?
   if (( rc == 2 )); then
      if [[ -z "$opt" ]]; then
         (( quiet == 0 )) && \
            >&2 output "No section $label found in recipe $recipe"
         return 1
      else
         return 0
      fi
   fi
   return $rc
}

# Fetch a recipe section, trying "$base $distr $rel", "$base $distr", then the
# bare "$base" (uses the global distr/rel set by parse_options).
# With -q, a missing section is silent and the function returns 1 only if no
# section exists (BUILD selection). Without -q, sections are optional and the
# first found content (possibly empty) is printed (REQUIRED deps).
# Parameters: [-q] recipe base_label
recipe_section_lookup() {
   local quiet=0
   [[ "${1:-}" == "-q" ]] && { quiet=1; shift; }
   local recipe="$1" base="$2"
   if (( quiet == 1 )); then
      recipe_section_get -q "$recipe" "$base $distr $rel" ||
      recipe_section_get -q "$recipe" "$base $distr" ||
      recipe_section_get -q "$recipe" "$base"
   else
      local content
      content=$(recipe_section_get "$recipe" "$base $distr $rel" opt)
      [[ -z "$content" ]] && content=$(recipe_section_get "$recipe" "$base $distr" opt)
      [[ -z "$content" ]] && content=$(recipe_section_get "$recipe" "$base" opt)
      printf '%s' "$content"
   fi
}

# Run a sudo package command, surfacing errors always and full output when
# VERBOSE=1. Used by the native build dependency path (the -S dev shell).
# Parameters: command [args...]
_sudo_pkg() {
   local logf
   logf=$(mktemp) || { "$@"; return $?; }
   local rc
   # Silence debconf warnings (e.g. "unable to initialize frontend: Dialog")
   # during non-interactive package installs. The redirect intentionally
   # captures sudo's own stdout/stderr; sudo is not meant to affect it.
   # shellcheck disable=SC2024
   if [[ "${VERBOSE:-0}" == "1" ]]; then
      sudo DEBIAN_FRONTEND=noninteractive "$@" 2>&1 | tee "$logf"
      rc=${PIPESTATUS[0]}
   else
      sudo DEBIAN_FRONTEND=noninteractive "$@" > "$logf" 2>&1
      rc=$?
      if (( rc != 0 )); then
         output -f "Command failed (exit $rc): sudo $*"
         cat "$logf" >&2
      fi
   fi
   rm -f "$logf"
   return "$rc"
}

# Install required build dependencies.
# Parameters: space-separated list of package names
# In Docker mode, packages are installed inside the container by the entrypoint.
# The package list is stored in BUILD_DEPS for the entrypoint to process.
build_require() {
   local pkgs="$*"
   local missing=0
   local -a toinst=()
   local -a toinsttr=()
   local pkg

   # In Docker mode, collect dependencies for the container entrypoint
   if [[ "$BUILDMODE" == "docker" ]]; then
      [[ -n "$pkgs" ]] && BUILD_DEPS="${BUILD_DEPS:-} $pkgs"
      return 0
   fi

   for pkg in $pkgs; do
      local query_result
      query_result=$(dpkg-query -s "${pkg/*@/}" 2>&1)
      local query_status=$?
      if (( query_status != 0 )) || [[ "$query_result" == *"not-installed"* ]]; then
         output "Package $pkg required for build, but not installed."
         if [[ "$INSTDEP" == "yes" ]]; then
            [[ "$pkg" == "${pkg/*@/}" ]] && \
               toinst+=("$pkg") || \
               toinsttr+=("$pkg")
         else
            missing=1
         fi
      fi
   done

   if (( ${#toinst[@]} != 0 )); then
      _sudo_pkg apt-get update || { output -f "apt-get update failed."; return 1; }
      _sudo_pkg apt-get -qq -y install "${toinst[@]}" || \
         { output -f "Error installing dependencies (${toinst[*]})."; return 1; }
   fi

   if (( ${#toinsttr[@]} != 0 )); then
      for pkg in "${toinsttr[@]}"; do
         _sudo_pkg apt-get -qq -y -t "${pkg/@*/}" install "${pkg/@*/}" || \
            { output -f "Error installing dependency ($pkg)."; return 1; }
      done
   fi

   (( missing == 1 )) && return 1
   return 0
}

# Remove previously installed build dependencies.
# Parameters: space-separated list of package names
build_require_remove() {
   local pkgs="$1"
   local pkg
   local -a list=()
   for pkg in $pkgs; do
      list+=("${pkg/*@/}")
   done
   _sudo_pkg apt-get -qq -y --purge remove "${list[@]}"
}

# Build a recipe: install dependencies, set up environment, run build commands.
# Parameters: recipe_name version
build() {
   B_NAME="$1"
   B_VERSION="$2"
   # Start of this recipe's build wall-clock time, used by BUILDKEEPTIME to
   # decide whether to keep the build output for re-packaging.
   B_BUILDTIME=0
   local build_start=$SECONDS
   # Find recipe required section if available
   local pkgs
   pkgs=$(recipe_section_lookup "$B_NAME" REQUIRED)

   [[ -n "$PKGPOSTFIX" ]] && pkgs="${pkgs//B_PF/$PKGPOSTFIX}"
   # B_INSTANCE replacement in the required package list (original build script
   # behaviour): lets instance-specific recipes select instance-specific
   # packages.
   [[ -n "$B_INSTANCE" ]] && pkgs="${pkgs//B_INSTANCE/$B_INSTANCE}"
   # Reset the per-container dependency list so deps from previous recipes in
   # the same run (e.g. `build -a`) do not leak into this recipe's container.
   # build_require() only appends to BUILD_DEPS; without a reset each successive
   # container would be told to install the union of all preceding recipes' deps,
   # which can over-constrain apt (e.g. grunt pulling nodejs while another recipe
   # pulls nodejs-lts-lnw, which Conflicts nodejs).
   BUILD_DEPS=""
   build_require "$pkgs" || return 1

   ID=$(_b_pkg_id)
   B_BUILDNR=$(package_buildnr_get "$ID")

   # Find BUILD section (add extensions for distribution and distribution version)
   local CMD
   if ! CMD=$(recipe_section_lookup -q "$B_NAME" BUILD); then
      return 1
   fi

   local TMP
   TMP=$(mktemp -p "$TMPDIR" -d)
   _BUILD_TMP="$TMP"

   B_INSTALLDIR=$(_b_installdir "$B_NAME" "$B_VERSION" "$B_INSTANCE")
   (( B_FORCE == 1 )) && rm -rf "$B_INSTALLDIR"
   mkdir -p "$B_INSTALLDIR"

   # Source integrity (SECURITY.md group A): read optional recipe [INFO] keys.
   #   gpgkey         - A1: expected git tag signer (40-char fingerprint or id).
   #   commit         - A2: pinned commit SHA the resolved git ref must match.
   #   sha256         - A3: expected SHA-256 of an http/sf downloaded asset.
   #   allow_insecure - A4: explicitly allow plain http:// / git:// fetches.
   #   gittag         - exact git tag to shallow-fetch for checkout (for recipes
   #                    whose version tag is not v$B_VERSION / $B_VERSION).
   B_GPGKEY=$(recipe_item_get "$B_NAME" INFO gpgkey) || true
   B_COMMIT=$(recipe_item_get "$B_NAME" INFO commit) || true
   B_SHA256=$(recipe_item_get "$B_NAME" INFO sha256) || true
   B_ALLOW_INSECURE=$(recipe_item_get "$B_NAME" INFO allow_insecure) || true
   B_GPGKEYFILE=$(recipe_item_get "$B_NAME" INFO gpgkeyfile) || true
   B_GITTAG=$(recipe_item_get "$B_NAME" INFO gittag) || true
   B_STRICT="${STRICT:-0}"

   # Vulnerability scanning (SECURITY.md group F4): read optional recipe
   # [SECURITY] key. advisory = warn but continue; enforce = fail the build on
   # findings at or above the VULNSCAN_SEVERITY threshold (default HIGH) in
   # the staged package tree (what ships).
   # Unset = no scan. The scan runs automatically after the BUILD section
   # (B_VULNSCAN is appended to the build command below). A recipe's
   # [SECURITY] vulnscan= overrides the global VULNSCAN default from ~/.buildrc.
   B_VULNSCAN_POLICY=$(recipe_item_get "$B_NAME" SECURITY vulnscan) || true
   [[ -z "$B_VULNSCAN_POLICY" ]] && B_VULNSCAN_POLICY="${VULNSCAN:-}"
   # Severity threshold for enforce failures (VULNSCAN_SEVERITY, see above).
   B_VULNSCAN_SEVERITY="${VULNSCAN_SEVERITY:-HIGH}"
   # Per-issue vulnerability exceptions ([SECURITY] vulnscan-ignore=ID1,ID2).
   # B_VULNSCAN turns this into an osv-scanner config applied to the whole scan.
   B_VULNSCAN_IGNORE=$(recipe_item_get "$B_NAME" SECURITY vulnscan-ignore) || true
   # Merge global exception IDs (VULNSCAN_IGNORE in ~/.buildrc) with the
   # recipe's list; both are applied (the scan enforces on everything else).
   [[ -n "${VULNSCAN_IGNORE:-}" ]] && B_VULNSCAN_IGNORE="${B_VULNSCAN_IGNORE:+${B_VULNSCAN_IGNORE},}${VULNSCAN_IGNORE}"

   # Static build-script guard (SECURITY.md group F6): read optional recipe
   # [SECURITY] key. advisory = warn but continue; enforce = fail the build on
   # any suspicious build-script pattern (network access or embedded-blob
   # decoding in configure/m4/cmake/Makefile/etc.). Unset = no scan. Runs
   # automatically after the BUILD section (B_SRCGUARD is appended to the
   # build command below). A recipe's [SECURITY] srcguard= overrides the
   # global SRCGUARD default from ~/.buildrc.
   B_SRCGUARD_POLICY=$(recipe_item_get "$B_NAME" SECURITY srcguard) || true
   [[ -z "$B_SRCGUARD_POLICY" ]] && B_SRCGUARD_POLICY="${SRCGUARD:-}"
   # Per-file exceptions ([SECURITY] srcguard-ignore=path/glob). Paths are
   # relative to the build root and may contain glob patterns (e.g.
   # */Makefile.in); all hits in an ignored file are suppressed. B_SRCGUARD
   # filters its findings against this list, so srcguard=enforce stays
   # active for everything else. Global ignore patterns (SRCGUARD_IGNORE in
   # ~/.buildrc) are merged with the recipe's list.
   B_SRCGUARD_IGNORE=$(recipe_item_get "$B_NAME" SECURITY srcguard-ignore) || true
   [[ -n "${SRCGUARD_IGNORE:-}" ]] && B_SRCGUARD_IGNORE="${B_SRCGUARD_IGNORE:+${B_SRCGUARD_IGNORE},}${SRCGUARD_IGNORE}"

   # Build root: where the recipe's BUILD section runs and sources are checked
   # out. Docker: /tmp (the entrypoint cd's there). Native: the per-build temp
   # dir. B_SRCGUARD scans this tree; B_VULNSCAN scans the staged tree
   # ($B_INSTALLDIR) instead, so only what ships is checked.
   if [[ "$BUILDMODE" == "docker" ]]; then
      B_BUILDROOT="/tmp"
   else
      B_BUILDROOT="$TMP"
   fi

   # Define build environment variables and functions
   B_CACHEDIR="$CACHEDIR"
   B_PF="$PKGPOSTFIX"
   [[ -d "$RECIPEDIR/$B_NAME.files/B_BUILD" ]] && B_FILES="$RECIPEDIR/$B_NAME.files/B_BUILD"
   export B_VERSION B_INSTALLDIR B_ARCH B_INSTANCE B_CACHEDIR B_NAME B_BUILDNR B_FILES B_FORCE B_PF B_DISTRODIR B_DISTRO
   export B_GPGKEY B_COMMIT B_SHA256 B_ALLOW_INSECURE B_GPGKEYFILE B_STRICT
   export B_GITTAG
   export B_VULNSCAN_POLICY B_BUILDROOT B_VULNSCAN_IGNORE B_VULNSCAN_SEVERITY
   export B_SRCGUARD_POLICY B_SRCGUARD_IGNORE

   # Define build environment functions (used in both native and Docker modes)
   # These are exported for native mode and dumped to env script for Docker mode.

   # Download/cached retrieval of build sources
   # shellcheck disable=SC2317
   B_GET() {
      (( $# < 3 )) && { >&2 printf '%s\n' "Insufficient arguments to B_GET."; return 1; }
      local method="$1"
      local option=""
      if [[ "${2:0:1}" == "-" ]]; then
         option="$2"
         shift
         (( $# < 3 )) && { >&2 printf '%s\n' "Insufficient arguments to B_GET."; return 1; }
      fi
      local url="$2"
      local fn="$3"
      local targetdir="$B_CACHEDIR/$B_NAME"
      local target="$targetdir/$fn-$B_VERSION"
      local targetnover="$targetdir/$fn"

      # A4: enforce encrypted transport. Reject plain http://, git:// and
      # svn:// URLs unless the recipe explicitly opts in via allow_insecure=1.
      # The go method uses scheme-less import paths and is exempt.
      if [[ "$method" != "go" ]]; then
         case "$url" in
            https://*|git@*|ssh://*|svn+ssh://*|file://*) : ;;
            http://*|git://*|svn://*)
               if [[ "${B_ALLOW_INSECURE:-0}" != "1" ]]; then
                  ERR=1 output -f "B_GET: refusing insecure URL: $url (set allow_insecure=1 to override)"
                  return 1
               fi
               ;;
            *)
               ERR=1 output -f "B_GET: refusing unrecognised URL scheme: $url"
               return 1
               ;;
         esac
      fi

      case "$method" in
      "http")
         if [[ ! -f "$target" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Http downloading files.."
            _b_wget_fetch "$target" "$url" || return 1
         fi
         # A3: verify checksum of the asset (fresh or cached) when sha256 is set.
         _b_verify_copy "$target" "$fn" || return 1
         ;;
      "sf")
         if [[ ! -f "$target" ]]; then
            # A4: force HTTPS for the SourceForge RSS feed (a known weak link).
            local sfurl="$url"
            sfurl="${sfurl/#http:/https:}"
            url=$(wget -q --secure-protocol=TLSv1_2 --https-only -O - "$sfurl/rss?path=/" | xml2 | grep '/rss/channel/item/link' | grep "$B_VERSION" | cut -d '=' -f 2 | tail -1)
            [[ -n "$url" ]] || { ERR=1 output -f "B_GET: no SourceForge download found for $B_VERSION"; return 1; }
            url="${url/#http:/https:}"
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Http sf downloading files.."
            _b_wget_fetch "$target" "$url" || return 1
         fi
         _b_verify_copy "$target" "$fn" || return 1
         ;;
      "git")
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Git downloading files.."
            # Shallow clone keeps the cache small: only the default-branch tip and
            # the version tag (via _b_git_refresh), not the full repository history.
            # Tag-based recipes checkout the version tag; date-based recipes build
            # the default-branch head; both work from the shallow clone.
            if ! git clone --depth 1 "$url" "$fn"; then
               printf '%s\n' "Error cloning repository."; return 1
            fi
            if ! _b_git_refresh "$fn"; then
               printf '%s\n' "B_GET: git refresh of $fn failed."; return 1
            fi
            if [[ "$option" == "-s" ]]; then
               (cd "$fn" || exit; git submodule update --init --recursive --depth 1)
            fi
            _cache_store "$targetnover" "$fn" || return 1
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            if ! _b_git_refresh "$fn"; then
               printf '%s\n' "B_GET: git refresh of $fn failed."; return 1
            fi
            if [[ "$option" == "-s" ]]; then
               (cd "$fn" || exit; git submodule update --init --recursive --depth 1)
            fi
            _cache_store "$targetnover" "$fn" || return 1
         fi
         ;;
      "go")
         export GOROOT=/opt/go
         export PATH="${PATH}:${GOROOT}/bin"
         export GOPATH
         GOPATH=$(pwd)
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Go downloading files.."
            if ! go get "$url"; then
               printf '%s\n' "Error downloading repository."; return 1
            fi
            _cache_store "$targetnover" . || return 1
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            # No -u: never upgrade dependencies on cache refresh. A silent
            # upgrade could pull in a compromised version (supply-chain risk).
            if ! go get "$url"; then
               printf '%s\n' "Error updating repository."; return 1
            fi
            _cache_store "$targetnover" . || return 1
         fi
         ;;
      "hg")
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Mercurial downloading files.."
            if ! hg clone "$url" "$fn"; then
               printf '%s\n' "Error cloning repository."; return 1
            fi
            _cache_store "$targetnover" "$fn" || return 1
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            cd "$fn" || return 1
            local loc_id rem_id
            loc_id=$(hg id | cut -d' ' -f 1)
            rem_id=$(hg id "$url")
            if [[ "$loc_id" != "$rem_id" ]]; then
               hg pull
               cd ..
               _cache_store "$targetnover" "$fn" || return 1
            else
               cd ..
            fi
         fi
         ;;
      "svn")
         local -a svn_opts=(--non-interactive --trust-server-cert)
         if [[ ! -f "$targetnover" ]]; then
            [[ -d "$targetdir" ]] || mkdir -p "$targetdir"
            printf '%s\n' "Subversion downloading files.."
            if ! svn checkout "${svn_opts[@]}" -q "$url" "$fn"; then
               printf '%s\n' "Error checking out repository."; return 1
            fi
            _cache_store "$targetnover" "$fn" || return 1
         else
            flock -w 60 "$targetnover" tar xzf "$targetnover"
            cd "$fn" || return 1
            local rem_rev loc_rev
            rem_rev=$(svn info "${svn_opts[@]}" "$url" | grep Revision | cut -d' ' -f2)
            loc_rev=$(svn info "${svn_opts[@]}" | grep Revision | cut -d' ' -f2)
            if [[ "$rem_rev" != "$loc_rev" ]]; then
               svn update "${svn_opts[@]}"
               cd ..
               _cache_store "$targetnover" "$fn" || return 1
            else
               cd ..
            fi
         fi
         ;;
      *)
         printf '%s\n' "B_GET: unknown method $method"
         return 1
         ;;
      esac
   }
   export -f B_GET

   # Verify and check out a git tag/commit with source-integrity checks
   # (SECURITY.md group A1 & A2). Replaces a bare `git checkout tags/v$B_VERSION`
   # in recipes so that tag signatures (A1) and pinned commits (A2) are enforced.
   # Parameters: <ref>  e.g. "v$B_VERSION" or "tags/v$B_VERSION"
   # Uses B_GPGKEY (A1), B_COMMIT (A2) and B_STRICT from the build environment.
   # shellcheck disable=SC2317
   B_GITCHECKOUT() {
      (( $# < 1 )) && { >&2 printf '%s\n' "Insufficient arguments to B_GITCHECKOUT."; return 1; }
      local ref="$1"
      local tag
      if [[ "$ref" == tags/* ]]; then
         tag="${ref#tags/}"
      else
         tag="$ref"
         ref="tags/$ref"
      fi

      if ! git checkout "$ref" 2>/dev/null; then
         git checkout "$tag" || { output "B_GITCHECKOUT: failed to checkout $tag"; return 1; }
      fi

      # A2: refuse to build if the resolved ref does not match the pinned commit.
      if [[ -n "${B_COMMIT:-}" ]]; then
         local head
         head=$(git rev-parse HEAD 2>/dev/null) || { output "B_GITCHECKOUT: cannot resolve HEAD"; return 1; }
         if [[ "$head" != "$B_COMMIT" ]]; then
            output "B_GITCHECKOUT: resolved commit ${head} does not match pinned commit ${B_COMMIT}"
            return 1
         fi
         output "B_GITCHECKOUT: pinned commit verified (${head})"
      fi

      # A1: verify the git tag signature against the expected signer.
      if [[ -n "${B_GPGKEY:-}" ]]; then
         _b_gpg_ensure_key || return 1
         local raw
         if ! raw=$(git verify-tag --raw "$tag" 2>&1); then
            output "B_GITCHECKOUT: tag ${tag} signature invalid or missing"
            output "$raw"
            return 1
         fi
         # Confirm the signature was made by the expected key (fingerprint or id).
         if ! printf '%s\n' "$raw" | grep -qE "GOODSIG ${B_GPGKEY}|VALIDSIG ${B_GPGKEY}"; then
            output "B_GITCHECKOUT: tag ${tag} not signed by expected key ${B_GPGKEY}"
            return 1
         fi
         output "B_GITCHECKOUT: tag ${tag} signature verified"
      elif [[ "${B_STRICT:-0}" == "1" ]]; then
         output "B_GITCHECKOUT: STRICT mode requires a gpgkey for git checkouts"
         return 1
      fi
      return 0
   }
   export -f B_GITCHECKOUT

   # Create symlinks for all files in a source directory to a destination directory
   # Parameters: [-r] source_dir dest_dir
   #   -r  recurse into subdirectories
   # shellcheck disable=SC2317
   B_LINKFILES() {
      local rec=0
      [[ "$1" == "-r" ]] && { rec=1; shift; }
      local src="$1"
      local dst="$2"
      local name

      [[ -d "$B_INSTALLDIR/$src" ]] || { printf '%s\n' "B_LINKFILES: source needs to be a directory within the B_INSTALLDIR tree."; return 1; }
      [[ -d "$B_INSTALLDIR/$dst" ]] || mkdir -p "$B_INSTALLDIR/$dst"
      shopt -s nullglob
      pushd "$B_INSTALLDIR/$src" > /dev/null || return 1
      for name in *; do
         if [[ "${name/%.real/}" == "$name" ]]; then
            if [[ -d "$B_INSTALLDIR/$src/$name" ]] && (( rec == 1 )); then
               B_LINKFILES -r "$src/$name" "$dst/$name"
            else
               ln -s "$src/$name" "$B_INSTALLDIR/$dst"
            fi
         fi
      done
      popd > /dev/null || return 1
   }
   export -f B_LINKFILES

   # Create a symlink for a single file to a destination directory
   # Parameters: source_file dest_dir
   # shellcheck disable=SC2317
   B_LINKFILE() {
      local src="$1"
      local dst="$2"
      [[ -f "$B_INSTALLDIR/$src" ]] || { printf '%s\n' "B_LINKFILE: source needs to be a file within the B_INSTALLDIR tree."; return 1; }
      [[ -d "$B_INSTALLDIR/$dst" ]] || mkdir -p "$B_INSTALLDIR/$dst"
      ln -s "$src" "$B_INSTALLDIR/$dst"
   }
   export -f B_LINKFILE

   # Scan the staged package tree (SECURITY.md group F4): only what actually
   # ships in the produced package is scanned, not the whole build tree, so
   # build-only tooling (dev dependencies, vendored test deps, the toolchain)
   # does not trigger findings. syft (baked into the Docker base image)
   # inventories the installed tree in $B_INSTALLDIR (node_modules,
   # site-packages dist-info, Go module info in compiled binaries, ...) into
   # a CycloneDX SBOM; osv-scanner checks the SBOM against the OSV database.
   # Policy from B_VULNSCAN_POLICY: advisory (warn but continue) or enforce
   # (fail on findings at or above the B_VULNSCAN_SEVERITY threshold).
   # Per-issue exceptions come from the recipe's [SECURITY] section
   # (B_VULNSCAN_IGNORE, comma-separated IDs); they are turned into an
   # osv-scanner config passed via --config so they apply to the whole scan.
   # shellcheck disable=SC2317
   B_VULNSCAN() {
      local target="${B_INSTALLDIR:-}"
      local policy="${B_VULNSCAN_POLICY:-}"
      [[ -n "$policy" ]] || return 0

      [[ -d "$target" ]] || {
         output "B_VULNSCAN: staged package tree $target not found, skipping scan"
         return 0
      }
      command -v syft > /dev/null 2>&1 || {
         output "B_VULNSCAN: syft not available in build environment"
         [[ "$policy" == "enforce" ]] && return 1
         return 0
      }
      command -v osv-scanner > /dev/null 2>&1 || {
         output "B_VULNSCAN: osv-scanner not available in build environment"
         [[ "$policy" == "enforce" ]] && return 1
         return 0
      }
      command -v jq > /dev/null 2>&1 || {
         output "B_VULNSCAN: jq not available in build environment"
         [[ "$policy" == "enforce" ]] && return 1
         return 0
      }

      # Inventory the staged tree into a CycloneDX SBOM. The default dir-scan
      # catalogers already cover installed Python packages (dist-info) and Go
      # module info in binaries; javascript-package-cataloger is added because
      # it is image-scan-only by default, but it is the only cataloger that
      # reads installed node_modules (node_modules/*/package.json).
      local sbom
      sbom=$(mktemp "${TMPDIR:-/tmp}/vulnscan-sbom-XXXXXX.cdx.json")
      if ! syft "dir:$target" --select-catalogers "+javascript-package-cataloger" \
            -o "cyclonedx-json=$sbom" > /dev/null 2>&1; then
         output "B_VULNSCAN: syft failed to inventory $target"
         rm -f "$sbom"
         [[ "$policy" == "enforce" ]] && return 1
         return 0
      fi

      # Generate the osv-scanner config from the recipe's [SECURITY]
      # vulnscan-ignore list (if any) and apply it to the whole scan.
      local config_args=() cfg=""
      if [[ -n "${B_VULNSCAN_IGNORE:-}" ]]; then
         cfg=$(mktemp "${TMPDIR:-/tmp}/vulnscan-cfg-XXXXXX.toml")
         : > "$cfg"
         local _id
         IFS=',' read -ra _ids <<< "$B_VULNSCAN_IGNORE" || true
         for _id in "${_ids[@]}"; do
            _id="${_id//[[:space:]]/}"
            [[ -n "$_id" ]] || continue
            printf '[[IgnoredVulns]]\nid = "%s"\nreason = "ignored via [SECURITY] vulnscan-ignore in recipe"\n\n' "$_id" >> "$cfg"
         done
         config_args=(--config="$cfg")
         output "B_VULNSCAN: applying recipe exception(s) from [SECURITY] vulnscan-ignore"
      fi

      local json total highcrit
      json=$(osv-scanner scan --sbom "$sbom" --format=json ${config_args[@]+"${config_args[@]}"} 2>/dev/null) || true
      rm -f "$sbom"
      [[ -n "$cfg" ]] && rm -f "$cfg"
      total=$(printf '%s\n' "$json" | jq '[.results[]?.packages[]?.vulnerabilities[]?] | length' 2>/dev/null)
      total="${total:-0}"
      # Enforce threshold: fail only on findings at or above this GitHub/OSV
      # severity level (LOW < MODERATE < HIGH < CRITICAL). Default HIGH.
      local sev cond
      sev="${B_VULNSCAN_SEVERITY:-HIGH}"
      case "${sev^^}" in
         CRITICAL)        cond='. == "CRITICAL"' ;;
         MODERATE|MEDIUM) cond='. == "MODERATE" or . == "HIGH" or . == "CRITICAL"' ;;
         LOW)             cond='. != null' ;;
         *)               cond='. == "HIGH" or . == "CRITICAL"' ;;
      esac
      highcrit=$(printf '%s\n' "$json" | jq "[.results[]?.packages[]?.vulnerabilities[]?.database_specific.severity? | select($cond)] | length" 2>/dev/null)
      highcrit="${highcrit:-0}"

      if (( total == 0 )); then
         output "B_VULNSCAN: no known vulnerabilities found"
         return 0
      fi

      # Print a concise per-vulnerability summary to the build log, plus a
      # copy-pasteable [SECURITY] block so the recipe author can suppress
      # reviewed findings (lists every reported ID; trim as needed).
      printf '%s\n' "$json" | jq -r '.results[]?.packages[]? | .package.name as $p | .vulnerabilities[]? | "  \(.id)  \(.database_specific.severity // "UNKNOWN")  \($p)"' 2>/dev/null
      local ids
      ids=$(printf '%s\n' "$json" | jq -r '[.results[]?.packages[]?.vulnerabilities[]?.id] | unique | join(",")' 2>/dev/null)
      if [[ -n "$ids" ]]; then
         printf '%s\n' "B_VULNSCAN: to suppress these, add to the recipe:"
         printf '%s\n' "[SECURITY]"
         printf '%s\n' "vulnscan-ignore=$ids"
      fi

      if (( highcrit > 0 )); then
         output "B_VULNSCAN: $highcrit >=$sev vulnerability(ies) found ($total total)"
         if [[ "$policy" == "enforce" ]]; then
            output "B_VULNSCAN: enforce mode - failing build"
            return 1
         fi
         output "B_VULNSCAN: advisory mode - continuing"
      else
         output "B_VULNSCAN: $total vulnerability(ies) found, none at or above $sev - continuing"
      fi
      return 0
   }
   export -f B_VULNSCAN

   # Scan the build tree for suspicious build-script patterns (SECURITY.md
   # group F6): network access or embedded-blob decoding inside configure/m4/
   # cmake/Makefile/package.json scripts -- the XZ/liblzma signature. Policy
   # from B_SRCGUARD_POLICY: advisory (warn but continue) or enforce (fail on
   # any hit). Scans $B_BUILDROOT by default, or a path given as the first
   # argument. Heuristic; may produce false positives (advisory recommended).
   # Per-file exceptions come from the recipe's [SECURITY] section
   # (B_SRCGUARD_IGNORE, comma-separated paths relative to the build root);
   # all hits in an ignored file are suppressed, so srcguard=enforce stays
   # active for everything else.
   # shellcheck disable=SC2317
   B_SRCGUARD() {
      local target="${1:-${B_BUILDROOT:-.}}"
      local policy="${B_SRCGUARD_POLICY:-}"
      [[ -n "$policy" ]] || return 0

      # Suspicious patterns: network access or embedded-blob decoding in build
      # scripts. Heuristic; may produce false positives.
      local hits
      hits=$(grep -rnIE \
         --include='configure' --include='configure.ac' --include='configure.in' \
         --include='*.m4' --include='CMakeLists.txt' --include='*.cmake' \
         --include='Makefile' --include='Makefile.*' --include='*.mk' \
         --include='package.json' --include='setup.py' --include='pyproject.toml' \
         --include='*.spec' --include='meson.build' --include='build.rs' \
         --exclude-dir='.git' --exclude-dir='node_modules' --exclude-dir='vendor' \
         --exclude-dir='target' --exclude-dir='.venv' --exclude-dir='venv' \
         'curl|wget|git clone|git fetch|go get|svn checkout|hg clone|base64 -d|base64 --decode|xxd -r|uudecode' \
         "$target" 2>/dev/null) || true

      if [[ -z "$hits" ]]; then
         output "B_SRCGUARD: no suspicious build-script patterns found"
         return 0
      fi

      # Filter hits against the recipe's [SECURITY] srcguard-ignore list
      # (comma-separated paths relative to the build root). A hit is
      # suppressed when its file path (scan-target prefix stripped) is in the
      # list, so a recipe can allow-list a whole file (e.g. a Makefile that
      # legitimately downloads firmware) while srcguard=enforce stays active
      # for everything else.
      local ignored=0
      if [[ -n "${B_SRCGUARD_IGNORE:-}" ]]; then
         local _ignore_paths=() _hit _file _rel _p _kept=""
         IFS=',' read -ra _ignore_paths <<< "$B_SRCGUARD_IGNORE" || true
         while IFS= read -r _hit; do
            _file="${_hit%%:*}"
            _rel="${_file#"$target"/}"
            local _suppressed=0
            for _p in "${_ignore_paths[@]}"; do
               _p="${_p//[[:space:]]/}"
               [[ -n "$_p" ]] || continue
               # _p is an unquoted glob pattern (e.g. */Makefile.in) matched
               # against the hit path relative to the scan target.
               # shellcheck disable=SC2053
               if [[ "$_rel" == $_p ]]; then
                  _suppressed=1
                  break
               fi
            done
            if (( _suppressed == 1 )); then
               ignored=$((ignored + 1))
            else
               _kept+="$_hit"$'\n'
            fi
         done <<< "$hits"
         hits="${_kept%$'\n'}"
         if (( ignored > 0 )); then
            output "B_SRCGUARD: suppressed $ignored hit(s) via [SECURITY] srcguard-ignore"
         fi
      fi

      if [[ -z "$hits" ]]; then
         output "B_SRCGUARD: no suspicious build-script patterns found (after srcguard-ignore)"
         return 0
      fi

      # Print findings to the build log.
      printf '%s\n' "$hits" | sed 's/^/  /'

      local count
      count=$(printf '%s\n' "$hits" | wc -l)
      output "B_SRCGUARD: $count suspicious build-script pattern(s) found"
      # copy-pasteable [SECURITY] block so the recipe author can suppress
      # reviewed files (lists every reported file, relative to the build root;
      # trim as needed).
      local files
      files=$(printf '%s\n' "$hits" | sed 's/:.*//' | sed "s#^$target/##" | sort -u | paste -sd, -)
      if [[ -n "$files" ]]; then
         printf '%s\n' "B_SRCGUARD: to suppress these, add to the recipe:"
         printf '%s\n' "[SECURITY]"
         printf '%s\n' "srcguard-ignore=$files"
      fi
      if [[ "$policy" == "enforce" ]]; then
         output "B_SRCGUARD: enforce mode - failing build"
         return 1
      fi
      output "B_SRCGUARD: advisory mode - continuing"
      return 0
   }
   export -f B_SRCGUARD

   # Append the vulnerability scan to the build command so it runs after the
   # recipe's BUILD section (post-build, pre-package) when a policy is set.
   # B_VULNSCAN inventories the staged package tree ($B_INSTALLDIR) with syft
   # and checks the SBOM with osv-scanner, so only what ships is scanned.
   if [[ -n "$B_VULNSCAN_POLICY" ]]; then
      CMD="$CMD
B_VULNSCAN"
   fi

   # Append the static build-script guard to the build command (post-build,
   # pre-package) when a policy is set. B_SRCGUARD scans $B_BUILDROOT for
   # suspicious build-script patterns.
   if [[ -n "$B_SRCGUARD_POLICY" ]]; then
      CMD="$CMD
B_SRCGUARD"
   fi

   # --- Docker mode: run build inside container ---
   if [[ "$BUILDMODE" == "docker" ]]; then
      # Select Docker image based on target distro
      local image
      image=$(docker_image_select "$BUILDDISTRO")

      # Write build command to a temp file
      local buildfile
      buildfile=$(mktemp -p "$TMPDIR" build-cmd-"${B_NAME}"-XXXXXX.sh)
      printf '#!/usr/bin/env bash\n' > "$buildfile"
      printf '%s\n' "$CMD" >> "$buildfile"
      chmod +x "$buildfile"

      # Write build environment to a temp file
      local envfile
      envfile=$(mktemp -p "$TMPDIR" build-env-"${B_NAME}"-XXXXXX.sh)
      docker_prepare_env "$envfile" || { rm -f "$envfile" "$buildfile"; return 1; }

      # If packaging is also requested, prepare package command
      local pkgcmdfile=""
      if (( DO_PACKAGE != 0 )); then
         pkgcmdfile=$(mktemp -p "$TMPDIR" pkg-cmd-"${B_NAME}"-XXXXXX.sh)
         docker_prepare_package_cmd "$pkgcmdfile" "$B_NAME" "$B_VERSION" || { rm -f "$envfile" "$buildfile" "$pkgcmdfile"; return 1; }
      fi

      # Run build (and optionally package) inside Docker container
      _docker_run "$image" "$envfile" "$buildfile" "$pkgcmdfile"
      local result=$?

      # Clean up temp files
      rm -f "$envfile" "$buildfile" "$pkgcmdfile"

      if (( result != 0 )); then
         rm -rf "$B_INSTALLDIR"
         return 1
      fi
      B_BUILDTIME=$((SECONDS - build_start))
      return 0
   fi

   # --- Native mode: run build directly on host ---

   # Setting to set temporary files to the build folder
   export XDG_CACHE_HOME="$TMP/.cache"
   export YARN_CACHE_FOLDER="$TMP/.cache/yarn"
   export PYTHONDONTWRITEBYTECODE=1
   export npm_config_cache="$TMP/.npm"
   export CABAL_DIR="$TMP/.cabal"
   export GOPATH="$TMP/.go"

   local result
   local -a opts=()
   [[ "$DEBUG" == "1" ]] && opts+=("-x")
   opts+=("-e" "-c")

   # Remove the install directory if the build is interrupted (Ctrl-C), so a
   # half-built tree is not mistaken for a completed build on the next run.
   # The trap is cleared once the build command (and optional debug shell) has
   # finished; the existing result-based cleanup handles normal failure/success.
   trap 'rm -rf "${B_INSTALLDIR:-}" 2>/dev/null; exit 130' INT TERM

   pushd "$TMP" > /dev/null || return 1
   if [[ "$QUIET" == "1" ]]; then
      bash "${opts[@]}" "$CMD" 2>&1 | tee "$LOGDIR/${B_NAME}-${B_ARCH}.log" > /dev/null
   else
      bash "${opts[@]}" "$CMD" 2>&1 | tee "$LOGDIR/${B_NAME}-${B_ARCH}.log"
   fi
   # Capture exit status of the bash command (first in pipeline), not tee
   result=${PIPESTATUS[0]}
   if (( result != 0 )) && [[ -n "$DEBUGSHELL" ]]; then
      printf '%s\n' "## Build failed. Dropping to shell."
      printf '%s\n' "## See $LOGDIR/${B_NAME}-${B_ARCH}.log for build information."
      printf '%s\n' "## Any changes to the build root will be removed after exit."
      printf '%s\n' "## Type exit to return."
      printf '%s\n' ""
      PS1="\h:\w buildroot $ " bash --norc
   fi
   # Build command phase over: clear the interrupt trap so a Ctrl-C during
   # post-build cleanup (e.g. dependency removal on a successful build) does
   # not wipe a valid install directory.
   trap - INT TERM
   popd > /dev/null || return 1
   find "$TMP" -type d -print0 | xargs -0 chmod +w
   rm -rf "$TMP"
   _BUILD_TMP=""

   [[ -n "$pkgs" && "$DEINSTDEP" == "yes" ]] && (( B_NOPKGRM == 0 )) && build_require_remove "$pkgs"
   if (( result != 0 )); then
      rm -rf "$B_INSTALLDIR"
      return 1
   fi
   B_BUILDTIME=$((SECONDS - build_start))
   return 0
}

# Get the next build number for a package from PKGLIST.
# Parameters: package_id
package_buildnr_get() {
   local ID="$1"
   [[ -d "$(dirname "$PKGLIST")" ]] || mkdir -p "$(dirname "$PKGLIST")"
   [[ -f "$PKGLIST" ]] || touch "$PKGLIST"
   local BUILDNR
   # Match the key exactly (tab-delimited field 1), never as a prefix: a
   # doubled-arch key (pkg_1.0_amd64_amd64) must not count as pkg_1.0_amd64,
   # and version strings containing regex metacharacters (+.() etc.) must
   # match literally.
   BUILDNR=$(awk -F '\t' -v id="$ID" '$1 == id { print $2 }' "$PKGLIST")
   [[ -z "$BUILDNR" ]] && BUILDNR=0
   printf '%s\n' "$(( BUILDNR + 1 ))"
}

# Copy built packages to the repository.
# Parameters: package files to push
package_torepo() {
   local pkg type
   local -a deb_pkgs=()
   local -A unknown_types=()
   local RET=0

   for pkg in "$@"; do
      type="${pkg/*./}"
      case "$type" in
      "deb")
         deb_pkgs+=("$pkg")
         ;;
      *)
         # Emit the "not implemented" error once per unknown type.
         [[ -z "${unknown_types[$type]:-}" ]] && \
            ERR=1 output "Copy to repository not implemented for type $type"
         unknown_types["$type"]=1
         RET=1
         ;;
      esac
   done

   cd "$PKGDIR" || return 1
   if (( ${#deb_pkgs[@]} != 0 )); then
      if [[ -n "${TODEBREPO:-}" ]]; then
         $TODEBREPO "${deb_pkgs[@]}" || RET=1
      else
         ERR=1 output "TODEBREPO not configured"
         RET=1
      fi
   fi
   return "$RET"
}

# Package a built recipe into a distributable package.
# Parameters: recipe_name version
package() {
   local pkg="$1"
   local version="$2"
   local ID

   # Ensure B_NAME is set (build() sets it, but a package-only run -p may skip
   # build()). Used for the per-recipe log file path so packaging output lands in
   # the same log as the build output.
   B_NAME="$pkg"

   recipe_section_get "$pkg" PKG > /dev/null || return 1

   local pkgpath
   pkgpath=$(_b_installdir "$pkg" "$version" "$B_INSTANCE")
   if [[ ! -d "$pkgpath" ]]; then
      ERR=1 output "Version $version of $pkg is not available for packaging."
      return 1
   fi
   # The build output may have been pruned (BUILDKEEPTIME: a fast build's
   # output was replaced with an empty marker dir). Re-packaging then needs a
   # full rebuild first.
   if [[ -f "$pkgpath/.build-pruned" ]]; then
      ERR=1 output "Version $version of $pkg was pruned as a fast build (BUILDKEEPTIME); rebuild required to re-package."
      return 1
   fi

   if [[ -n "$B_INSTANCE" ]]; then
      ID="${version}-${B_INSTANCE}"
   else
      ID="${version}"
   fi
   local type
   type=$(recipe_item_get "$pkg" PKG type)
   # Only the first declared package type is processed: every case above
   # returned on the first iteration, so a "deb,rpm" type effectively meant
   # deb. Keep that behaviour explicitly.
   local pkgtype="${type%%[, ]*}"
   case "$pkgtype" in
   "deb")
      if [[ "$OS" == "Debian GNU/Linux" ]]; then
         package_deb "$pkg" "$version" "$ID"
         return $?
      fi
      ERR=1 output "Debian packaging requires Debian (running on $OS)."
      return 1
      ;;
   *)
      ERR=1 output "Unknown package type ($pkgtype)."
      return 1
      ;;
   esac
}

# Generate a SLSA-style provenance sidecar for a built package (SECURITY.md
# group D1). Writes <pkgfile>.provenance.json next to the .deb in $PKGDIR,
# recording what was built from what (recipe, version, source-integrity pins,
# build number, package checksum, image digest, build-deps snapshot).
# Best-effort: never fails the build. May be called with several package
# files (one per line / argument); writes a sidecar for each.
# Parameters: pkgfile...
_b_provenance() {
   command -v jq > /dev/null 2>&1 || return 0

   local pkgfile recipe_head="" pkg_sha256="" deps=""
   for pkgfile in "$@"; do
      [[ -n "$pkgfile" ]] || continue
      recipe_head=""
      [[ -d "$RECIPEDIR/.git" ]] && recipe_head=$(git -C "$RECIPEDIR" rev-parse HEAD 2>/dev/null)
      pkg_sha256=$(sha256sum "$PKGDIR/$pkgfile" 2>/dev/null | cut -d' ' -f1)
      # Snapshot of installed packages (base image + build deps) for
      # reproducibility (SECURITY.md B2). Sorted, one "pkg=version" per line.
      deps=$(dpkg-query -W -f='${Package}=${Version}\n' 2>/dev/null | sort)

      jq -n \
         --arg recipe "${pkg:-}" \
         --arg version "${version:-}" \
         --arg arch "${B_ARCH:-}" \
         --arg distro "${B_DISTRO:-}" \
         --arg package "$pkgfile" \
         --arg pkg_sha256 "$pkg_sha256" \
         --arg buildnr "${P_BUILDNR:-}" \
         --arg recipe_head "$recipe_head" \
         --arg commit "${B_COMMIT:-}" \
         --arg gpgkey "${B_GPGKEY:-}" \
         --arg sha256 "${B_SHA256:-}" \
         --arg image_digest "${B_IMAGE_DIGEST:-}" \
         --arg host "${BUILD_HOST:-$(hostname 2>/dev/null)}" \
         --arg deps "$deps" \
         --arg timestamp "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
         '{
            schema_version: "1.0",
            recipe: $recipe,
            version: $version,
            arch: $arch,
            distro: $distro,
            package: $package,
            package_sha256: $pkg_sha256,
            build_number: $buildnr,
            recipe_git_head: $recipe_head,
            source: { commit: $commit, gpgkey: $gpgkey, sha256: $sha256 },
            image_digest: $image_digest,
            build_host: $host,
            build_deps: ($deps | split("\n") | map(select(length > 0))),
            timestamp: $timestamp
         }' > "$PKGDIR/${pkgfile}.provenance.json" 2>/dev/null
   done
   return 0
}

# Build a Debian package from a built recipe.
# Parameters: recipe_name version package_id
package_deb() {
   local pkg="$1"
   local version="$2"

   local pkgready
   pkgready=$(recipe_item_get "$pkg" PKG pkgready) || true

   local pkgdir
   pkgdir=$(_b_installdir "$pkg" "$version" "${B_INSTANCE:-}")

   if [[ -z "$pkgready" ]]; then
      local P_PKGNAME="${pkg}_${ID}_${B_ARCH}"
      local P_BUILDNR
      P_BUILDNR=$(package_buildnr_get "${P_PKGNAME}")

      # Find recipe package section
      local INFO
      if ! INFO=$(recipe_section_get -q "$pkg" "DEB $rel" || recipe_section_get "$pkg" DEB); then
         return 1
      fi

      local TMP
      TMP=$(mktemp -p "$TMPDIR" -d)
      mkdir -p "$TMP/build/DEBIAN"
      local pkgversion
      pkgversion="${version//\-/}-$P_BUILDNR+deb$(lsb_release -r -s | cut -d'.' -f 1)"

      if printf '%s' "$INFO" | grep -q B_DEPENDS; then
         local CMD
         local DEPS
         CMD=$(recipe_section_get "$pkg" DEB_DEPENDS)
         # Same environment as the original build script gave the DEB_DEPENDS
         # command: version, instance and package postfix.
         DEPS=$(B_VERSION="$version" B_INSTANCE="${B_INSTANCE:-}" \
            B_PF="${PKGPOSTFIX:-}" bash -c "$CMD")
         INFO=$(printf '%s\n' "$INFO" | sed "/^Depends:/ s/B_DEPENDS/$DEPS/")
      fi
      [[ -n "$PKGPOSTFIX" ]] && INFO=$(printf '%s\n' "$INFO" | sed "/^Package:/ s/$/-$PKGPOSTFIX/" | sed "s/B_PF/$PKGPOSTFIX/g")
      # B_INSTANCE replacement in the package section (original build script
      # behaviour, e.g. for instance-specific package names).
      [[ -n "$B_INSTANCE" ]] && INFO=$(printf '%s\n' "$INFO" | sed "s/B_INSTANCE/$B_INSTANCE/g")
      [[ -n "$PKGPOSTFIX" ]] && INFO="${INFO//B_MAIL/$PKGMAIL}"
      [[ -n "$PKGORG" ]] && INFO="${INFO//B_ORG/$PKGORG}"
      [[ -n "$PKGMAIL" ]] && INFO="${INFO//B_MAIL/$PKGMAIL}"

      cd "$pkgdir" || return 1
      tar pcfB - . | (cd "$TMP/build" || exit; tar pxfB -)
      cd "$TMP/build" || return 1

      # Distro-specific B_DEBIAN-<release> tree takes precedence over the
      # generic B_DEBIAN (documented order; original behaviour, see commit
      # 9c5bed6 "Implemented B_DEBIAN-release option"). $rel is the uppercase
      # codename (e.g. TRIXIE), matching directory names like B_DEBIAN-BOOKWORM.
      if [[ -d "$RECIPEDIR/$pkg.files/B_DEBIAN-$rel" ]]; then
         (cd "$RECIPEDIR/$pkg.files/B_DEBIAN-$rel" || exit; tar cf - .) | tar xf -
      elif [[ -d "$RECIPEDIR/$pkg.files/B_DEBIAN" ]]; then
         (cd "$RECIPEDIR/$pkg.files/B_DEBIAN" || exit; tar cf - .) | tar xf -
      fi

      # Mark config files. A conffiles shipped via the B_DEBIAN tree is kept
      # and merged (deduped) with the /etc files found in the build output,
      # instead of being silently overwritten.
      local shipped_conffiles=""
      [[ -f DEBIAN/conffiles ]] && shipped_conffiles=$(cat DEBIAN/conffiles)
      {
         [[ -n "$shipped_conffiles" ]] && printf '%s\n' "$shipped_conffiles"
         find . -path "*/etc/*" -type f | sed "s/^\.//"
      } | sort -u > DEBIAN/conffiles
      local configfiles
      configfiles=$(recipe_item_get "$pkg" PKG configfiles) || true
      [[ -n "$configfiles" ]] && { printf '%s\n' "$configfiles" | tr ' ' '\n' >> DEBIAN/conffiles; }

      printf '%s\n' "$INFO" | sed "s/B_VERSION/$pkgversion/" | sed "s/B_ARCH/$B_ARCH/" > "$TMP/build/DEBIAN/control"

      cd "$TMP" || return 1
      local pkglog="$LOGDIR/${B_NAME}-${B_ARCH}.log"
      # Append packaging output to the per-recipe log so build + package output
      # for a recipe live in one place. In native mode, also show it live when
      # not quiet; in docker mode the entrypoint already echoes the log on
      # failure/verbose, so we don't print here (would duplicate in the log).
      printf '\n### Packaging %s (version %s)\n' "$pkg" "$version" >> "$pkglog"
      # LC_ALL=C: the package filename is parsed from dpkg's message below;
      # a translated locale would change the wording and break that parse.
      LC_ALL=C fakeroot dpkg --build "$TMP/build" . > "$TMP/.buildoutput" 2>&1
      local result=$?
      cat "$TMP/.buildoutput" >> "$pkglog"
      # Note: [[ ]] not (( )) -- an arithmetic comparison of BUILDMODE (a
      # string) with set -u would fail with "unbound variable".
      # stderr, not stdout: package() is called via $(...) in main(), so any
      # stdout here would be captured into work_package and then passed to
      # package_torepo as bogus extra "packages" ("type " empty).
      [[ "${QUIET:-0}" == "0" && "$BUILDMODE" != "docker" ]] && cat "$TMP/.buildoutput" >&2
      local pkgfile
      pkgfile=$(cut -d "'" -f 4 "$TMP/.buildoutput")
      pkgfile="${pkgfile/*\//}"

      if (( result != 0 )); then
         rm -rf "$TMP"
         ERR=1 output "Error while building package (see $pkglog)."
         return 1
      fi

      # Record the package build number under the exact package key (single
      # arch suffix). Also delete the legacy doubled-arch key
      # (pkg_version_arch_arch) that older versions of this script wrote, so a
      # stale doubled entry can never make package_buildnr_get() see two values
      # for one package.
      awk -F '\t' -v id="${P_PKGNAME}" '$1 != id' "$PKGLIST" > "$PKGLIST.tmp" && mv "$PKGLIST.tmp" "$PKGLIST"
      awk -F '\t' -v id="${P_PKGNAME}_${B_ARCH}" '$1 != id' "$PKGLIST" > "$PKGLIST.tmp" && mv "$PKGLIST.tmp" "$PKGLIST"
      printf '%s\t%s\n' "${P_PKGNAME}" "$P_BUILDNR" >> "$PKGLIST"

      mv "$TMP/$pkgfile" "$PKGDIR"
      rm -rf "$TMP"
   else
      if [[ "$(printf '%s\n' "$pkgdir"/*.deb)" == "$pkgdir/*.deb" ]]; then
         ERR=1 output "Recipe indicates package should be in build dir, but it isn't."
         return 1
      else
         local -a deb_files=("$pkgdir"/*.deb)
         cp "${deb_files[@]}" "$PKGDIR"
         # pkgready builds (e.g. openzfs make native-deb) may produce several
         # packages; return all of them (one per line) so every one is pushed
         # to the repository, not just the first in glob order.
         pkgfile=$(printf '%s\n' "${deb_files[@]##*/}")
      fi
   fi
   # Write a provenance sidecar next to each package (SECURITY.md group D1).
   while IFS= read -r f; do
      [[ -n "$f" ]] && _b_provenance "$f"
   done <<< "$pkgfile"
   printf '%s\n' "$pkgfile"
}

# Get the latest version of a recipe by running its VERSION section.
# Parameters: recipe_name
version_get() {
   local pkg="$1"
   local CMD

   export B_SARCH
   export B_NAME="$1"
   # Compatibility with the original (non-docker) build script: B_ARCH and
   # B_FILES were available to the version check section there, so recipes
   # with per-arch version logic keep working. B_FILES points at the recipe's
   # B_BUILD files directory when present.
   B_FILES=""
   [[ -d "$RECIPEDIR/$B_NAME.files/B_BUILD" ]] && B_FILES="$RECIPEDIR/$B_NAME.files/B_BUILD"
   export B_ARCH B_FILES

   # Find the newest tag for a git repository with filtering options
   # shellcheck disable=SC2317
   B_GITVER() {
      local exclude='-e "alpha\|beta\|preview\|rc\|a$\|b$\|b[0-9]*$"'
      local include=""
      local preregex=""
      local postregex=""
      local prefilter='s/^v//'
      local postfilter=""
      local DEBUG=0

      while getopts :aDr:R:i:e:f:F: opt; do
         case $opt in
         r) preregex="$preregex; $OPTARG" ;;
         R) postregex="$postregex; $OPTARG" ;;
         f) prefilter="$prefilter; s/$OPTARG//" ;;
         i) include="$include -e $OPTARG" ;;
         e) exclude="$exclude -e $OPTARG" ;;
         F) postfilter="$postfilter; s/$OPTARG//" ;;
         a) exclude="" ;;
         D) DEBUG=1 ;;
         \?) printf '%s\n' "Unknown option: -$OPTARG" ;;
         :) printf '%s\n' "Option -$OPTARG requires argument" ;;
         esac
      done
      shift $((OPTIND - 1))

      [[ -n "$preregex" ]] && preregex="sed \"$preregex\"" || preregex="cat"
      prefilter="sed \"$prefilter\""
      [[ -n "$include" ]] && include="grep -i $include" || include="cat"
      [[ -n "$exclude" ]] && exclude="grep -iv $exclude" || exclude="cat"
      [[ -n "$postfilter" ]] && postfilter="sed \"$postfilter\"" || postfilter="cat"
      [[ -n "$postregex" ]] && postregex="sed \"$postregex\"" || postregex="cat"

      local CMD="git ls-remote --tags $1 | grep -v '{}' |
                 sed 's#.*refs/tags/##' |
                 $preregex |
                 $prefilter |
                 $include |
                 $exclude |
                 $postfilter |
                 $postregex |
                 sort -t. -k 1,1n -k 2,2n -k 3,3n -k 4,4n | tail -1"
      (( DEBUG == 1 )) && printf '%s\n' "$CMD" > /tmp/b_gitver
      bash -c "$CMD"
   }

   # Get the last commit date for a GitLab repository
   # shellcheck disable=SC2317
   B_GITLABVER() {
      local USR
      local REPO
      local BRANCH="${2:-}"
      USR="$(printf '%s' "$1" | cut -d'/' -f 4)"
      REPO="$(printf '%s' "$1" | cut -d'/' -f 5)"
      wget -q -O - "https://gitlab.com/api/v4/projects/${USR}%2F${REPO}/repository/commits?ref_name=${BRANCH:-master}" | jq -r '.[0].committed_date[0:10] | gsub("-";"")'
   }

   # Get the last commit date for a GitHub repository
   # shellcheck disable=SC2317
   B_GITHUBVER() {
      local URL="$1"
      local BRANCH="${2:-}"
      wget -q -O - "https://api.github.com/repos/${URL/*github.com\//}/commits/${BRANCH:-master}" | jq -cr '.commit.committer.date[0:10] | gsub("-";"")'
   }

   # Get the latest version for a Sourceforge project
   # shellcheck disable=SC2317
   B_SFVER() {
      local URL="$1"
      # A4: force HTTPS for the SourceForge RSS feed (a known weak link).
      URL="${URL/#http:/https:}"
      wget -q --secure-protocol=TLSv1_2 --https-only -O - "$URL/rss?path=/" | xml2 | grep '/rss/channel/item/link' | sed 's/.*\/files\/\([^\/]\+\)\/.*/\1/; s/.\+-\(.\+\)/\1/' | sort -t. -k 1,1n -k 2,2n -k 3,3n -k 4,4n | tail -1
   }

   # Branch head commit date as %Y%m%d, read from the loose commit object
   # (A4: http: is rewritten to https:, like the other fetch helpers).
   # shellcheck disable=SC2317
   B_GITDATE() {
      local URL="$1"
      URL="${URL/#http:/https:}"
      local BRANCH="${2:-master}"
      local HEAD DT
      HEAD=$(git ls-remote -h "$URL" "$BRANCH" | cut -d $'\t' -f 1)
      DT=$( (printf '\x1f\x8b\x08\x00\x00\x00\x00\x00' &&
         wget -q -O - "$URL/objects/${HEAD:0:2}/${HEAD:2}") |
         gzip -dc 2> /dev/null | cut -d $'\0' -f 1 |
         awk '/^committer/ {print $(NF-1); exit}')
      date -d "@$DT" '+%Y%m%d'
   }

   # Latest published GitHub release tag
   # shellcheck disable=SC2317
   B_GITHUBREL() {
      local URL="$1"
      wget -q -O - "https://api.github.com/repos/${URL/*github.com\//}/releases/latest" | jq -r '.tag_name | sub("^v";"")'
   }

   # Get the last changed date for an SVN repository
   # shellcheck disable=SC2317
   B_SVNDATE() {
      date -d "$(svn info --non-interactive --trust-server-cert "$1" | grep 'Last Changed Date:' | cut -d':' -f2-)" "+%Y%m%d"
   }

   export -f B_GITVER B_GITHUBVER B_GITDATE B_GITHUBREL B_SVNDATE B_GITLABVER B_SFVER

   if ! CMD=$(recipe_section_get "$pkg" VERSION); then
      output "$CMD"; return 1
   fi

   local -a opts=()
   [[ "$DEBUG" == "1" ]] && opts+=("-x")
   opts+=("-e" "-c")
   local ver
   if ! ver=$(bash "${opts[@]}" "$CMD" 2>/dev/null); then
      >&2 output "Error while running version command for $pkg."; return 1
   fi
   [[ -z "$ver" ]] && { >&2 output "Version command for $pkg returned no output."; return 1; }
   printf '%s\n' "$ver"
   return 0
}

# Check if a recipe has a build section for this system.
# Parameters: recipe_name
recipe_select_build() {
   local recipe="$1"

   recipe_section_lookup -q "$recipe" BUILD > /dev/null || return 1
   return 0
}

# Check if a recipe is for this architecture.
# Parameters: recipe_name
recipe_select_arch() {
   local recipe="$1"
   local arch
   arch=$(recipe_item_get "$recipe" INFO arch)
   [[ -z "$arch" ]] && arch="$B_SARCH"
   for B_ARCH in ${arch//,/ }; do
      if [[ "$B_ARCH" == "all" || "$B_ARCH" == "$B_SARCH" ]]; then
         return 0
      fi
   done
   return 1
}

# Try to select and register a recipe for building: verify it builds for this
# system/arch, honour a required instance, then add it to the work_* arrays
# (local to main(), visible via bash dynamic scoping). Returns 0 if added,
# 1 if skipped (with a message). Used by both recipe-selection loops in
# parse_options(). Parameters: recipe [forced_version] [instance]
_recipe_register() {
   local recipe="$1" fver="${2:-}" inst="${3:-}"
   local instancereq
   recipe_select_arch "$recipe" || { output "$recipe not for this architecture."; return 1; }
   recipe_select_build "$recipe" || { output "$recipe has no build section for this system."; return 1; }
   instancereq=$(recipe_item_get "$recipe" INFO instance)
   if [[ -n "$instancereq" && -z "$inst" && -z "${B_INSTANCE:-}" ]]; then
      output "Recipe $recipe requires an instance, but none specified."
      return 1
   fi
   work_recipes+=("$recipe")
   work_arch["$recipe"]="$B_ARCH"
   [[ -n "$fver" ]] && work_forcever["$recipe"]="$fver"
   [[ -n "$inst" ]] && work_instance["$recipe"]="$inst"
   return 0
}

# Check if a recipe's version is already built.
# Parameters: recipe_name [forced_version] [instance]
# Returns 0 if not built, 1 if already built, 2 if version check failed.
# When forced_version is given, the recipe's version section is skipped.
# instance (if any) is included in the built-output path check.
check_version_built() {
   local pkg="$1"
   local fver="${2:-}"
   local inst="${3:-}"
   local RET=0
   local version pkgdir

   if [[ -n "$fver" ]]; then
      version="$fver"
   else
      version=$(version_get "$pkg") || return 2
   fi

   pkgdir=$(_b_installdir "$pkg" "$version" "$inst")

   if [[ -d "$pkgdir" ]]; then
      printf '%s\n' "$version"
      RET=1
   else
      printf '%s\n' "$version"
   fi
   return "$RET"
}

# --- Docker domain functions ---

# Print the list of known Debian-based distribution codenames that build
# can target. Single source of truth for the supported distro set; used by
# is_debian_distro() and by the hidden --list-distros helper (for bash
# completion).
readonly -a KNOWN_DISTROS=(trixie bookworm sid bullseye buster stretch jessie)

known_distros() {
   printf '%s\n' "${KNOWN_DISTROS[@]}"
}

# Check if the given distro is a Debian-based distribution.
# Parameters: distro_name
# Returns 0 if Debian-based, 1 otherwise.
is_debian_distro() {
   local distro="$1" d
   for d in "${KNOWN_DISTROS[@]}"; do
      [[ "$d" == "$distro" ]] && return 0
   done
   return 1
}

# Compute the distribution segment for the output directory.
# Produces a family-codename string such as "debian-trixie".
#
# Historically each distribution had its own build server, so output was
# split per host (DESTDIR was set per host, e.g. ~/build/<hostname>). With
# Docker all distributions build on one host, so the target distribution is
# encoded in the output path instead: $DESTDIR/<segment>/$B_ARCH/...
#
# In Docker mode, BUILDDISTRO may be given as either a bare codename
# ("trixie") or a family-codename ("debian-trixie"). Known codenames are
# mapped to their family. In native mode (e.g. the -S dev shell running
# inside a container), the running system's lsb_release output is used.
distro_dir() {
   local family="" codename=""
   if [[ -n "${BUILDDISTRO:-}" ]]; then
      if [[ "$BUILDDISTRO" == *-* ]]; then
         family="${BUILDDISTRO%%-*}"
         codename="${BUILDDISTRO#*-}"
      else
         codename="$BUILDDISTRO"
         if is_debian_distro "$codename"; then
            family="debian"
         else
            family="$codename"
         fi
      fi
   else
      # distr/rel were already derived from lsb_release in parse_options();
      # reuse them (lowercased) instead of invoking lsb_release a second time.
      family=$(printf '%s' "${distr:-}" | tr '[:upper:]' '[:lower:]')
      codename=$(printf '%s' "${rel:-}" | tr '[:upper:]' '[:lower:]')
      [[ -z "$family" ]] && family="unknown"
      [[ -z "$codename" ]] && codename="$family"
   fi
   # Set the global distribution globals: the directory segment (family-codename)
   # and the platform-agnostic bare codename used by publish hooks (TODEBREPO).
   B_DISTRODIR="$family-$codename"
   B_DISTRO="$codename"
}

# Declare a custom apt repository in a per-distro config file.
# Usage: repo <id> key=value ...
#   url=<url>          repository URL (required)
#   suite=<suite>      distribution suite / codename (required)
#   components=<c...>  space-separated components (default: main)
#   proxy=<url|DIRECT> per-repository proxy, or DIRECT to bypass the generic
#                      proxy for this repository's host
#   auth=<user:pass>   HTTP basic auth credentials for the repository host
#   authfile=<path>    path to an apt auth.conf.d credentials file (relative
#                      paths resolve against BUILD_REPOS_DIR)
#   key=<src>          signing key: file:<path> (relative to BUILD_REPOS_DIR or
#                      absolute), url:<https-url> or a plain https:// URL
#   signedby=<keyid>   optional apt signed-by key id (if key not given)
#   arch=<archs>       restrict to architectures (e.g. amd64,arm64)
repo() {
   local id="$1"; shift
   local kv k v
   if [[ -z "${REPO_URL[$id]+x}" ]]; then
      REPO_ORDER+=("$id")
   fi
   for kv in "$@"; do
      k="${kv%%=*}"; v="${kv#*=}"
      case "$k" in
         url)        REPO_URL["$id"]="$v" ;;
         suite)      REPO_SUITE["$id"]="$v" ;;
         components) REPO_COMPONENTS["$id"]="$v" ;;
         proxy)      REPO_PROXY["$id"]="$v" ;;
         auth)       REPO_AUTH["$id"]="$v" ;;
         authfile)   REPO_AUTHFILE["$id"]="$v" ;;
         key)        REPO_KEY["$id"]="$v" ;;
         signedby)   REPO_SIGNEDBY["$id"]="$v" ;;
         arch)       REPO_ARCH["$id"]="$v" ;;
         *) ERR=1 output "repo: unknown field '$k' for repository '$id'" ;;
      esac
   done
}

# Load per-distro apt/repository configuration.
# Sources $BUILD_REPOS_DIR/<distro> (or <family>-<distro>) if present, which may
# set PROXY (distro-specific generic proxy override), NO_DEFAULT_REPOS,
# DEFAULT_REPOS and declare repositories via the `repo` helper.
# Parameters: distro_codename

# Print the path of the per-distro apt/repository config file if one exists
# (trying <BUILD_REPOS_DIR>/<B_DISTRODIR> then <BUILD_REPOS_DIR>/<distro>),
# otherwise print nothing and return 1. Single lookup used by both
# distro_repos_load() (to source it) and distro_apt_generate() (to resolve
# config-relative key/authfile paths).
# Parameters: distro_codename
_distro_cfgfile() {
   local distro="${1:-}" f
   for f in "${BUILD_REPOS_DIR}/${B_DISTRODIR}" "${BUILD_REPOS_DIR}/${distro}"; do
      [[ -f "$f" ]] && { printf '%s' "$f"; return 0; }
   done
   return 1
}

distro_repos_load() {
   local distro="${1:-}"
   local cfgfile=""
   # Reset state for this invocation.
   REPO_ORDER=()
   REPO_URL=() REPO_SUITE=() REPO_COMPONENTS=() REPO_PROXY=()
   REPO_AUTH=() REPO_AUTHFILE=() REPO_KEY=() REPO_ARCH=() REPO_SIGNEDBY=()
   NO_DEFAULT_REPOS=0
   DEFAULT_REPOS=""

   [[ -z "$distro" ]] && return 0

   cfgfile=$(_distro_cfgfile "$distro") || return 0

   # Source the per-distro config. It may reference the `repo` helper and set
   # PROXY/NO_DEFAULT_REPOS/DEFAULT_REPOS. Paths in `key=`/`authfile=` are
   # resolved against the config file's directory by the generator.
   # shellcheck source=/dev/null
   source "$cfgfile"
}

# Emit the standard Debian default sources for a codename into a .list file.
# Used when NO_DEFAULT_REPOS is not set and DEFAULT_REPOS is not provided.
# Parameters: output_list_file codename
_distro_default_sources() {
   local out="$1" codename="$2"
   local comps="main contrib non-free"
   case "$codename" in
      bookworm|trixie|sid) comps="main contrib non-free non-free-firmware" ;;
   esac
   {
      printf 'deb http://deb.debian.org/debian %s %s\n' "$codename" "$comps"
      if [[ "$codename" != sid ]]; then
         printf 'deb http://deb.debian.org/debian %s-updates %s\n' "$codename" "$comps"
         printf 'deb http://security.debian.org/debian-security %s-security %s\n' "$codename" "$comps"
      fi
   } > "$out"
}

# Generate the in-container apt configuration for a distro into a temp dir.
# Produces sources.list (empty), sources.list.d/*.list, apt.conf.d/99build-proxy,
# keyrings/*.gpg and auth.conf.d/*.conf entirely from build config -- never
# from the host's /etc/apt. Returns the dir path on stdout.
# Parameters: distro_codename
distro_apt_generate() {
   local distro="${1:-}"
   local cfgdir
   # Reduce a family-codename ("debian-trixie") to its bare codename ("trixie")
   # for Debian detection and default-source generation; bare codenames are
   # unchanged by the parameter expansion.
   local codename="${distro#*-}"
   cfgdir=$(mktemp -d -t build-apt-XXXXXX) || { ERR=1 output "mktemp failed"; return 1; }
   mkdir -p "$cfgdir/sources.list.d" "$cfgdir/apt.conf.d" "$cfgdir/keyrings" "$cfgdir/auth.conf.d"
   : > "$cfgdir/sources.list"   # neutralise any image /etc/apt/sources.list

   # Only generate apt config for Debian-based distros (others have no apt).
   if [[ -n "$codename" ]] && ! is_debian_distro "$codename"; then
      printf '%s' "$cfgdir"
      return 0
   fi

   # Resolve config-file-relative key/authfile paths against the config dir.
   local cfgdir_base=""
   local cfgfile
   if cfgfile=$(_distro_cfgfile "$distro"); then
      cfgdir_base=$(dirname "$cfgfile")
   fi

   # --- Sources: defaults ---
   if [[ "${NO_DEFAULT_REPOS:-0}" == "1" ]]; then
      : # no default sources
   elif [[ -n "${DEFAULT_REPOS:-}" ]]; then
      printf '%s\n' "$DEFAULT_REPOS" > "$cfgdir/sources.list.d/00-default.list"
   else
      _distro_default_sources "$cfgdir/sources.list.d/00-default.list" "$codename"
   fi

   # --- Sources: custom repositories + per-repo proxy + keys + auth ---
   local id url suite comps proxy key auth authfile arch signedby host opts scheme
   local proxyconf="$cfgdir/apt.conf.d/99build-proxy"
   : > "$proxyconf"
   for id in "${REPO_ORDER[@]}"; do
      url="${REPO_URL[$id]:-}"; suite="${REPO_SUITE[$id]:-}"
      comps="${REPO_COMPONENTS[$id]:-main}"
      [[ -z "$url" || -z "$suite" ]] && { ERR=1 output "repo '$id': url and suite are required"; rm -rf "$cfgdir"; return 1; }
      # host for proxy/auth directives
      host="${url#*://}"; host="${host%%/*}"
      # one-line sources entry with optional apt options [arch=... signed-by=...]
      opts=""
      [[ -n "${REPO_ARCH[$id]:-}" ]] && opts+="arch=${REPO_ARCH[$id]} "
      if [[ -n "${REPO_KEY[$id]:-}" ]]; then
         opts+="signed-by=/etc/apt/keyrings/${id}.gpg "
      elif [[ -n "${REPO_SIGNEDBY[$id]:-}" ]]; then
         opts+="signed-by=${REPO_SIGNEDBY[$id]} "
      fi
      if [[ -n "$opts" ]]; then
         printf 'deb [ %s] %s %s %s\n' "${opts% }" "$url" "$suite" "$comps" > "$cfgdir/sources.list.d/${id}.list"
      else
         printf 'deb %s %s %s\n' "$url" "$suite" "$comps" > "$cfgdir/sources.list.d/${id}.list"
      fi
      # per-repo proxy directive (overrides the generic http_proxy/https_proxy
      # env for this host; DIRECT bypasses the generic proxy).
      proxy="${REPO_PROXY[$id]:-}"
      if [[ -n "$proxy" && -n "$host" ]]; then
         for scheme in http https; do
            printf 'Acquire::%s::Proxy::%s "%s";\n' "$scheme" "$host" "$proxy" >> "$proxyconf"
         done
      fi
      # signing key import -> keyrings/<id>.gpg
      key="${REPO_KEY[$id]:-}"
      if [[ -n "$key" ]]; then
         local keysrc="$key" keytmp=""
         case "$key" in
            file:*) keysrc="${key#file:}" ;;
            url:*)  keysrc="${key#url:}" ;;
         esac
         if [[ "$key" == file:* ]]; then
            [[ "$keysrc" != /* ]] && keysrc="$cfgdir_base/$keysrc"
         fi
         if [[ "$key" == url:* ]] || [[ "$key" == http* ]]; then
            keytmp=$(mktemp) || { ERR=1 output "mktemp failed"; rm -rf "$cfgdir"; return 1; }
            if ! wget -q --secure-protocol=TLSv1_2 -O "$keytmp" "$keysrc" 2>/dev/null \
               && ! curl -fsSL -o "$keytmp" "$keysrc" 2>/dev/null; then
               ERR=1 output "repo '$id': failed to fetch key $keysrc"; rm -f "$keytmp"; rm -rf "$cfgdir"; return 1
            fi
            keysrc="$keytmp"
         fi
         [[ -f "$keysrc" ]] || { ERR=1 output "repo '$id': key not found: $key"; rm -f "$keytmp"; rm -rf "$cfgdir"; return 1; }
         if ! gpg --dearmor --yes --output "$cfgdir/keyrings/${id}.gpg" "$keysrc" 2>/dev/null; then
            # Fallback: file may already be a binary keyring.
            cp -f "$keysrc" "$cfgdir/keyrings/${id}.gpg" 2>/dev/null || {
               ERR=1 output "repo '$id': failed to import key $keysrc"; rm -f "$keytmp"; rm -rf "$cfgdir"; return 1; }
         fi
         rm -f "$keytmp"
      fi
      # auth credentials -> auth.conf.d/<id>.conf
      auth="${REPO_AUTH[$id]:-}"; authfile="${REPO_AUTHFILE[$id]:-}"
      if [[ -n "$authfile" ]]; then
         [[ "$authfile" != /* ]] && authfile="$cfgdir_base/$authfile"
         cp -f "$authfile" "$cfgdir/auth.conf.d/${id}.conf" 2>/dev/null || {
            ERR=1 output "repo '$id': authfile not found: $authfile"; rm -rf "$cfgdir"; return 1; }
      elif [[ -n "$auth" && -n "$host" ]]; then
         local user pass
         user="${auth%%:*}"; pass="${auth#*:}"
         printf 'machine %s login %s password %s\n' "$host" "$user" "$pass" > "$cfgdir/auth.conf.d/${id}.conf"
      fi
   done

   printf '%s' "$cfgdir"
}

# Add generated apt configuration mounts for a Debian-based build.
# Replaces the old host-/etc/apt mounting: the container's apt config is built
# solely from build configuration (defaults + per-distro file), so builds no
# longer depend on the host OS's repositories, proxies, keys or credentials.
# Parameters: docker_args_array_name (reference) distro_codename
docker_add_apt_config() {
   local -n args_ref="$1"
   local distro="${2:-}"

   _BUILD_APT_DIR=$(distro_apt_generate "$distro") || return 1
   local d="$_BUILD_APT_DIR"

   # Replace the image's sources.list and sources.list.d entirely with our
   # generated set (defaults + custom repos).
   args_ref+=("-v" "${d}/sources.list:/etc/apt/sources.list:ro")
   args_ref+=("-v" "${d}/sources.list.d:/etc/apt/sources.list.d:ro")

   # Per-repo proxy directives (additive; the image's apt.conf.d is untouched).
   if [[ -s "$d/apt.conf.d/99build-proxy" ]]; then
      args_ref+=("-v" "${d}/apt.conf.d/99build-proxy:/etc/apt/apt.conf.d/99build-proxy:ro")
   fi

   # Signing keys (mounted individually; image keyrings kept).
   local kf
   for kf in "$d"/keyrings/*.gpg; do
      [[ -f "$kf" ]] || continue
      args_ref+=("-v" "${kf}:/etc/apt/keyrings/$(basename "$kf"):ro")
   done

   # Auth credentials (mounted individually).
   local af
   for af in "$d"/auth.conf.d/*.conf; do
      [[ -f "$af" ]] || continue
      args_ref+=("-v" "${af}:/etc/apt/auth.conf.d/$(basename "$af"):ro")
   done
}

# Select the Docker image for a given distro name.
# Checks for custom image config, image prefix, then default mapping.
# Parameters: distro_name
# Returns the image name via printf.
docker_image_select() {
   local distro="$1"
   local image

   # Family-codename (e.g. "debian-trixie") or bare codename ("trixie") may be
   # passed; reduce to the codename for image selection and config lookup.
   local codename="${distro#*-}"

   # Check for custom image config (e.g., DOCKER_IMAGE_TRIXIE). Sanitize the
   # codename to a valid variable name (hyphens -> underscores).
   local config_var
   config_var="DOCKER_IMAGE_$(printf '%s' "$codename" | tr '[:lower:]' '[:upper:]' | tr -- - _)"
   if [[ -n "${!config_var:-}" ]]; then
      image="${!config_var}"
   elif [[ -n "$DOCKER_IMAGE_PREFIX" ]]; then
      image="${DOCKER_IMAGE_PREFIX}${codename}"
   else
      # Default mapping (uses custom build images with entrypoint)
      case "$codename" in
         trixie)    image="build-trixie:latest" ;;
         bookworm)  image="build-bookworm:latest" ;;
         sid)       image="build-sid:latest" ;;
         *)         image="debian:$codename" ;;
      esac
   fi
   printf '%s' "$image"
}

# Compute the content hash used to decide whether a build image is stale.
# Hashes the entrypoint and the distro's Dockerfile together, so any change to
# either (entrypoint logic, package list, base layer) is detected.
# Parameters: dockerfile_path
# Prints the sha256 on stdout; returns 1 if inputs are missing.
_docker_image_hash() {
   local dockerfile="$1"
   local entrypoint="${dockerfile%/*}/entrypoint.sh"
   [[ -f "$entrypoint" && -f "$dockerfile" ]] || return 1
   { cat "$entrypoint"; cat "$dockerfile"; } | sha256sum | awk '{print $1}'
}

# Ensure the Docker image for a distro exists and is up to date with the
# entrypoint and Dockerfile shipped with this script. Builds (or rebuilds) the
# image automatically when it is missing or when its recorded content hash no
# longer matches, so an admin never has to rebuild images by hand after an
# entrypoint/Dockerfile change. No-op for distros that use a pulled or
# externally configured image (no Dockerfile.<distro> found in DOCKER_DIR).
# Parameters: distro_name
# Returns 0 if the image is ready (or nothing to build), 1 on build failure.
docker_image_ensure() {
   local distro="$1"
   local image
   image=$(docker_image_select "$distro")

   local docker_dir="${DOCKER_DIR:-${0%/*}/docker}"
   local dockerfile="$docker_dir/Dockerfile.${distro}"
   # No shipped Dockerfile for this distro: nothing to build (pulled image).
   [[ -f "$dockerfile" ]] || return 0

   local hash
   hash=$(_docker_image_hash "$dockerfile") || {
      ERR=1 output "Cannot compute image hash; missing entrypoint.sh or Dockerfile.${distro}."
      return 1
   }

   local current=""
   if docker image inspect "$image" > /dev/null 2>&1; then
      current=$(docker image inspect --format '{{index .Config.Labels "build.image.hash"}}' "$image" 2>/dev/null)
   fi

   # Up to date: nothing to do.
   [[ "$current" == "$hash" ]] && return 0

   output -f "Rebuilding Docker image ${image} (entrypoint/Dockerfile changed)."
   local build_log
   build_log=$(mktemp -p "${TMPDIR:-/tmp}" build-image-XXXXXX.log)
   local rc
   if (( VERBOSE == 0 )); then
      docker build --label build.image.hash="$hash" -t "$image" \
         -f "$dockerfile" "$docker_dir" > "$build_log" 2>&1
      rc=$?
      (( rc != 0 )) && { ERR=1 output "Docker image build failed:"; cat "$build_log" >&2; }
   else
      docker build --label build.image.hash="$hash" -t "$image" \
         -f "$dockerfile" "$docker_dir"
      rc=$?
      (( rc != 0 )) && ERR=1 output "Docker image build failed (see output above)."
   fi
   rm -f "$build_log"
   return "$rc"
}

# Remove leftover build/package containers from previous runs. Every
# build-system container inherits the build.image.hash label from the build
# base image (set by docker_image_ensure), so filtering on that catches both
# current build containers (which also carry build.system=build) and legacy
# containers from older script versions that predate the build.system label.
# Only exited containers are removed here, so an active container is never
# killed (concurrent builds are already prevented by the build lock).
# Interactive -S shells use a separate label (build.system=shell) and are left
# alone (and clean themselves up via --rm on exit).
_docker_reap() {
   local leftovers
   leftovers=$(docker ps -aq --filter label=build.image.hash --filter status=exited 2>/dev/null)
   [[ -z "$leftovers" ]] && return 0
   local -a ids=()
   read -ra ids <<< "$leftovers"
   output "Reaping ${#ids[@]} leftover build container(s) (${ids[*]})."
   docker rm -f "${ids[@]}" > /dev/null 2>&1
}

# Best-effort Docker cleanup run once before each build session. Removes the
# leftovers of interrupted/failed builds (dangling images and build cache) so
# /var/lib/docker does not fill up and starve container writable layers of
# space. Controlled by DOCKERAUTOPRUNE in ~/.buildrc:
#   yes/on/1 - prune dangling images + build cache (safe; keeps base images)
#   full/all - also remove unused images (aggressive: base images are rebuilt
#              by docker_image_ensure on the next build)
#   anything else / empty - off
# Never fatal: a prune failure is reported but does not block the build.
_docker_autoprune() {
   local mode="${DOCKERAUTOPRUNE:-}"
   case "$mode" in
      ""|0|no|off|No|Off|NO|OFF) return 0 ;;
      yes|on|1|full|all|YES|ON|FULL|ALL) : ;;
      *) output "DOCKERAUTOPRUNE: unknown value '$mode' (expected yes, full or off)"; return 0 ;;
   esac
   command -v docker > /dev/null 2>&1 || return 0
   docker image prune -f > /dev/null 2>&1 || true
   docker builder prune -f > /dev/null 2>&1 || true
   if [[ "$mode" == "full" || "$mode" == "all" || "$mode" == "FULL" || "$mode" == "ALL" ]]; then
      output "Docker auto-prune (full): removing unused images (base images will be rebuilt)..."
      docker image prune -a -f > /dev/null 2>&1 || true
   fi
   return 0
}

# Compute the "stem" of a cached download filename: the part before the first
# '-' whose remainder starts with a digit (the version suffix). Versioned
# B_GET http/sf downloads are stored as <name>-<version>; single-file caches
# (git/go/hg/svn tarballs) have no such suffix and their stem equals the whole
# filename. A file whose stem equals its filename is therefore a single-file
# cache and must never be pruned. Prints the stem (no trailing newline).
# Parameters: filename
_cache_stem() {
   local f="$1"
   local rest="$f" head tail
   while [[ "$rest" == *-* ]]; do
      head="${rest%%-*}"
      tail="${rest#*-}"
      if [[ "$tail" =~ ^[0-9] ]]; then
         printf '%s' "${f%-$tail}"
         return 0
      fi
      rest="$tail"
   done
   printf '%s' "$f"
}

# Prune stale versioned downloads from CACHEDIR, keeping the MAXCACHEKEEP most
# recently downloaded versions per package (per distinct download stem).
# Single-file caches (git/go/hg/svn tarballs) are never removed, so build
# efficiency (avoiding re-clones) is preserved. No-op when MAXCACHEKEEP is 0 or
# empty, or when CACHEDIR does not exist. Never fatal.
_cache_prune() {
   local keep="${MAXCACHEKEEP:-3}"
   (( keep > 0 )) || return 0
   [[ -d "$CACHEDIR" ]] || return 0
   local pkg f base stem
   for pkg in "$CACHEDIR"/*/; do
      [[ -d "$pkg" ]] || continue
      declare -A stems=()
      for f in "$pkg"*; do
         [[ -f "$f" ]] || continue
         base="${f##*/}"
         stem=$(_cache_stem "$base")
         # Single-file cache (git tarball etc.): never prune.
         [[ "$stem" == "$base" ]] && continue
         stems["$stem"]+="$f"$'\n'
      done
      local stem files
      for stem in "${!stems[@]}"; do
         mapfile -t files <<< "${stems[$stem]}"
         (( ${#files[@]} > keep )) || continue
         # Newest first by mtime; keep the first $keep, drop the rest.
         mapfile -t files < <(printf '%s\n' "${files[@]}" | xargs -d '\n' ls -t 2>/dev/null)
         local drop
         for drop in "${files[@]:keep}"; do
            [[ -n "$drop" ]] || continue
            output "cache: pruning $drop"
            rm -f "$drop"
         done
      done
      unset stems
   done
   return 0
}

# Prune old build output from DESTDIR, keeping the MAXBUILDKEEP most recently
# built versions per package (per distro/arch). Build output accumulates one
# directory per version (e.g. act_runner/2.0.1, act_runner/2.1.0, ...); this
# removes the oldest so the build output does not grow without bound. No-op when
# MAXBUILDKEEP is 0 or empty, or when DESTDIR does not exist. Never fatal.
_build_prune() {
   local keep="${MAXBUILDKEEP:-1}"
   (( keep > 0 )) || return 0
   [[ -d "$DESTDIR" ]] || return 0
   local distro arch name
   for distro in "$DESTDIR"/*/; do
      [[ -d "$distro" ]] || continue
      for arch in "$distro"*/; do
         [[ -d "$arch" ]] || continue
         for name in "$arch"*/; do
            [[ -d "$name" ]] || continue
            # Version subdirectories, newest built first by mtime.
            local -a versions=()
            mapfile -t versions < <(find "$name" -maxdepth 1 -mindepth 1 -type d \
               -printf '%T@ %p\n' 2>/dev/null | sort -rn | awk '{print $2}')
            (( ${#versions[@]} > keep )) || continue
            local v
            for v in "${versions[@]:keep}"; do
               output -v "build: pruning $v"
               rm -rf "$v"
            done
         done
      done
   done
   return 0
}

# Replace the build output of a fast build (one that took less than
# BUILDKEEPTIME seconds) with an empty marker directory, so the version is still
# recorded as built but no disk is wasted on a cheap-to-rebuild staging tree.
# The marker file lets a re-packaging attempt report that a rebuild is required.
# No-op when BUILDKEEPTIME is 0, the build was not under the cutoff, or the
# install dir does not exist. Parameters: name version instance buildtime
_build_time_prune() {
   local name="$1" version="$2" inst="$3" buildtime="$4"
   local keep="${BUILDKEEPTIME:-0}"
   (( keep > 0 )) || return 0
   (( buildtime < keep )) || return 0
   local installpath
   installpath=$(_b_installdir "$name" "$version" "$inst")
   [[ -d "$installpath" ]] || return 0
   # Remove the staged build output, leaving an empty marker dir so the version
   # is still recognised as built.
   find "$installpath" -mindepth 1 -delete 2>/dev/null || rm -rf "$installpath"
   mkdir -p "$installpath"
   touch "$installpath/.build-pruned"
   output "build: pruned output of $name $version (built in ${buildtime}s, under BUILDKEEPTIME=${keep}s)"
}

# Names of the build-environment variables passed into every Docker build
# container, in order. Single source of truth shared by docker_prepare_env()
# (which writes `export` lines into the in-container env script) and
# _docker_env_args() (which passes them as `docker run -e` flags), so the two
# cannot drift. Entries are either a bare variable name (value taken from a
# same-named shell variable) or NAME=literal (a fixed value). Not listed here:
#   - B_FILES / B_FORCE / BUILD_DEPS / B_DOCKERTMP: build-run-only, added as
#     -e by _docker_run (and exported by docker_prepare_env).
#   - XDG_CACHE_HOME / YARN_CACHE_FOLDER / QUIET: env-script only.
#   - HOST_UID / HOST_GID: -e only (the root entrypoint needs them to create
#     builduser before the env script is sourced).
#   - B_VERBOSE: derived from the host VERBOSE var, handled explicitly.
readonly -a BUILD_ENV_VARS=(
   B_VERSION B_INSTALLDIR B_DISTRODIR B_DISTRO B_ARCH B_NAME B_BUILDNR B_CACHEDIR
   B_INSTANCE B_PF BUILDMODE=docker TMPDIR=/tmp HOME PKGLIST DESTDIR DESTSPLIT
   RECIPEDIR LOGDIR PKGDIR PKGPOSTFIX PKGMAIL PKGORG
   B_GPGKEY B_COMMIT B_SHA256 B_ALLOW_INSECURE B_GPGKEYFILE B_STRICT distr rel
   B_GITTAG
   B_VULNSCAN_POLICY B_VULNSCAN_SEVERITY B_BUILDROOT B_SRCGUARD_POLICY B_VULNSCAN_IGNORE B_SRCGUARD_IGNORE
   BUILD_HOST
   # Nested builds (meta recipes) run natively inside the container and need
   # these from .buildrc: TODEBREPO for the -r repo push, INSTDEP so required
   # build dependencies are installed (native mode installs via sudo), and the
   # global VULNSCAN/SRCGUARD scan policies.
   TODEBREPO INSTDEP VULNSCAN SRCGUARD VULNSCAN_IGNORE SRCGUARD_IGNORE
)

# Prepare the build environment script for use inside a Docker container.
# Writes all exported variables and function definitions to a script file
# that will be sourced inside the container.
# Parameters: envfile_path
# Returns 0 on success.
docker_prepare_env() {
   local envfile="$1"

   {
      printf '#!/usr/bin/env bash\n'
      printf '# Build environment for %s\n\n' "${B_NAME}"

      # Build-environment variables (single source: BUILD_ENV_VARS). %q keeps
      # values with quotes/spaces/$ shell-safe in the generated script.
      local _v
      for _v in "${BUILD_ENV_VARS[@]}"; do
         if [[ "$_v" == *=* ]]; then
            printf 'export %s\n' "$_v"
         else
            printf 'export %s=%q\n' "$_v" "${!_v:-}"
         fi
      done

      # Build-only vars (always exported here; passed as -e only for build
      # runs by _docker_run).
      printf 'export B_FILES=%q\n' "${B_FILES:-}"
      printf 'export B_FORCE=%q\n' "${B_FORCE:-}"
      printf 'export B_VERBOSE=%s\n' "${VERBOSE:-0}"

      # Cache locations and quiet flag (env-script only; not passed as -e).
      # Tool-specific cache overrides from the original build script, so
      # npm/python/cabal/go caches stay inside the build root instead of
      # polluting $HOME (which is ephemeral but shared per container run).
      printf 'export PYTHONDONTWRITEBYTECODE=1\n'
      printf 'export npm_config_cache="/tmp/.npm"\n'
      printf 'export CABAL_DIR="/tmp/.cabal"\n'
      printf 'export GOPATH="/tmp/.go"\n'
      printf 'export XDG_CACHE_HOME="/tmp/.cache"\n'
      printf 'export YARN_CACHE_FOLDER="/tmp/.cache/yarn"\n'
      printf 'export QUIET=%s\n' "${QUIET:-0}"

      # $HOME/bin in PATH so nested 'build' invocations (meta recipes whose
      # BUILD section builds other recipes) can find the mounted build/torepo
      # scripts. The build wrapper runs via non-login su, so the default PATH
      # does not include $HOME/bin.
      printf 'export PATH="%s/bin:$PATH"\n' "$HOME"

      # Function definitions (exported from build() function scope)
      declare -f B_GET B_GITCHECKOUT B_LINKFILES B_LINKFILE B_VULNSCAN B_SRCGUARD
      # Helpers used by the containerized functions above
      declare -f _b_wget_fetch _b_verify_copy _b_pkg_id _b_installdir _b_gpg_ensure_key _b_git_refresh _cache_store

      # Utility functions needed by packaging
      declare -f output

      # Recipe functions needed by packaging
      declare -f recipe_section_get recipe_item_get

      # Package functions
      declare -f package_buildnr_get package_deb _b_provenance

   } > "$envfile"

   return 0
}

# Prepare the package command script for use inside a Docker container.
# Writes a script that sets up packaging variables and calls package_deb.
# Parameters: envfile_path recipe_name version
# Returns the path to the package command script.
docker_prepare_package_cmd() {
   local pkgfile="$1"
   local pkg="$2"
   local version="$3"
   local id_val

   # Compute ID (same logic as package() function)
   if [[ -n "${B_INSTANCE:-}" ]]; then
      id_val="${version}-${B_INSTANCE}"
   else
      id_val="${version}"
   fi

   # Build output dir, computed host-side via _b_installdir (the same config
   # values are exported into the container, so the path is identical there);
   # avoids duplicating _b_installdir's DESTSPLIT logic in the script below.
   local pkgdir
   pkgdir=$(_b_installdir "$pkg" "$version" "${B_INSTANCE:-}")

   cat > "$pkgfile" << PKGSCRIPT
#!/usr/bin/env bash
# Package command for ${pkg} version ${version}

pkg="${pkg}"
version="${version}"
ID="${id_val}"
pkgdir="${pkgdir}"

if [[ ! -d "\$pkgdir" ]]; then
   ERR=1 output "Version \$version of \$pkg is not available for packaging."
   exit 1
fi

pkg_type=\$(recipe_item_get "\$pkg" PKG type) || true
# Only the first declared type is packaged (matches package()).
pkg_type="\${pkg_type%%[, ]*}"
case "\$pkg_type" in
   "deb")
      pkgfile=\$(package_deb "\$pkg" "\$version") || exit 1
      if [[ -n "\$pkgfile" ]]; then
         printf '%s' "\$pkgfile" > "\${LOGDIR}/.package-result-\${pkg}.txt"
      else
         printf 'package_deb returned empty result\n' >&2
         exit 1
      fi
      ;;
   *)
      ERR=1 output "Unknown package type (\$pkg_type)."
      exit 1
      ;;
esac
PKGSCRIPT

   chmod +x "$pkgfile"
   return 0
}

# Append the common environment (-e) flags to a docker args array.
# Enumerates BUILD_ENV_VARS (the single source shared with docker_prepare_env)
# plus HOST_UID/HOST_GID (the root entrypoint needs them to create builduser
# before the env script is sourced) and B_VERBOSE (derived from VERBOSE).
# Build-only vars (B_FILES, B_FORCE, BUILD_DEPS, B_DOCKERTMP) are added by the
# caller (_docker_run) for build runs, so a package-only container never
# installs build deps.
# Parameters: array_name (nameref)
_docker_env_args() {
   local -n _ea_ref="$1"
   local _v
   for _v in "${BUILD_ENV_VARS[@]}"; do
      if [[ "$_v" == *=* ]]; then
         _ea_ref+=("-e" "$_v")
      else
         _ea_ref+=("-e" "${_v}=${!_v:-}")
      fi
   done
   _ea_ref+=("-e" "HOST_UID=$(id -u)" "-e" "HOST_GID=$(id -g)" "-e" "B_VERBOSE=${VERBOSE:-0}")
}

# Append a bind-mount of PKGDIR (if it exists) to a docker args array.
# Shared by _docker_run() and docker_shell(). Parameters: array_name (nameref)
_docker_mount_pkgdir() {
   local -n _dmp_ref="$1"
   [[ -d "$PKGDIR" ]] && _dmp_ref+=("-v" "${PKGDIR}:${PKGDIR}")
}

# Append http/https proxy -e flags to a docker args array when PROXY is set.
# Shared by _docker_run() and docker_shell(). Parameters: array_name (nameref)
_docker_add_proxy() {
   local -n _dap_ref="$1"
   [[ -n "$PROXY" ]] && _dap_ref+=("-e" "http_proxy=${PROXY}" "-e" "https_proxy=${PROXY}")
}

# Run a Docker container for a build and/or package phase.
# Parameters: image envfile [buildfile] [pkgcmdfile]
#   buildfile  - if given, the build phase runs (with DEBUGSHELL sentinel
#                support and the symlink-base mount loop); if absent, this is a
#                package-only run.
#   pkgcmdfile - optional package command script; if given alongside a build,
#                packaging runs after the build in the same container.
# Returns the exit status of the container.
_docker_run() {
   local image="$1" envfile="$2" buildfile="${3:-}" pkgcmdfile="${4:-}"
   local container_id result
   local -a docker_args=()

   local build_mode=0
   [[ -n "$buildfile" ]] && build_mode=1

   # Hostname for identification
   docker_args+=("--hostname" "$([[ $build_mode == 1 ]] && printf 'build' || printf 'package')-${B_NAME}")

   # Mount volumes (same paths inside and outside container).
   # Resolve symlinks for directories that may be symlinked on the host.
   #
   # Only the specific home sub-trees the build needs are mounted -- NOT the
   # whole $HOME. Mounting the whole home lets build tools (cargo, gradle,
   # cpanm, maven, ccache, npm, ...) write their caches into $HOME/.<tool> on
   # the host, where they persist as unbounded, unintended build artifacts
   # (the .cargo/.gradle/.cpanm/... accumulation this fixes). By leaving those
   # paths unmounted, such writes land in the container's ephemeral writable
   # layer and are discarded when the container is removed, so only the real
   # build output (~/build, ~/packages, ~/log), the legitimate caches
   # (~/cache, ~/.gnupg), and build state (~/etc) persist. The interactive
   # dev shell (-S / docker_run_shell) still mounts the whole home, as a dev
   # shell is expected to have the user's full environment.
   local recipes_real home_real
   recipes_real=$(readlink -f "$RECIPEDIR")
   home_real=$(readlink -f "$HOME")
   docker_args+=("-v" "${recipes_real}:${RECIPEDIR}")
   # CACHEDIR is only needed for builds; package-only runs don't use it.
   [[ $build_mode == 1 ]] && docker_args+=("-v" "$(readlink -f "$CACHEDIR"):${CACHEDIR}")
   # ~/etc holds PKGLIST (build-number state), read and written in-container
   # by package_deb, so it must persist and be writable.
   [[ -d "$HOME/etc" ]] && docker_args+=("-v" "$(readlink -f "$HOME/etc"):${HOME}/etc")
   # Credentials/config the build needs from $HOME (read-only):
   #   .ssh      - SSH keys/config/known_hosts for git clone over ssh://
   #   .gitconfig - safe even if unused (clone/verify need no commit identity)
   [[ -d "$HOME/.ssh" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.ssh"):${HOME}/.ssh:ro")
   [[ -f "$HOME/.gitconfig" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.gitconfig"):${HOME}/.gitconfig:ro")
   # ~/.gnupg: persistent GPG keyring cache for B_GITCHECKOUT source-integrity
   # verification (SECURITY.md group A1). Read-write so keys fetched from a
   # keyserver or imported from a recipe key file persist across builds (works
   # offline, avoids per-build re-fetch). Apt repo signing keys are separate --
   # docker_add_apt_config mounts those at /etc/apt/keyrings.
   [[ -d "$HOME/.gnupg" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.gnupg"):${HOME}/.gnupg")

   # Scripts/config for nested 'build' invocations: a meta recipe's BUILD
   # section calls `build -b -p -r <pkg>@<version>` for every component, which
   # then runs natively inside this container (the in-container BUILDMODE
   # fallback; Docker-in-Docker is not available). Build-only: the package
   # phase never invokes build/torepo (the host pushes top-level packages).
   if [[ $build_mode == 1 ]]; then
      # The build script itself (same mechanism as the -S dev shell).
      # type -P (PATH-only lookup) is required: `command -v build` would
      # resolve to the build() shell function defined in this very script.
      local build_script_path
      build_script_path=$(type -P build 2>/dev/null || true)
      # Fallback: use the running script's own path.
      if [[ -z "$build_script_path" ]]; then
         build_script_path="${BASH_SOURCE[0]}"
      fi
      if [[ -n "$build_script_path" && -f "$build_script_path" ]]; then
         docker_args+=("-v" "${build_script_path}:${HOME}/bin/build:ro")
      fi
      # torepo + its config: nested builds push their packages (-r) from inside
      # the container via $TODEBREPO (exported in BUILD_ENV_VARS).
      local torepo_path
      torepo_path=$(command -v torepo 2>/dev/null || true)
      if [[ -n "$torepo_path" && -f "$torepo_path" ]]; then
         docker_args+=("-v" "${torepo_path}:${HOME}/bin/torepo:ro")
      fi
      [[ -f "$HOME/.toreporc" ]] && docker_args+=("-v" "$(readlink -f "$HOME/.toreporc"):${HOME}/.toreporc:ro")
   fi

   # Optional: bind-mount a host directory over the container's /tmp so large
   # source extractions land on a volume with space instead of the container's
   # small writable layer (BUILDDOCKERTMP in ~/.buildrc). Build-only; /tmp is
   # where the entrypoint extracts sources. The read-only build-script files
   # are mounted under /opt/build (not /tmp) so Docker does not create
   # root-owned placeholder files inside this bind mount.
   local docker_tmp=0
   local bdt_subdir=""
   if [[ $build_mode == 1 && -n "${BUILDDOCKERTMP:-}" ]]; then
      local bdt_real bdt_mode
      bdt_real=$(readlink -f "$BUILDDOCKERTMP" 2>/dev/null) || bdt_real="$BUILDDOCKERTMP"
      if ! mkdir -p "$bdt_real" 2>/dev/null; then
         ERR=1 output "BUILDDOCKERTMP: cannot create directory $bdt_real"
         return 1
      fi
      # BUILDDOCKERTMP must be world-writable/searchable (777). The container's
      # builduser (same UID as the host user) writes source extractions into the
      # bind-mounted /tmp; if the directory is not open to all the build fails
      # deep inside with a confusing "permission denied". Check up front so the
      # error names the cause and the fix instead of surfacing mid-build.
      bdt_mode=$(stat -c '%a' "$bdt_real" 2>/dev/null || echo "")
      if [[ "$bdt_mode" != "777" ]]; then
         ERR=1 output "BUILDDOCKERTMP: $bdt_real must have 777 permissions (found ${bdt_mode:-unknown}); fix with: chmod 777 $bdt_real"
         return 1
      fi
      # Create a unique per-build subdirectory under BUILDDOCKERTMP and bind-mount
      # it over the container's /tmp. This isolates concurrent builds (no clashes
      # from shared source-extraction names like a bare "git clone" destination)
      # and lets the host drop the whole build tree afterwards with a single
      # rmdir: the container runs as root and cleans the contents before exiting,
      # so root-owned artifacts (created by apt/dpkg/etc.) are removed even though
      # the host builduser could not delete them.
      bdt_subdir="${bdt_real}/build-${B_NAME:-build}-$$-$RANDOM"
      if ! mkdir -p "$bdt_subdir" 2>/dev/null || ! chmod 777 "$bdt_subdir" 2>/dev/null; then
         ERR=1 output "BUILDDOCKERTMP: cannot create build directory $bdt_subdir"
         return 1
      fi
      docker_args+=("-v" "${bdt_subdir}:/tmp")
      docker_tmp=1
      # Ensure the symlink-target base dir is mounted so the path resolves
      # inside the container (same logic as the symlink-base loop below).
      local bdt_base
      bdt_base=$(dirname "$bdt_real")
      if [[ "$bdt_base" != "$HOME" && "$bdt_base" != "$RECIPEDIR" && "$bdt_base" != "$CACHEDIR" && "$bdt_base" != "$DESTDIR" && "$bdt_base" != "$LOGDIR" ]]; then
         docker_args+=("-v" "${bdt_base}:${bdt_base}")
      fi
   fi

   docker_args+=(
      "-v" "$(readlink -f "$DESTDIR"):${DESTDIR}"
      "-v" "$(readlink -f "$LOGDIR"):${LOGDIR}"
      "-v" "${envfile}:/opt/build/build-env.sh:ro"
   )
   [[ -n "$buildfile" ]] && docker_args+=("-v" "${buildfile}:/opt/build/build-cmd.sh:ro")
   [[ -n "$pkgcmdfile" ]] && docker_args+=("-v" "${pkgcmdfile}:/opt/build/package-cmd.sh:ro")

   # Also mount symlink target base dirs so chains resolve inside the container.
   # This handles cases like /home/builduser/recipes -> /home/builduser.orig/recipes
   # where the symlink target must be reachable at its real path. Needed for the
   # build phase (which may checkout sources into these paths) AND the package
   # phase (which reads recipe files and the build output dir).
   #
   # $home_real itself is deliberately excluded from the loop: mounting its
   # base (e.g. /home) would expose the whole home tree -- including the
   # tool-cache dot-dirs this per-subdir strategy keeps ephemeral. The guard
   # also skips any base that is $HOME or an ancestor of it for the same
   # reason. (A split setup where individual subdirs symlink to a *different*
   # real home may still expose that target's tree; not present in the
   # current deployment.)
   if [[ $build_mode == 1 || -n "$pkgcmdfile" ]]; then
      local mount_real base_real
      for mount_real in "$recipes_real" "$(readlink -f "$CACHEDIR")" "$(readlink -f "$DESTDIR")" "$(readlink -f "$LOGDIR")" "$(readlink -f "$HOME/etc")" "$(readlink -f "$HOME/.ssh")" "$(readlink -f "$HOME/.gnupg")" "$(readlink -f "$HOME/.gitconfig")"; do
         base_real=$(dirname "$mount_real")
         if [[ "$base_real" != "$HOME" && "$base_real" != "$RECIPEDIR" && "$base_real" != "$CACHEDIR" && "$base_real" != "$DESTDIR" && "$base_real" != "$LOGDIR" && "$home_real" != "$base_real" && "$home_real" != "${base_real}/"* ]]; then
            docker_args+=("-v" "${base_real}:${base_real}")
         fi
      done

      # Mount the real target directories of the current recipe's symlinked
      # recipe file and .files dir so they resolve inside the container.
      # Recipe files (and their .files companions) are commonly symlinks into
      # a separate recipes source tree (e.g. ~/recipes.github/<name>/); only
      # ~/recipes is bind-mounted above, so a symlink like
      # ~/recipes/<name>.recipe -> ../recipes.github/<name>/<name>.recipe
      # dangles inside the container unless its target directory is also
      # mounted. The package phase reads recipe sections and
      # <name>.files/B_DEBIAN in-container, so the targets must be reachable.
      # No-op for real (non-symlinked) recipe files. Read-only: recipes are
      # never written to from a build/package container.
      local rpath rtarget rbase existing_mounts
      for rpath in "$RECIPEDIR/$B_NAME.recipe" "$RECIPEDIR/$B_NAME.files"; do
         [[ -L "$rpath" ]] || continue
         rtarget=$(readlink -f "$rpath" 2>/dev/null) || continue
         [[ -n "$rtarget" ]] || continue
         if [[ -d "$rtarget" ]]; then
            rbase="$rtarget"
         else
            rbase=$(dirname "$rtarget")
         fi
         # Skip $HOME / ancestors (would re-expose the whole home tree) and
         # dirs already covered by an existing mount.
         [[ "$rbase" == "$HOME" || "$HOME" == "$rbase"/* ]] && continue
         existing_mounts=" ${docker_args[*]} "
         [[ "$existing_mounts" == *" -v ${rbase}:${rbase}"* ]] && continue
         docker_args+=("-v" "${rbase}:${rbase}:ro")
      done
   fi

   # Mount PKGDIR if it exists
   _docker_mount_pkgdir docker_args

   # Mount generated apt configuration for Debian-based builds (defaults +
   # custom repos, per-repo proxy, keys, auth) -- never host /etc/apt.
   docker_add_apt_config docker_args "${BUILDDISTRO:-}" || return 1

   # Pass environment variables (common set; build-only vars added below)
   _docker_env_args docker_args
   if [[ $build_mode == 1 ]]; then
      docker_args+=(
         "-e" "B_FILES=${B_FILES:-}"
         "-e" "B_FORCE=${B_FORCE}"
         "-e" "BUILD_DEPS=${BUILD_DEPS:-}"
         "-e" "B_DOCKERTMP=${docker_tmp}"
      )
   fi

   # Proxy settings
   _docker_add_proxy docker_args

   if [[ -n "$buildfile" ]]; then
      output "Building ${B_NAME} (${image})..."
   else
      output "Packaging ${B_NAME} (${image})..."
   fi

   # Reap leftover containers from previous (possibly interrupted) runs so
   # overlay2 does not accumulate exited build containers.
   _docker_reap

   docker_args+=("--label" "build.system=build")

   # Unique token ties the container's debug-wait sentinel to this run (build only).
   local debug_token="" sentinel="" debug_ready=0
   if [[ $build_mode == 1 ]]; then
      debug_token="${B_NAME:-build}-$$-$RANDOM"
      docker_args+=("-e" "DEBUGSHELL=${DEBUGSHELL:-0}")
      docker_args+=("-e" "_BUILD_DEBUG_TOKEN=${debug_token}")
      sentinel="$LOGDIR/.build-debug-${debug_token}"
   fi

   # Run container detached; the entrypoint writes build output to the mounted
   # log file (append) and cats it to stdout for `docker logs`. Truncate the
   # per-recipe log first so each run starts fresh -- otherwise the entrypoint
   # appends across runs and verbose mode replays stale output from previous
   # builds, making failures hard to read.
   : > "$LOGDIR/${B_NAME}-${B_ARCH}.log" 2>/dev/null || true

   # Capture the image ID (content digest) for provenance (SECURITY.md D1).
   # RepoDigests is empty for locally-built images, so use the image ID.
   docker_args+=("-e" "B_IMAGE_DIGEST=$(docker inspect --format='{{.Id}}' "$image" 2>/dev/null)")

   container_id=$(docker run -d "${docker_args[@]}" "$image")
   if [[ -z "$container_id" ]]; then
      ERR=1 output "Failed to start Docker container."
      [[ -n "${bdt_subdir:-}" ]] && rmdir "$bdt_subdir" 2>/dev/null || true
      rm -rf "$_BUILD_APT_DIR" 2>/dev/null
      return 1
   fi

   # Stream logs in the background while we wait for completion (or debug-wait).
   # In quiet mode the container's log file already captures all build output;
   # suppress the live stream so nothing leaks to the host stdout/stderr (which
   # would, e.g., trigger an unwanted cron mail on top of the -m summary).
   if (( QUIET >= 1 )); then
      docker logs -f "$container_id" > /dev/null 2>&1 &
   else
      docker logs -f "$container_id" 2>&1 &
   fi
   local logpid=$!

   # Best-effort cleanup if interrupted (Ctrl-C): remove the container so it
   # does not leak, and drop the per-build /tmp subdirectory so root-owned
   # artifacts do not accumulate. The container is killed before it can run its
   # own cleanup, so try to exec a root cleanup first; if that fails (container
   # already gone) fall back to removing what the host builduser can. Leftover
   # containers are also reaped at the start of the next run.
   # On Ctrl-C, also drop the install directory for build runs so a
   # half-built tree is not mistaken for a completed build on the next run.
   # Package-only runs (build_mode == 0) keep the (successful) install dir.
   trap 'kill "$logpid" 2>/dev/null; docker exec "$container_id" find /tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; docker rm -f "$container_id" > /dev/null 2>&1; [[ $build_mode == 1 && -n "${B_INSTALLDIR:-}" ]] && rm -rf "$B_INSTALLDIR" 2>/dev/null; [[ -n "${bdt_subdir:-}" ]] && rmdir "$bdt_subdir" 2>/dev/null; exit 130' INT TERM

   local st
   while :; do
      st=$(docker inspect -f '{{.State.Status}}' "$container_id" 2>/dev/null || echo exited)
      [[ "$st" == "exited" ]] && break
      if [[ -n "$sentinel" && -f "$sentinel" ]]; then
         debug_ready=1
         break
      fi
      sleep 1
   done

   kill "$logpid" 2>/dev/null
   wait "$logpid" 2>/dev/null
   trap - INT TERM

   if [[ "$debug_ready" == "1" ]]; then
      # Build failed with DEBUGSHELL: the entrypoint keeps the container alive so
      # the user can inspect it interactively via docker exec.
      printf '\n'
      printf '%s\n' "## Build failed. Container $container_id kept alive for debugging."
      printf '%s\n' "## Attach with: docker exec -it -w /tmp -e PS1='\\h:\\w buildroot $ ' $container_id bash --norc"
      printf '%s\n' "## Type exit to return (the container is then removed automatically)."
      printf '%s\n' ""
      # Drop into a clean shell (no host bashrc) at the build root (/tmp, where
      # sources are extracted) with a default PS1 so custom host prompts don't
      # error out.
      docker exec -it -w /tmp -e PS1='\h:\w buildroot $ ' "$container_id" bash --norc
      rm -f "$sentinel"
      # Clean the per-build /tmp (root-owned artifacts included) while the
      # container is still alive, then remove it and drop the now-empty subdir.
      docker exec "$container_id" find /tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
      docker rm -f "$container_id" > /dev/null 2>&1
      [[ -n "${bdt_subdir:-}" ]] && rmdir "$bdt_subdir" 2>/dev/null || true
      rm -rf "$_BUILD_APT_DIR" 2>/dev/null
      return 1
   fi

   # Normal completion: capture the container's exit code and clean up.
   # The entrypoint's exit trap already emptied the per-build /tmp subdirectory
   # (as root), so rmdir should succeed; guard anyway in case a crashed prior
   # run left root-owned files the host builduser cannot remove.
   local exit_code
   exit_code=$(docker inspect --format='{{.State.ExitCode}}' "$container_id" 2>/dev/null || echo "1")
   result="$exit_code"
   docker rm "$container_id" > /dev/null 2>&1

   if [[ -n "${bdt_subdir:-}" ]]; then
      rmdir "$bdt_subdir" 2>/dev/null || ERR=1 output "BUILDDOCKERTMP: could not remove $bdt_subdir (leftover root-owned files); remove manually as root"
   fi

   rm -rf "$_BUILD_APT_DIR" 2>/dev/null

   return "$result"
}

# Package a built recipe inside a Docker container (package-only mode, used
# when -p is given without -b in Docker mode). Sets up the build environment
# (reusing docker_prepare_env / the BUILD_ENV_VARS list), runs the package
# container, and reads the result file the container writes. On success
# returns 0 and leaves the package filename in the global DOCKER_PKG_FILE; on
# failure returns 1 (container failed) or 2 (container exited 0 but wrote no
# result file). The caller prints the success/failure messages. Stdout of the
# container (the "Packaging…" line and docker logs) is left on the terminal,
# so the filename is NOT returned on stdout.
# Parameters: recipe_name version
docker_package_only() {
   local pkg="$1" version="$2"
   DOCKER_PKG_FILE=""
   B_NAME="$pkg"
   B_VERSION="$version"
   # Compute B_INSTALLDIR (normally set in build(), but we skipped it).
   B_INSTALLDIR=$(_b_installdir "$B_NAME" "$B_VERSION" "${B_INSTANCE:-}")
   B_CACHEDIR="$CACHEDIR"
   B_FILES=""
   B_FORCE=0

   local image
   image=$(docker_image_select "$BUILDDISTRO")

   local envfile
   envfile=$(mktemp -p "$TMPDIR" build-env-"${B_NAME}"-XXXXXX.sh)
   docker_prepare_env "$envfile"

   local pkgcmdfile
   pkgcmdfile=$(mktemp -p "$TMPDIR" pkg-cmd-"${B_NAME}"-XXXXXX.sh)
   docker_prepare_package_cmd "$pkgcmdfile" "$B_NAME" "$B_VERSION"

   # Package-only run: no build command (the host does not need dpkg/fakeroot).
   _docker_run "$image" "$envfile" "" "$pkgcmdfile"
   local pkg_result=$?

   rm -f "$envfile" "$pkgcmdfile"

   (( pkg_result != 0 )) && return 1

   local result_file="$LOGDIR/.package-result-${pkg}.txt"
   if [[ ! -f "$result_file" ]]; then
      return 2   # exited 0 but no result file
   fi
   DOCKER_PKG_FILE=$(cat "$result_file")
   rm -f "$result_file"
   return 0
}

# Start interactive development shell in a Docker container.
# Mounts all build directories and provides the build environment so the user
# can run builds, inspect files, and develop recipes interactively.
# Parameters: distro_name
# Returns exit code of the docker run command.
docker_shell() {
   local distro="$1"
   local image
   image=$(docker_image_select "$distro")

   # Build/rebuild the image automatically if missing or stale; for distros
   # without a shipped Dockerfile (pulled images) this is a no-op.
   docker_image_ensure "$distro" || return 1
   if ! docker image inspect "$image" > /dev/null 2>&1; then
      ERR=1 output "Docker image '$image' not found. Pull it with: docker pull $image"
      return 1
   fi

   # Reap leftover build containers from previous runs before starting a shell.
   _docker_reap

   local -a docker_args=(
      "-it"
      "--rm"
      "--label" "build.system=shell"
      "--hostname" "build-dev-${distro}"
   )

   # Mount volumes (resolve symlinks for directories that may be symlinked on the host)
   local recipes_real home_real
   recipes_real=$(readlink -f "$RECIPEDIR")
   home_real=$(readlink -f "$HOME")
   docker_args+=(
      "-v" "${home_real}:${HOME}"
      "-v" "${recipes_real}:${RECIPEDIR}"
      "-v" "$(readlink -f "$CACHEDIR"):${CACHEDIR}"
      "-v" "$(readlink -f "$DESTDIR"):${DESTDIR}"
      "-v" "$(readlink -f "$LOGDIR"):${LOGDIR}"
   )

   # Mount PKGDIR if it exists
   _docker_mount_pkgdir docker_args

   # Mount generated apt configuration for Debian-based builds (defaults +
   # custom repos, per-repo proxy, keys, auth) -- never host /etc/apt.
   docker_add_apt_config docker_args "$distro" || return 1

   # Mount the build script into the container so 'build' command works inside
   # (type -P: PATH-only, as `command -v build` resolves to the build() function).
   local build_script_path
   build_script_path=$(type -P build 2>/dev/null || true)
   # Fallback: use the running script's own path
   if [[ -z "$build_script_path" ]]; then
      build_script_path="${BASH_SOURCE[0]}"
   fi
   if [[ -n "$build_script_path" && -f "$build_script_path" ]]; then
      docker_args+=("-v" "${build_script_path}:${HOME}/bin/build:ro")
   fi

   # Also mount the torepo script if available
   local torepo_path
   torepo_path=$(command -v torepo 2>/dev/null || true)
   if [[ -n "$torepo_path" && -f "$torepo_path" ]]; then
      docker_args+=("-v" "${torepo_path}:${HOME}/bin/torepo:ro")
   fi

   # Environment variables
   # Set BUILDMODE=native so that builds inside the container run natively
   # (Docker is not available inside the container)
   docker_args+=(
      "-e" "HOME=${HOME}"
      "-e" "B_ARCH=${B_SARCH}"
      "-e" "BUILDMODE=native"
      "-e" "HOST_UID=$(id -u)"
      "-e" "HOST_GID=$(id -g)"
      "-e" "RECIPEDIR=${RECIPEDIR}"
      "-e" "DESTDIR=${DESTDIR}"
      "-e" "CACHEDIR=${CACHEDIR}"
      "-e" "PKGDIR=${PKGDIR}"
      "-e" "LOGDIR=${LOGDIR}"
      "-e" "PKGLIST=${PKGLIST}"
      "-e" "DESTSPLIT=${DESTSPLIT:-}"
   )

   # Pass instance if specified
   [[ -n "${B_INSTANCE:-}" ]] && docker_args+=("-e" "B_INSTANCE=${B_INSTANCE}")
   # Verbose flag (so the entrypoint surfaces suppressed command output)
   docker_args+=("-e" "B_VERBOSE=${VERBOSE:-0}")

   # Proxy settings
   _docker_add_proxy docker_args

   printf '## Build development shell for %s\n' "$distro"
   printf '## Image: %s\n' "$image"
   printf '## Type exit to leave.\n'
   printf '## Use sudo apt-get install <pkg> to install packages.\n'
   printf '\n'

   docker run "${docker_args[@]}" "$image"
   local rc=$?
   rm -rf "$_BUILD_APT_DIR" 2>/dev/null
   return $rc
}

# Attach to a running Docker container for interactive debugging.
# Convenience wrapper around docker exec for re-attaching to containers
# left running after a failed build with -s flag.
# Parameters: container_id
# Returns exit code of the docker exec command.
docker_attach() {
   local container_id="$1"

   # Verify the container exists and is running
   if ! docker inspect --format='{{.State.Status}}' "$container_id" > /dev/null 2>&1; then
      ERR=1 output "Container '$container_id' not found."
      return 1
   fi

   local status
   status=$(docker inspect --format='{{.State.Status}}' "$container_id" 2>/dev/null)
   if [[ "$status" != "running" ]]; then
      ERR=1 output "Container '$container_id' is not running (status: $status)."
      return 1
   fi

   printf '## Attaching to container %s\n' "$container_id"
   printf '## Type exit to detach.\n'
   printf '\n'

   # Drop into a clean shell (no host bashrc) at the build root (/tmp, where
   # sources are extracted) with a default PS1 so custom host prompts don't
   # error out.
   docker exec -it -w /tmp -e PS1='\h:\w buildroot $ ' "$container_id" bash --norc
   return $?
}

# Parse command-line options and populate work arrays.
# Parameters: script arguments
parse_options() {
   B_FORCE=0
   DEBUG=""
   DEBUGSHELL=""
   B_INSTANCE=""
   DRYRUN=0
   DO_CHECK=0
   DO_BUILD=0
   DO_PACKAGE=0
   DO_REPO=0
   B_NOPKGRM=0
   local all=0

   while getopts :csbprad:li:RS:A:xvqfhm: opt; do
      case $opt in
      c) DO_CHECK=1
         ;;
      l) DRYRUN=1
         ;;
      b) DO_CHECK=2
         DO_BUILD=1
         ;;
      p) DO_CHECK=2
         DO_PACKAGE=1
         ;;
      r) DO_CHECK=2
         DO_PACKAGE=2
         DO_REPO=1
         ;;
      a) all=1
         ;;
      d) BUILDDISTRO="$OPTARG"
         ;;
      i) B_INSTANCE="$OPTARG"
         ;;
      R) B_NOPKGRM=1
         ;;
      S) SHELL_MODE=1
         BUILDDISTRO="$OPTARG"
         ;;
      A) ATTACH_CONTAINER="$OPTARG"
         ;;
      x) DEBUG=1
         ;;
      v) VERBOSE=1
         ;;
      s) DEBUGSHELL=1
         ;;
      q) QUIET=$((QUIET + 1))
         ;;
      f) B_FORCE=1
         ;;
      h) usage
         return 1
         ;;
      m) email="$OPTARG"
         ;;
      \?) printf '%s\n' "Unknown option: -$OPTARG"
         usage
         return 1
         ;;
      :) printf '%s\n' "Option -$OPTARG requires argument"
         usage
         return 1
         ;;
      esac
   done
   shift $((OPTIND - 1))

   if (( DO_CHECK == 0 && DO_BUILD == 0 && DO_PACKAGE == 0 && DO_REPO == 0 )) && (( SHELL_MODE == 0 )) && [[ -z "$ATTACH_CONTAINER" ]]; then
      output "No action specified."
      return 1
   fi

   # Determine distribution and release (distr/rel) before selecting recipes.
   # recipe_select_build() (used by the -a loop below) references these, so they
   # must be set here, after getopts populated BUILDDISTRO. In Docker mode use
   # the specified distro; otherwise detect from the running system.
   if [[ -n "$BUILDDISTRO" ]]; then
      IFS='-' read -r distr rel <<< "$BUILDDISTRO"
      distr=$(printf '%s' "$distr" | tr '[:lower:]' '[:upper:]')
      rel=$(printf '%s' "${rel:-$distr}" | tr '[:lower:]' '[:upper:]')
      # A bare codename (e.g. "trixie") selects the Debian docker image, but
      # distro-specific recipe sections are named "[X DEBIAN TRIXIE]"; map the
      # codename to its family so those sections activate (native mode already
      # yields DEBIAN from lsb_release -i). Explicit family-codenames
      # ("debian-trixie") are split above and need no mapping.
      if [[ "$BUILDDISTRO" != *-* ]] && is_debian_distro "$(printf '%s' "$rel" | tr '[:upper:]' '[:lower:]')"; then
         distr=DEBIAN
      fi
   else
      distr=$(lsb_release -i -s | tr '[:lower:]' '[:upper:]')
      rel=$(lsb_release -c -s | tr '[:lower:]' '[:upper:]')
   fi

   local recipe base rest version instance
   for recipe in "$@"; do
      # Recipe arguments may carry a forced version and/or instance suffix:
      #   recipe, recipe@version, recipe:instance, recipe@version:instance
      #   or recipe:instance@version (the @/: parts may appear in either order).
      base="${recipe%%[:@]*}"
      rest="${recipe#"$base"}"
      version=""
      instance=""
      if [[ "$rest" == *@* ]]; then
         version="${rest#*@}"
         version="${version%%:*}"
      fi
      if [[ "$rest" == *:* ]]; then
         instance="${rest#*:}"
         instance="${instance%%@*}"
      fi
      recipe="$base"

      [[ ! -f "$RECIPEDIR/$recipe.recipe" ]] && { output "recipe $recipe does not exist."; continue; }
      _recipe_register "$recipe" "$version" "$instance" || continue
   done

   if (( all == 1 )); then
      local recipe
      for recipe in "$RECIPEDIR"/*.recipe; do
         recipe=$(basename -s .recipe "$recipe")
         local exclude
         exclude=$(recipe_item_get "$recipe" INFO excludefromall)
         [[ "$exclude" == "1" ]] && { output "$recipe excluded from building."; continue; }
         _recipe_register "$recipe" || continue
      done
   fi

   if (( ${#work_recipes[@]} == 0 )) && (( SHELL_MODE == 0 )) && [[ -z "$ATTACH_CONTAINER" ]]; then
      output "No recipe(s) specified."
      return 1
   fi
}

# --- Main function ---

main() {
   local i=0
   local retval=0
   # Reset the bash SECONDS counter so we can report how long the build ran.
   SECONDS=0
   declare -A work_arch
   declare -A work_forcever=()
   declare -A work_instance=()
   declare -a work_recipes=()
   declare -a work_version=()
   declare -a work_built=()
   declare -a work_build=()
   declare -a work_package=()
   declare -a work_packaged=()
   declare -a work_buildtime=()

   # Hidden helper: print the known target distributions and exit. Used by
   # bash completion (build-completion) as the single source of truth, so the
   # completion does not duplicate the distro list. Runs before sanity_check
   # to avoid requiring Docker or a valid build configuration.
   if [[ "${1:-}" == "--list-distros" ]]; then
      known_distros
      return 0
   fi

   sanity_check || return 1

   B_SARCH=$(arch_get)
   parse_options "$@" || return 1

   # Global -i instance (if any), captured before the build loops so a
   # per-recipe :instance can override it without leaking to the next recipe.
   local global_instance="${B_INSTANCE:-}"

   # Distribution segment for the output directory (e.g. debian-trixie).
   # See distro_dir() for the derivation rules. distro_dir() also sets the
   # platform-agnostic B_DISTRO codename as a side effect.
   distro_dir
   export B_DISTRO

   # Load per-distro apt/repository configuration (may override PROXY for this
   # distro and declare custom repositories). Must run after distro_dir sets
   # B_DISTRO/B_DISTRODIR and before PROXY is exported below.
   distro_repos_load "$B_DISTRO"

   [[ -n "$PROXY" ]] && { export http_proxy="$PROXY"; export https_proxy="$PROXY"; }

   # The host always builds with Docker. The native build path is retained only
   # for in-container use (the -S dev shell / /.dockerenv fallback), where no
   # Docker-in-Docker is available. Silently override any BUILDMODE=native set
   # in ~/.buildrc when running on the real host.
   if [[ ! -f /.dockerenv ]]; then
      BUILDMODE=docker
   fi

   # Docker-specific sanity checks (must be after parse_options for BUILDDISTRO)
   if [[ "$BUILDMODE" == "docker" ]]; then
      if ! command -v docker > /dev/null 2>&1 || ! docker info > /dev/null 2>&1; then
         # Inside a container (e.g., the -S dev shell) there is no Docker-in-Docker,
         # so fall back to the native build path on the container's system. This
         # branch is unreachable on the host (host has /.dockerenv absent and
         # BUILDMODE forced to docker above; missing docker there is an error).
         if [[ -f /.dockerenv ]]; then
            output "Running inside container, falling back to native build mode."
            BUILDMODE=native
         else
            ERR=1 output "Docker not found or not running. The host requires Docker to build."
            return 1
         fi
      fi
      # Only require a distro if we are still building in Docker (the in-container
      # fallback above may have switched us to native, which derives distro from
      # the container's own lsb_release instead).
      if [[ "$BUILDMODE" == "docker" ]]; then
         [[ -n "$BUILDDISTRO" ]] || { ERR=1 output "Docker builds require --distro (-d) to be specified (e.g., -d bookworm)."; return 1; }
      fi
   fi

   # In Docker mode, make sure the target image exists and is up to date with
   # the shipped entrypoint/Dockerfile before we start any build or package
   # work (no-op for check-only runs and for pulled-image distros).
   if [[ "$BUILDMODE" == "docker" ]] && (( DO_BUILD != 0 || DO_PACKAGE != 0 )); then
      _docker_autoprune
      docker_image_ensure "$BUILDDISTRO" || return 1
      # Fail early with a clear cause when the image is missing and could not
      # be built (e.g. no Dockerfile found because DOCKER_DIR is unset),
      # instead of a confusing "docker run" failure later.
      local image
      image=$(docker_image_select "$BUILDDISTRO")
      if ! docker image inspect "$image" > /dev/null 2>&1; then
         ERR=1 output "Docker image '$image' not found and no Dockerfile to build it. Set DOCKER_DIR in ~/.buildrc or pull it: docker pull $image"
         return 1
      fi
   fi

   # Handle --attach mode: re-attach to a running Docker container
   if [[ -n "$ATTACH_CONTAINER" ]]; then
      command -v docker > /dev/null 2>&1 || { ERR=1 output "Docker not found."; return 1; }
      docker_attach "$ATTACH_CONTAINER"
      return $?
   fi

   # Handle --shell mode: start interactive development shell in a Docker container
   if (( SHELL_MODE == 1 )); then
      command -v docker > /dev/null 2>&1 || { ERR=1 output "Docker not found."; return 1; }
      docker info > /dev/null 2>&1 || { ERR=1 output "Docker daemon not running or not accessible."; return 1; }
      [[ -n "$BUILDDISTRO" ]] || { ERR=1 output "--shell requires a distro name (e.g., -S bookworm)."; return 1; }
      docker_shell "$BUILDDISTRO"
      return $?
   fi

   if (( DO_CHECK != 0 )); then
      # Get current version and check if already built
      for i in "${!work_recipes[@]}"; do
         B_ARCH="${work_arch[${work_recipes[$i]}]}"
         local r="${work_recipes[$i]}"
         work_version[i]=$(check_version_built "$r" "${work_forcever[$r]:-}" "${work_instance[$r]:-$global_instance}")
         work_built[i]=$?
         # A failed version check (rc 2) must not pass silently: fail the run so
         # cron/-m report it, and let the build/package loops skip this recipe.
         if (( work_built[i] == 2 )); then
            retval=1
            output -f "${work_recipes[$i]} (version check failed)"
            continue
         fi
         if (( DO_CHECK == 1 || (DO_BUILD == 1 && B_FORCE == 0) )); then
            (( work_built[i] == 1 )) && output "${work_recipes[$i]} ${work_version[$i]} (already built)"
         fi
         if (( DO_CHECK == 1 || DO_PACKAGE != 0 )); then
            (( work_built[i] == 0 )) && output "${work_recipes[$i]} ${work_version[$i]} (not built)"
         fi
      done
   fi

   if (( DO_BUILD != 0 )); then
      # If not built or forced, then build. In dryrun mode no lock is taken and
      # nothing is written, so the build/package/repo actions below only report.
      (( DRYRUN == 1 )) || lock_get || { printf '%s\n' "Unable to get lock, other instance running?"; return 1; }
      for i in "${!work_recipes[@]}"; do
         B_ARCH="${work_arch[${work_recipes[$i]}]}"
         B_INSTANCE="${work_instance[${work_recipes[$i]}]:-$global_instance}"
         if (( work_built[i] == 0 || B_FORCE == 1 )); then
            # Never build with an empty version (e.g. -f after a failed version
            # check): it would create a garbage install dir ($name-).
            if [[ -z "${work_version[$i]:-}" ]]; then
               output -f "${work_recipes[$i]} (no version available, build skipped)"
               work_build[i]=0
               retval=1
               continue
            fi
            if (( DRYRUN == 1 )); then
               output -f "Would build ${work_recipes[$i]} ${work_version[$i]}"
               work_build[i]=1
               continue
            fi
            build "${work_recipes[$i]}" "${work_version[$i]}"
            if [[ $? -eq 1 ]]; then
               output -f "${work_recipes[$i]} ${work_version[$i]} (build failed)"
               # In quiet mode the live build output is suppressed, so surface a
               # short log excerpt to stderr so the failure reason (e.g. a failed
               # B_GET download) is visible instead of just "(build failed)".
               _fail_excerpt "Log excerpt for failed build" "${work_recipes[$i]}" "${work_version[$i]}" "${work_arch[${work_recipes[$i]}]}"
               work_build[i]=0
               retval=1
            else
               work_build[i]=1
               work_buildtime[i]=$B_BUILDTIME
               output -f "${work_recipes[$i]} ${work_version[$i]} (build succeeded)"

               # In Docker mode, build+package was combined. Read result file.
               if [[ "$BUILDMODE" == "docker" ]] && (( DO_PACKAGE != 0 )); then
                  local result_file="$LOGDIR/.package-result-${work_recipes[$i]}.txt"
                  if [[ -f "$result_file" ]]; then
                     work_package[i]=$(cat "$result_file")
                     work_packaged[i]=0
                     rm -f "$result_file"
                     output "${work_recipes[$i]} ${work_version[$i]} (package created)"
                  fi
               fi
            fi
         fi
      done
      # Prune stale versioned downloads now that the build session is done, so
      # the cache does not grow without bound. Runs while the build lock is
      # still held to avoid racing a concurrent build's B_GET. Skipped in
      # dryrun mode, which must not modify anything.
      if (( DRYRUN == 0 )); then
         _cache_prune
         # Prune old build output now that the build session is done, so the
         # build directory does not grow without bound.
         _build_prune
         lock_free
      fi
   fi

   if (( DO_PACKAGE != 0 )); then
      # if no build action and version built, package. if build action successful, build.
      for i in "${!work_recipes[@]}"; do
         B_ARCH="${work_arch[${work_recipes[$i]}]}"
         B_INSTANCE="${work_instance[${work_recipes[$i]}]:-$global_instance}"

         # Skip if already packaged (e.g., in Docker combined build+package)
         [[ "${work_packaged[$i]:-1}" == "0" ]] && continue

         local b=0
         (( DO_BUILD == 0 && work_built[i] == 1 )) && b=1
         [[ "${work_build[$i]:-0}" == "1" ]] && b=1
         if (( b == 1 )); then
            if (( DRYRUN == 1 )); then
               output -f "Would package ${work_recipes[$i]} ${work_version[$i]}"
               work_packaged[i]=0
               continue
            fi
            if [[ "$BUILDMODE" == "docker" ]]; then
               # Package inside Docker container (package-only mode)
               docker_package_only "${work_recipes[$i]}" "${work_version[$i]}"
               local pkg_rc=$?
               if (( pkg_rc == 0 )); then
                  work_package[i]="$DOCKER_PKG_FILE"
                  work_packaged[i]=0
                  output "${work_recipes[$i]} ${work_version[$i]} (package created)"
               else
                  work_packaged[i]=1
                  output -f "${work_recipes[$i]} ${work_version[$i]} (package create failed)"
                  # Only the container-failure path (pkg_rc == 1) gets a log
                  # excerpt; the no-result-file path (pkg_rc == 2) mirrors the
                  # original, which excerpted only on a non-zero container exit.
                  (( pkg_rc == 1 )) && _fail_excerpt "Log excerpt for failed packaging" "${work_recipes[$i]}" "${work_version[$i]}" "${work_arch[${work_recipes[$i]}]}"
                  retval=1
               fi
            else
               work_package[i]=$(package "${work_recipes[$i]}" "${work_version[$i]}")
               work_packaged[i]=$?
               if (( work_packaged[i] == 0 )); then
                  output "${work_recipes[$i]} ${work_version[$i]} (package created)"
               else
                  output -f "${work_recipes[$i]} ${work_version[$i]} (package create failed)"
                  _fail_excerpt "Log excerpt for failed packaging" "${work_recipes[$i]}" "${work_version[$i]}" "${work_arch[${work_recipes[$i]}]}"
                  retval=1
               fi
            fi
         else
            work_package[i]=1
         fi
      done
   fi

   if (( DO_REPO != 0 )); then
      (( DRYRUN == 1 )) || lock_get || { printf '%s\n' "Unable to get lock, other instance running?"; return 1; }
      local -a pkgs=()
      local f
      for i in "${!work_recipes[@]}"; do
         [[ "${work_packaged[$i]:-1}" == "0" ]] || continue
         # A recipe may produce several packages (pkgready builds); work_package
         # then holds one file name per line. Split them into individual pushes.
         while IFS= read -r f; do
            [[ -n "$f" ]] && pkgs+=("$f")
         done <<< "${work_package[$i]:-}"
      done
      if (( ${#pkgs[@]} != 0 )); then
         if (( DRYRUN == 1 )); then
            output -f "Would push ${#pkgs[@]} package(s) to the repository"
         elif package_torepo "${pkgs[@]}"; then
            output "packages pushed to repo"
         else
            output -f "packages not pushed to repo"
            retval=1
         fi
      fi
      (( DRYRUN == 0 )) && lock_free
   fi

   # After packaging, replace the build output of fast builds (under
   # BUILDKEEPTIME) with an empty marker dir so the version stays recorded as
   # built but cheap-to-rebuild trees do not waste disk. Runs only for builds
   # that were actually built and successfully packaged this session.
   if (( BUILDKEEPTIME > 0 && DRYRUN == 0 )); then
      for i in "${!work_recipes[@]}"; do
         [[ "${work_build[$i]:-0}" == "1" ]] || continue
         [[ "${work_packaged[$i]:-1}" == "0" ]] || continue
         _build_time_prune "${work_recipes[$i]}" "${work_version[$i]}" \
            "${work_instance[$i]:-$global_instance}" "${work_buildtime[$i]:-0}"
      done
   fi

   # Format the elapsed build time as HH:MM:SS for the email summary.
   local elapsed=$SECONDS
   BUILD_DURATION=$(printf '%02d:%02d:%02d' \
      $((elapsed / 3600)) $(((elapsed % 3600) / 60)) $((elapsed % 60)))

   _send_summary

   return "$retval"
}

main "$@"
