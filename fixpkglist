set -u

usage() {
   printf '%s\n' "Usage: fixpkglist [pkglist-file ...]"
   printf '%s\n' "  If no files are given, all \$HOME/etc/pkglist-* files are processed."
   return 1
}

# Normalize a single pkglist file in place (via awk + atomic rename).
# Returns 0 on success.
fix_one() {
   local f="$1"
   local tmp="$f.fixpkglist.tmp"
   awk -F '\t' '
      # Is this key a doubled-arch key (pkg_version_arch_arch)? The last two
      # underscore segments must be equal and look like an architecture.
      function is_arch(a) {
         return (a == "amd64" || a == "all" || a == "i386" || a == "arm64" ||
                 a == "armhf" || a == "armel" || a == "ppc64el" || a == "s390x" ||
                 a == "riscv64" || a == "mips64el" || a == "sparc64")
      }
      function doubled(key,   n, a, arch) {
         n = split(key, a, "_")
         if (n < 2) return 0
         arch = a[n]
         return (a[n-1] == arch && is_arch(arch))
      }
      {
         key = $1
         val = $2
         if (doubled(key)) {
            sub(/_[^_]+$/, "", key)
         }
         if (key == "") next
         if (key in first) {
            # Duplicate key: keep the highest count.
            if (val > count[key]) count[key] = val
         } else {
            first[key] = 1
            order[++n] = key
            count[key] = val
         }
      }
      END {
         for (i = 1; i <= n; i++) {
            print order[i] "\t" count[order[i]]
         }
      }
   ' "$f" > "$tmp" && mv "$tmp" "$f"
}

main() {
   local -a files=()
   if (( $# > 0 )); then
      files=("$@")
   else
      # Default: all per-host pkglist files under ~/etc.
      if ! compgen -G "$HOME/etc/pkglist-*" > /dev/null 2>&1; then
         printf '%s\n' "No pkglist files found in $HOME/etc."
         usage
         return 1
      fi
      files=("$HOME"/etc/pkglist-*)
   fi

   local f
   local ret=0
   for f in "${files[@]}"; do
      [[ -f "$f" ]] || { printf '%s\n' "No such file: $f"; ret=1; continue; }
      if fix_one "$f"; then
         printf '%s\n' "Fixed $f"
      else
         printf '%s\n' "Failed to fix $f" >&2
         rm -f "$f.fixpkglist.tmp" 2>/dev/null
         ret=1
      fi
   done
   return "$ret"
}

main "$@"
