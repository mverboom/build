#!/usr/bin/env bash
#
# security-scan-apply - add [SECURITY] sections to recipes from a security-scan
# report, so builds pass under the global VULNSCAN=enforce / SRCGUARD=enforce
# policy.
#
# Reads the report produced by security-scan (default ~/security-scan-report.txt)
# and, for every recipe with findings, appends a [SECURITY] section with the
# copy-pasteable vulnscan-ignore= / srcguard-ignore= lists from the report.
# Recipes that already have a [SECURITY] section get the new ignore lines
# merged in (the build script joins repeated keys with commas).
#
# Caveat: the report is based on cached sources (last fetched version), so the
# ignore lists are a starting point; a build of a newer version may surface
# new findings, which will still fail the build until reviewed.
#
# Copyright 2025 Mark Verboom
#
# This file is part of Build.
#
#     Build is free software: you can redistribute it and/or modify
#     it under the terms of the GNU General Public License as published by
#     the Free Software Foundation, either version 3 of the License, or
#     (at your option) any later version.
#
#     Build is distributed in the hope that it will be useful,
#     but WITHOUT ANY WARRANTY; without even the implied warranty of
#     MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#     GNU General Public License for more details.
#
#     You should have received a copy of the GNU General Public License
#     along with Build.  If not, see <http://www.gnu.org/licenses/>.

set -u

RECIPEDIR="$HOME/recipes"
REPORT="$HOME/security-scan-report.txt"
DRY_RUN=0

usage() {
   cat <<EOF
Usage: security-scan-apply [options]

Add [SECURITY] sections to recipes from a security-scan report so builds
pass under the global enforce policy.

Options:
  -r <file>     report file to read (default: ~/security-scan-report.txt)
  -d <dir>      recipe directory (default: ~/recipes)
  -n            dry run: show what would be added, change nothing
  -h            show this help
EOF
}

while getopts "r:d:nh" opt; do
   case "$opt" in
   r) REPORT="$OPTARG" ;;
   d) RECIPEDIR="$OPTARG" ;;
   n) DRY_RUN=1 ;;
   h) usage; exit 0 ;;
   *) usage; exit 1 ;;
   esac
done

[[ -f "$REPORT" ]] || { printf '%s\n' "security-scan-apply: report not found: $REPORT"; exit 1; }
[[ -d "$RECIPEDIR" ]] || { printf '%s\n' "security-scan-apply: recipe directory not found: $RECIPEDIR"; exit 1; }

# Parse the report into per-recipe ignore lists. Output: recipe<TAB>srcguard<TAB>vulnscan
# Written to a private temp file (not a fixed /tmp name) and removed on exit.
BLOCKS=$(mktemp) || exit 1
trap 'rm -f "$BLOCKS"' EXIT
awk '
/^== / {
   if (src != "" || vuln != "") {
      r = $2
      sub(/:$/, "", r)
      print r "|" src "|" vuln
   }
   last = $2
   src = ""
   vuln = ""
   next
}
/^  srcguard-ignore=/ { src = substr($0, index($0, "=") + 1) }
/^  vulnscan-ignore=/ { vuln = substr($0, index($0, "=") + 1) }
END {
   if (src != "" || vuln != "") {
      r = last
      sub(/:$/, "", r)
      print r "|" src "|" vuln
   }
}
' "$REPORT" > "$BLOCKS"

added=0 merged=0 skipped=0
while IFS='|' read -r recipe src vuln; do
   [[ -n "$recipe" ]] || continue
   recipefile="$RECIPEDIR/$recipe.recipe"
   if [[ ! -f "$recipefile" ]]; then
      printf '%s\n' "SKIP $recipe (no recipe file)"
      skipped=$((skipped + 1))
      continue
   fi

   # Build the [SECURITY] block to add (header + comment + ignore lines).
   block=""
   block+="[SECURITY]"$'\n'
   block+="# Findings from security-scan of cached sources; suppressed so"$'\n'
   block+="# vulnscan=enforce / srcguard=enforce builds pass. Review periodically;"$'\n'
   block+="# new findings still fail the build until reviewed."$'\n'
   if [[ -n "$vuln" ]]; then
      block+="vulnscan-ignore=$vuln"$'\n'
   fi
   if [[ -n "$src" ]]; then
      block+="srcguard-ignore=$src"$'\n'
   fi

   if grep -q '^\[SECURITY\]' "$recipefile"; then
      # Merge: insert comment + ignore lines right after the [SECURITY] header
      # (the header itself stays). The build script joins repeated keys.
      mergeblock="${block#\[SECURITY\]$'\n'}"
      if (( DRY_RUN == 1 )); then
         printf '%s\n' "MERGE $recipe:"
         printf '%s\n' "$mergeblock" | sed 's/^/  + /'
      else
         awk -v b="$mergeblock" '
            /^\[SECURITY\]/ && !done {
               print
               printf "%s", b
               done = 1
               next
            }
            { print }
         ' "$recipefile" > "$recipefile.tmp" && mv "$recipefile.tmp" "$recipefile"
      fi
      merged=$((merged + 1))
   else
      if (( DRY_RUN == 1 )); then
         printf '%s\n' "ADD $recipe:"
         printf '%s\n' "$block" | sed 's/^/  + /'
      else
         printf '\n%s' "$block" >> "$recipefile"
      fi
      added=$((added + 1))
   fi
done < "$BLOCKS"

printf '%s\n' "---"
printf '%s\n' "Added sections to $added recipe(s), merged into $merged, skipped $skipped."
