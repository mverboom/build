set -u

# Global variables and constants
BASE="debclean.baselist-$(hostname)"
readonly CUR="/tmp/debclean.curlist"
LOCATION="$(dirname "${BASH_SOURCE[0]}")"

# Source configuration
# shellcheck source=~/.debcleanrc
[[ -f ~/.debcleanrc ]] && source ~/.debcleanrc

BASE="$LOCATION/$BASE"

# Trap for temp file cleanup
trap 'rm -f "$CUR"' EXIT

main() {
   local answer

   case "${1:-}" in
   "-u")
      printf '%s\n' "Are you sure you want to overwrite the base list? "
      read -r answer
      if [[ "$answer" == "y" ]]; then
         dpkg -l | grep "^.i" | awk '{print $2}' > "$BASE"
         printf '%s\n' "Base list updated."
      else
         printf '%s\n' "Base list not updated."
      fi
      ;;
   "-c")
      if [[ -f "$BASE" ]]; then
         dpkg -l | grep "^.i" | awk '{print $2}' > "$CUR"
         diff "$BASE" "$CUR" | grep '<' | cut -d' ' -f2 | xargs sudo apt-get -qq -y install > /dev/null 2>&1
         [[ ${PIPESTATUS[3]} -ne 0 ]] && printf '%s\n' "Error installing missing packages."
         if ! sudo apt-get -qq -y --purge autoremove > /dev/null 2>&1; then
            printf '%s\n' "Error removing no longer required packages."
         fi
         diff "$BASE" "$CUR" | grep '>' | cut -d' ' -f2 | xargs sudo apt-get -qq --purge -y remove > /dev/null 2>&1
         [[ ${PIPESTATUS[3]} -ne 0 ]] && printf '%s\n' "Error removing extra packages."
      else
         printf '%s\n' "No base list is available for this system."
      fi
      ;;
   "-l")
      if [[ -f "$BASE" ]]; then
         dpkg -l | grep "^.i" | awk '{print $2}' > "$CUR"
         printf '%s\n' "Extra packages installed:"
         diff "$BASE" "$CUR" | grep '>' | cut -d' ' -f2
         printf '%s\n' "Packages removed:"
         diff "$BASE" "$CUR" | grep '<' | cut -d' ' -f2
      else
         printf '%s\n' "No base list is available for this system."
      fi
      ;;
   *)
      printf '%s\n' "Usage: debclean"
      printf '%s\n' "  -u  update base list"
      printf '%s\n' "  -l  list difference of current packages with base list"
      printf '%s\n' "  -c  revert packages to configuration in base list"
      return 1
      ;;
   esac
}

main "$@"